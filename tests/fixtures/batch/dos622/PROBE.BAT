@ECHO OFF
VER > B:\TRACE.TXT
SET PLYRESULT=7
FOR %%I IN (2 4 6) DO SET PLYRESULT=%%I
ECHO FOR=%PLYRESULT%>> B:\TRACE.TXT
IF NOT "%PLYRESULT%"=="6" GOTO failed
GOTO PLYG
:failed
ECHO GOTO=miss>> B:\TRACE.TXT
GOTO finish
:plyg
ECHO GOTO=hit>> B:\TRACE.TXT
CALL B:\PLYCALL.BAT 42
ECHO CALL=%PLYRESULT%>> B:\TRACE.TXT
B:\PLYRC.COM
IF ERRORLEVEL 43 ECHO RC43=yes>> B:\TRACE.TXT
IF NOT ERRORLEVEL 43 ECHO RC43=no>> B:\TRACE.TXT
IF ERRORLEVEL 42 ECHO RC42=yes>> B:\TRACE.TXT
IF ERRORLEVEL 41 ECHO RC41=yes>> B:\TRACE.TXT
:finish
ECHO PLY_DONE>> B:\TRACE.TXT
