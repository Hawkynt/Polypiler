// Numbers: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

function $rem(a, b) {
  if (b === 0) throw new RangeError("divide by zero");
  if (a === -2147483648 && b === -1) throw new RangeError("integer overflow");
  return (a % b) | 0;
}

// Gcd(a: number, b: number): number
function Gcd(a, b) {
  while (b !== 0) {
    var remainder = $rem(a, b);
    a = b;
    b = remainder;
  }
  return a;
}

// Fibonacci(n: number): number
function Fibonacci(n) {
  var current = 0;
  var next = 1;
  {
    var i = 0;
    while (i < n) {
      var sum = (current + next) >>> 0;
      current = next;
      next = sum;
      i = (i + 1) | 0;
    }
  }
  return current;
}

// RotateLeft(value: number, count: number): number
function RotateLeft(value, count) {
  return (((value << count) >>> 0) | (value >>> ((32 - count) | 0))) >>> 0;
}

exports.Gcd = Gcd;
exports.Fibonacci = Fibonacci;
exports.RotateLeft = RotateLeft;
