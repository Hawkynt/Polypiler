class ArithmeticError extends RangeError {
  constructor(message) {
    super(message);
    this.name = "ArithmeticError";
  }
}

class DivideByZeroError extends ArithmeticError {
  constructor(message) {
    super(message);
    this.name = "DivideByZeroError";
  }
}

class OverflowError extends ArithmeticError {
  constructor(message) {
    super(message);
    this.name = "OverflowError";
  }
}

// Gcd(a: number, b: number): number
export function Gcd(a, b) {
  while (b !== 0) {
    let remainder = Remainder32(a, b, -2147483648);
    a = b;
    b = remainder;
  }
  return a;
}

// Fibonacci(n: number): number
export function Fibonacci(n) {
  let current = 0;
  let next = 1;
  {
    let i = 0;
    while (i < n) {
      let sum = (current + next) >>> 0;
      current = next;
      next = sum;
      i = (i + 1) | 0;
    }
  }
  return current;
}

// RotateLeft(value: number, count: number): number
export function RotateLeft(value, count) {
  return (((value << count) >>> 0) | (value >>> ((32 - count) | 0))) >>> 0;
}

// Remainder32(dividend: number, divisor: number, smallest: number): number
function Remainder32(dividend, divisor, smallest) {
  CheckDivision32(dividend, divisor, smallest);
  return (dividend % divisor) | 0;
}

// CheckDivision32(dividend: number, divisor: number, smallest: number): void
function CheckDivision32(dividend, divisor, smallest) {
  if (divisor === 0) {
    throw new DivideByZeroError("divide by zero");
  }
  if ((divisor === (-1)) && (dividend === smallest)) {
    throw new OverflowError("integer overflow");
  }
}
