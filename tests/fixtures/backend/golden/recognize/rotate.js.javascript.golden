// rotate: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

// left8(x: number): number
function left8(x) {
  return (x << 8) | (((x >>> 0) >>> 24) | 0);
}

// unsigned(x: number): number
function unsigned(x) {
  return (((x | 0) << 8) | ((x >>> 24) | 0)) >>> 0;
}

// variable(x: number, n: number): number
function variable(x, n) {
  return (x << n) | (((x >>> 0) >>> ((32 - n) | 0)) | 0);
}

// rightXor(x: number): number
function rightXor(x) {
  return (((x >>> 0) >>> 7) | 0) ^ (x << 25);
}

// short(x: number): number
function short(x) {
  return (((x << 3) | ((x >>> 13) | 0)) & 65535) & 0xFFFF;
}

// arithmetic(x: number): number
function arithmetic(x) {
  return (x << 8) | (x >> 24);
}

// wrongAmount(x: number): number
function wrongAmount(x) {
  return (x << 8) | (((x >>> 0) >>> 23) | 0);
}

// xorVariable(x: number, n: number): number
function xorVariable(x, n) {
  return (x << n) ^ (((x >>> 0) >>> ((32 - n) | 0)) | 0);
}

exports.left8 = left8;
exports.unsigned = unsigned;
exports.variable = variable;
exports.rightXor = rightXor;
exports.short = short;
exports.arithmetic = arithmetic;
exports.wrongAmount = wrongAmount;
exports.xorVariable = xorVariable;
