#### net2.0+accurate RecognizeSingleBit.cs 1512
// RecognizeSingleBit: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public static class RecognizeSingleBit {

  public static bool TestShifted(uint x, int i) {
    return ((x >> i) & 1u) != 0u;
  }

  public static bool TestMask(ulong x, int i) {
    return (x & (1UL << i)) != 0UL;
  }

  public static bool TestClear(int x, int i) {
    return ((x >> i) & 1) == 0;
  }

  public static bool TestOne(long x, int i) {
    return ((x >> i) & 1L) == 1L;
  }

  public static bool TestConstant(uint x) {
    return ((x >> 7) & 1u) != 0u;
  }

  public static bool TestMasked(uint x, int i) {
    return ((x >> (i & 31)) & 1u) != 0u;
  }

  public static uint Set(uint x, int i) {
    return x | (1u << i);
  }

  public static ulong Clear(ulong x, int i) {
    return x & ~(1UL << i);
  }

  public static int Toggle(int x, int i) {
    return x ^ (1 << i);
  }

  public static uint SetFirst(uint x, int i) {
    return (1u << i) | x;
  }

  public static bool TwoBits(uint x, int i) {
    return ((x >> i) & 3u) != 0u;
  }

  public static bool MaskOne(uint x, int i) {
    return (x & (1u << i)) == 1u;
  }

  public static bool Narrow(ushort x, int i) {
    return ((x >> i) & 1) != 0;
  }

  public static uint SetTwo(uint x, int i) {
    return x | (3u << i);
  }

  public static long WidenedBit(long x, int i) {
    unchecked {
      return x | (long)(uint)(1 << i);
    }
  }

  public static uint SetFromArray(uint[] a, int i) {
    return a[0] | (1u << i);
  }

}
