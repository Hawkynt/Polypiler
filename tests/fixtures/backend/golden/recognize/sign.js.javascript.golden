// sign: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

// shifted(x: number): number
function shifted(x) {
  return (x >> 31) | ((((0 - (x >>> 0)) >>> 0) >>> 31) | 0);
}

// notNegated(x: number): number
function notNegated(x) {
  return (x >> 31) | (((x >>> 0) >>> 31) | 0);
}

exports.shifted = shifted;
exports.notNegated = notNegated;
