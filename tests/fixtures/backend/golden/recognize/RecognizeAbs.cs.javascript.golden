// SelectPositive(x: { hi, lo }): { hi, lo }
export function SelectPositive(x) {
  return (CompareSigned64(x, { hi: 0, lo: 0 }) >= 0) ? x : Negate64(x);
}

// SelectZero(x: number): number
export function SelectZero(x) {
  return (0 > x) ? ((0 - x) | 0) : x;
}

// XorSubtract(x: number): number
