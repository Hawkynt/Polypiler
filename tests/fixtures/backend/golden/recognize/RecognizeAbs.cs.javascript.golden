  let low = (0 - value.lo) >>> 0;
  return { hi: ((~value.hi >>> 0) + ((low === 0) ? 1 : 0)) >>> 0, lo: low };
}

// ShiftRightArithmetic64(value: { hi, lo }, count: number): { hi, lo }
function ShiftRightArithmetic64(value, count) {
  count = count & 63;
  if (count === 0) {
    return value;
  }
  let high = value.hi | 0;
  if (count >= 32) {
    return { hi: (high >> 31) >>> 0, lo: (high >> ((count - 32) | 0)) >>> 0 };
  }
  return { hi: (high >> count) >>> 0, lo: ((value.lo >>> count) | (((high >>> 0) << ((32 - count) | 0)) >>> 0)) >>> 0 };
}

// Add64(left: { hi, lo }, right: { hi, lo }): { hi, lo }
function Add64(left, right) {
  let low = (left.lo + right.lo) >>> 0;
  let carry = (low < left.lo) ? 1 : 0;
