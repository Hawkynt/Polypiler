// A 64-bit integer is an object { hi, lo }: its upper and its lower 32 bits, each as an unsigned number.

class ArithmeticError extends RangeError {
  constructor(message) {
    super(message);
    this.name = "ArithmeticError";
  }
}

class OverflowError extends ArithmeticError {
  constructor(message) {
    super(message);
    this.name = "OverflowError";
  }
}

// Select(x: number): number
export function Select(x) {
  return (x < 0) ? (-x | 0) : x;
}

// SelectPositive(x: { hi, lo }): { hi, lo }
export function SelectPositive(x) {
  return (CompareSigned64(x, { hi: 0, lo: 0 }) >= 0) ? x : Negate64(x);
}

// SelectZero(x: number): number
export function SelectZero(x) {
  return (0 > x) ? ((0 - x) | 0) : x;
}

// XorSubtract(x: number): number
export function XorSubtract(x) {
  let m = x >> 31;
  return ((x ^ m) - m) | 0;
}

// AddXor(x: { hi, lo }): { hi, lo }
export function AddXor(x) {
  return Xor64(Add64(x, ShiftRightArithmetic64(x, 63)), ShiftRightArithmetic64(x, 63));
}

// Short(v: number): number
export function Short(v) {
  let x = v;
  let m = x >> 31;
  return ((x ^ m) - m) | 0;
}

// Trapping(x: number): number
export function Trapping(x) {
  return (x < 0) ? SubtractChecked32(0, x, -2147483648, 2147483647) : x;
}

// WrongMask(x: number): number
export function WrongMask(x) {
  let m = x >> 30;
  return ((x ^ m) - m) | 0;
}

// Logical(x: number): number
export function Logical(x) {
  let m = ((x >>> 0) >>> 31) | 0;
  return ((x ^ m) - m) | 0;
}

// Swapped(x: number): number
export function Swapped(x) {
  return (x < 0) ? x : (-x | 0);
}

// Library(x: number): number
export function Library(x) {
  return AbsSigned32(x, -2147483648);
}

// CompareSigned64(left: { hi, lo }, right: { hi, lo }): number
function CompareSigned64(left, right) {
  let leftHigh = left.hi | 0;
  let rightHigh = right.hi | 0;
  if (leftHigh !== rightHigh) {
    return (leftHigh < rightHigh) ? (-1) : 1;
  }
  return CompareLow(left.lo, right.lo);
}

// Negate64(value: { hi, lo }): { hi, lo }
function Negate64(value) {
  let low = (0 - value.lo) >>> 0;
  return { hi: ((~value.hi >>> 0) + ((low === 0) ? 1 : 0)) >>> 0, lo: low };
}

// ShiftRightArithmetic64(value: { hi, lo }, count: number): { hi, lo }
function ShiftRightArithmetic64(value, count) {
  count = count & 63;
  if (count === 0) {
    return value;
  }
  let high = value.hi | 0;
  if (count >= 32) {
    return { hi: (high >> 31) >>> 0, lo: (high >> ((count - 32) | 0)) >>> 0 };
  }
  return { hi: (high >> count) >>> 0, lo: ((value.lo >>> count) | (((high >>> 0) << ((32 - count) | 0)) >>> 0)) >>> 0 };
}

// Add64(left: { hi, lo }, right: { hi, lo }): { hi, lo }
function Add64(left, right) {
  let low = (left.lo + right.lo) >>> 0;
  let carry = (low < left.lo) ? 1 : 0;
  return { hi: (((left.hi + right.hi) >>> 0) + carry) >>> 0, lo: low };
}

// Xor64(left: { hi, lo }, right: { hi, lo }): { hi, lo }
function Xor64(left, right) {
  return { hi: (left.hi ^ right.hi) >>> 0, lo: (left.lo ^ right.lo) >>> 0 };
}

// SubtractChecked32(left: number, right: number, low: number, high: number): number
function SubtractChecked32(left, right, low, high) {
  return Checked32(left - right, low, high);
}

// AbsSigned32(value: number, smallest: number): number
function AbsSigned32(value, smallest) {
  if (value === smallest) {
    throw new OverflowError("integer overflow");
  }
  return (value < 0) ? (-value | 0) : value;
}

// CompareLow(left: number, right: number): number
function CompareLow(left, right) {
  return (left === right) ? 0 : ((left < right) ? (-1) : 1);
}

// Checked32(value: number, low: number, high: number): number
