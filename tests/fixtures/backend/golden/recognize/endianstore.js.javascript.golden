"use strict";

function $trunc(value) {
  return value < 0 ? Math.ceil(value) : Math.floor(value);
}

function $f2ic(value, low, high) {
  var whole = $trunc(value);
  if (!(whole >= low && whole <= high)) throw new RangeError("integer overflow");
  return whole + 0;
}

function $set(array, index, value) {
  if (index < 0 || index >= array.length) throw new RangeError("index out of range");
  array[index] = value;
}

// header(b: Array<number>, v: number): Array<number>
function header(b, v) {
  $set(b, 0, ((v >>> 0) >>> 24) & 0xFF);
  $set(b, 1, ((v >>> 0) >>> 16) & 0xFF);
  $set(b, 2, ((v >>> 0) >>> 8) & 0xFF);
  $set(b, 3, v & 0xFF);
  return b;
}

// indexed(b: Array<number>, i: number, v: number): Array<number>
function indexed(b, i, v) {
  $set(b, i, v & 0xFF);
  $set(b, $f2ic(i + 1, -2147483648, 2147483647), ((v >>> 0) >>> 8) & 0xFF);
  return b;
}

exports.header = header;
exports.indexed = indexed;
