// singlebit: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

// test(x: number, i: number): boolean
function test(x, i) {
  return (((x >>> i) | 0) & 1) !== 0;
}

// set(x: number, i: number): number
function set(x, i) {
  return x | (1 << i);
}

// clear(x: number, i: number): number
function clear(x, i) {
  return x & (~(1 << i));
}

// twoBits(x: number, i: number): number
function twoBits(x, i) {
  return x ^ (3 << i);
}

exports.test = test;
exports.set = set;
exports.clear = clear;
exports.twoBits = twoBits;
