// minmax: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

// smaller(a: number, b: number): number
function smaller(a, b) {
  return (a < b) ? a : b;
}

// larger(a: number, b: number): number
function larger(a, b) {
  return (a >= b) ? a : b;
}

// equal(a: number, b: number): number
function equal(a, b) {
  return (a === b) ? a : b;
}

exports.smaller = smaller;
exports.larger = larger;
exports.equal = equal;
