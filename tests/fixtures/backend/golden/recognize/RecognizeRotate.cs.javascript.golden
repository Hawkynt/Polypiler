// RecognizeRotate: generated by polypiler. Change the source, not this file.
// JavaScript profile: es2015, esm.
// A 64-bit integer is an object { hi, lo }: its upper and its lower 32 bits, each as an unsigned number.

function $or64(a, b) {
  return { hi: (a.hi | b.hi) >>> 0, lo: (a.lo | b.lo) >>> 0 };
}

function $shl64(value, count) {
  count &= 63;
  if (count === 0) return value;
  if (count >= 32) return { hi: (value.lo << (count - 32)) >>> 0, lo: 0 };
  return { hi: ((value.hi << count) | (value.lo >>> (32 - count))) >>> 0, lo: (value.lo << count) >>> 0 };
}

function $shr64(value, count) {
  count &= 63;
  if (count === 0) return value;
  if (count >= 32) return { hi: 0, lo: value.hi >>> (count - 32) };
  return { hi: value.hi >>> count, lo: ((value.lo >>> count) | (value.hi << (32 - count))) >>> 0 };
}

function $udiv(a, b) {
  if (b === 0) throw new RangeError("divide by zero");
  return (a / b) >>> 0;
}

function $get(array, index) {
  if (index < 0 || index >= array.length) throw new RangeError("index out of range");
  return array[index];
}

// Left8(x: number): number
export function Left8(x) {
  return (((x << 8) >>> 0) | (x >>> 24)) >>> 0;
}

// RightXor(x: number): number
export function RightXor(x) {
  return ((x >>> 7) ^ ((x << 25) >>> 0)) >>> 0;
}

// LeftAdd(x: number): number
export function LeftAdd(x) {
  return (((x << 13) >>> 0) + (x >>> 19)) >>> 0;
}

// Left64(x: { hi, lo }): { hi, lo }
export function Left64(x) {
  return $or64($shl64(x, 13), $shr64(x, 51));
}

// Signed(x: number): number
export function Signed(x) {
  return (x << 5) | (((x >>> 0) >>> 27) | 0);
}

// Variable(x: number, n: number): number
export function Variable(x, n) {
  return (((x << n) >>> 0) | (x >>> ((32 - n) | 0))) >>> 0;
}

// Masked(x: number, n: number): number
export function Masked(x, n) {
  return (((x << (n & 31)) >>> 0) | (x >>> ((-n | 0) & 31))) >>> 0;
}

// Variable64(x: { hi, lo }, n: number): { hi, lo }
export function Variable64(x, n) {
  return $or64($shr64(x, n), $shl64(x, (64 - n) | 0));
}

// Short(x: number): number
export function Short(x) {
  return ((x << 3) | (x >> 13)) & 0xFFFF;
}

// Byte(x: number): number
export function Byte(x) {
  return ((x << 3) | (x >> 5)) & 0xFF;
}

// ShortVariable(x: number, n: number): number
export function ShortVariable(x, n) {
  return ((x << (n & 15)) | (x >> (((16 - n) | 0) & 15))) & 0xFFFF;
}

// ByteXor(x: number): number
export function ByteXor(x) {
  return ((x << 1) ^ (x >> 7)) & 0xFF;
}

// OfSum(a: number, b: number): number
export function OfSum(a, b) {
  let t = (a + b) >>> 0;
  return (((t << 7) >>> 0) | (t >>> 25)) >>> 0;
}

// Statement(x: number): number
export function Statement(x) {
  x = (((x << 17) >>> 0) | (x >>> 15)) >>> 0;
