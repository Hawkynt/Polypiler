  public static int LessOrEqual(int a, int b) {
    return (a <= b) ? a : b;
  }

  public static uint Greater(uint a, uint b) {
    return (a > b) ? a : b;
  }

  public static long Swapped(long a, long b) {
    return (a < b) ? b : a;
  }

  public static ulong Mirrored(ulong a, ulong b) {
    return (b > a) ? a : b;
  }

  public static byte Bytes(byte a, byte b) {
    return (a < b) ? a : b;
  }

  public static short Shorts(short a, short b) {
    return (a >= b) ? a : b;
  }

  public static int Branchless(int a, int b) {
    unchecked {
      return b ^ ((a ^ b) & -((a < b) ? 1 : 0));
    }
  }

  public static int BranchlessMax(int a, int b) {
    unchecked {
      return a ^ ((a ^ b) & -((a < b) ? 1 : 0));
    }
  }

  public static uint BranchlessMask(uint a, uint b) {
    return b ^ ((a ^ b) & ((a < b) ? 4294967295u : 0u));
  }

  public static int Different(int a, int b, int c) {
    return (a < b) ? a : c;
  }

  public static double Doubles(double a, double b) {
    return (a < b) ? a : b;
  }

  public static int Equality(int a, int b) {
    return (a == b) ? a : b;
  }

  public static int FromArray(int[] values, int a) {
