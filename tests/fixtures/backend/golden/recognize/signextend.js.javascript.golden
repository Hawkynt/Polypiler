// signextend: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

// shiftPair(x: number): number
function shiftPair(x) {
  return (x << 24) >> 24;
}

// xorSubtract(x: number): number
function xorSubtract(x) {
  return (((x & 65535) ^ 32768) - 32768) | 0;
}

// logical(x: number): number
function logical(x) {
  return ((x << 24) >>> 0) >>> 24;
}

exports.shiftPair = shiftPair;
exports.xorSubtract = xorSubtract;
exports.logical = logical;
