    public static int Trailing(uint x) {
      unchecked {
        int n = 0;
        while ((n < 32) && ((x & 1u) == 0u)) {
          x = x >> 1;
          n = n + 1;
        }
        return n;
      }
    }

    public static int TrailingTestFirst(ulong x) {
      unchecked {
        int n = 0;
        while (((x & 1UL) == 0UL) && (n < 64)) {
          n = n + 1;
          x = x >> 1;
        }
        return n;
      }
    }

    public static int TrailingByPosition(uint x) {
      unchecked {
        int n;
        {
          n = 0;
          while ((n < 32) && (((x >> n) & 1u) == 0u)) {
            n = n + 1;
          }
        }
        return n;
      }
    }

    public static int TrailingSigned(int x) {
      unchecked {
        int n = 0;
        while ((n < 32) && ((x & 1) == 0)) {
          x = x >> 1;
          n = n + 1;
        }
        return n + x;
      }
    }

    public static int Leading(uint x) {
      unchecked {
        int n = 0;
        while ((n < 32) && ((x & 2147483648u) == 0u)) {
          x = x << 1;
          n = n + 1;
        }
        return n;
      }
    }

    public static int LeadingByMask(ulong x) {
      unchecked {
        int n = 0;
        while ((n < 64) && ((x & (9223372036854775808UL >> n)) == 0UL)) {
          n = n + 1;
        }
        return n;
      }
    }

    public static uint LeadingShifted(ushort value) {
      unchecked {
        var x = (uint)value;
        int n = 0;
        while ((n < 32) && ((x & 2147483648u) == 0u)) {
          x = x << 1;
          n = n + 1;
        }
        return x + (uint)n;
      }
    }

    public static int Unbounded(uint x) {
      unchecked {
        int n = 0;
        if (x == 0u) {
          return 32;
        }
        while ((x & 1u) == 0u) {
          x = x >> 1;
          n = n + 1;
        }
        return n;
      }
    }

    public static int WrongBound(uint x) {
      unchecked {
        int n = 0;
        while ((n < 31) && ((x & 1u) == 0u)) {
          x = x >> 1;
          n = n + 1;
        }
