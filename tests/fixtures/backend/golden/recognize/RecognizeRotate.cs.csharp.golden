  }

  public static uint LeftAdd(uint x) {
    unchecked {
      return (x << 13) + (x >> 19);
    }
  }

  public static ulong Left64(ulong x) {
    return (x << 13) | (x >> 51);
  }

  public static int Signed(int x) {
    unchecked {
      return (x << 5) | (int)((uint)x >> 27);
    }
  }

  public static uint Variable(uint x, int n) {
    unchecked {
      return (x << n) | (x >> (32 - n));
    }
  }

  public static uint Masked(uint x, int n) {
    unchecked {
      return (x << (n & 31)) | (x >> (-n & 31));
    }
  }

  public static ulong Variable64(ulong x, int n) {
    unchecked {
      return (x >> n) | (x << (64 - n));
    }
  }

  public static ushort Short(ushort x) {
    unchecked {
      return (ushort)((x << 3) | (x >> 13));
    }
  }

  public static byte Byte(byte x) {
    unchecked {
      return (byte)((x << 3) | (x >> 5));
    }
  }

  public static ushort ShortVariable(ushort x, int n) {
    unchecked {
      return (ushort)((x << (n & 15)) | (x >> ((16 - n) & 15)));
    }
  }

  public static byte ByteXor(byte x) {
    unchecked {
      return (byte)((x << 1) ^ (x >> 7));
    }
  }

  public static uint OfSum(uint a, uint b) {
    unchecked {
      uint t = a + b;
      return (t << 7) | (t >> 25);
    }
  }

  public static uint Statement(uint x) {
    x = (x << 17) | (x >> 15);
    return x;
  }

  public static uint WrongAmount(uint x) {
    return (x << 8) | (x >> 23);
  }

  public static int Arithmetic(int x) {
    return (x << 8) | (x >> 24);
  }

  public static uint TwoValues(uint x, uint y) {
    return (x << 8) | (y >> 24);
  }

  public static uint XorVariable(uint x, int n) {
    unchecked {
      return (x << n) ^ (x >> -n);
    }
  }

  public static uint AddVariable(uint x, int n) {
    unchecked {
      return (x << n) + (x >> (32 - n));
    }
  }

  public static ushort ShortUnmasked(ushort x, int n) {
    unchecked {
      return (ushort)((x << n) | (x >> (16 - n)));
    }
  }

  public static uint Nothing(uint x) {
    return (x << 0) | (x >> 0);
  }

  public static uint FromArray(uint[] a, int i) {
    return (a[i] << 8) | (a[i] >> 24);
  }

  public static uint Quotient(uint x, uint d) {
