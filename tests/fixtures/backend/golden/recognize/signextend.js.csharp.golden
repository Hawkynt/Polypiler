#### net2.0+accurate signextend.cs 422
// signextend: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public static class @signextend {

  public static int shiftPair(int x) {
    return (x << 24) >> 24;
  }

  public static int xorSubtract(int x) {
    unchecked {
      return ((x & 65535) ^ 32768) - 32768;
    }
  }

  public static uint logical(int x) {
    unchecked {
      return (uint)(x << 24) >> 24;
    }
  }

}
