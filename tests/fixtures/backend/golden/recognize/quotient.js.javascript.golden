class ArithmeticError extends RangeError {
  constructor(message) {
    super(message);
    this.name = "ArithmeticError";
  }
}

class DivideByZeroError extends ArithmeticError {
  constructor(message) {
    super(message);
    this.name = "DivideByZeroError";
  }
}

class OverflowError extends ArithmeticError {
  constructor(message) {
    super(message);
    this.name = "OverflowError";
  }
}

function $div(a, b) {
  if (b === 0) throw new DivideByZeroError("divide by zero");
  if (a === -2147483648 && b === -1) throw new OverflowError("integer overflow");
  return (a / b) | 0;
}

function $rem(a, b) {
  if (b === 0) throw new DivideByZeroError("divide by zero");
  if (a === -2147483648 && b === -1) throw new OverflowError("integer overflow");
  return (a % b) | 0;
}

// both(a: number, b: number): number
export function both(a, b) {
  let q = $div(a, b);
  let r = $rem(a, b);
  return (q + r) | 0;
}

// other(a: number, b: number, c: number): number
export function other(a, b, c) {
  let q = $div(a, b);
  let r = $rem(a, c);
  return (q + r) | 0;
}
