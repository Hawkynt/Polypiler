"use strict";

function $div(a, b) {
  if (b === 0) throw new RangeError("divide by zero");
  if (a === -2147483648 && b === -1) throw new RangeError("integer overflow");
  return (a / b) | 0;
}

function $rem(a, b) {
  if (b === 0) throw new RangeError("divide by zero");
  if (a === -2147483648 && b === -1) throw new RangeError("integer overflow");
  return (a % b) | 0;
}

// both(a: number, b: number): number
function both(a, b) {
  let q = $div(a, b);
  let r = $rem(a, b);
  return (q + r) | 0;
}

// other(a: number, b: number, c: number): number
function other(a, b, c) {
  let q = $div(a, b);
  let r = $rem(a, c);
  return (q + r) | 0;
}

exports.both = both;
exports.other = other;
