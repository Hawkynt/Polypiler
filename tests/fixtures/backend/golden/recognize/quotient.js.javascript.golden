"use strict";

function ArithmeticError(message) {
  this.name = "ArithmeticError";
  this.message = message;
  this.stack = new RangeError(message).stack;
}
ArithmeticError.prototype = Object.create(RangeError.prototype);
ArithmeticError.prototype.constructor = ArithmeticError;

function DivideByZeroError(message) {
  this.name = "DivideByZeroError";
  this.message = message;
  this.stack = new RangeError(message).stack;
}
DivideByZeroError.prototype = Object.create(ArithmeticError.prototype);
DivideByZeroError.prototype.constructor = DivideByZeroError;

function OverflowError(message) {
  this.name = "OverflowError";
  this.message = message;
  this.stack = new RangeError(message).stack;
}
OverflowError.prototype = Object.create(ArithmeticError.prototype);
OverflowError.prototype.constructor = OverflowError;

// both(a: number, b: number): number
function both(a, b) {
  var q = Divide32(a, b, -2147483648);
  var r = Remainder32(a, b, -2147483648);
  return (q + r) | 0;
}

// other(a: number, b: number, c: number): number
function other(a, b, c) {
  var q = Divide32(a, b, -2147483648);
  var r = Remainder32(a, c, -2147483648);
  return (q + r) | 0;
}

// Divide32(dividend: number, divisor: number, smallest: number): number
function Divide32(dividend, divisor, smallest) {
  CheckDivision32(dividend, divisor, smallest);
  return (dividend / divisor) | 0;
}

// Remainder32(dividend: number, divisor: number, smallest: number): number
function Remainder32(dividend, divisor, smallest) {
  CheckDivision32(dividend, divisor, smallest);
  return (dividend % divisor) | 0;
}

// CheckDivision32(dividend: number, divisor: number, smallest: number): void
function CheckDivision32(dividend, divisor, smallest) {
  if (divisor === 0) {
    throw new DivideByZeroError("divide by zero");
  }
  if ((divisor === (-1)) && (dividend === smallest)) {
    throw new OverflowError("integer overflow");
  }
}

exports.both = both;
exports.other = other;
