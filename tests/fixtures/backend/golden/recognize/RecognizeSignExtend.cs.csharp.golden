public static class RecognizeSignExtend {

  public static int ShiftPair(int x) {
    return (x << 20) >> 20;
  }

  public static long ShiftPair64(long x) {
    return (x << 40) >> 40;
  }

  public static int XorSubtract(int x) {
    unchecked {
      return ((x & 255) ^ 128) - 128;
    }
  }

  public static int FromByte(byte b) {
    unchecked {
      return (b ^ 128) - 128;
    }
  }

  public static long XorSubtract64(long x) {
    unchecked {
      return ((x & 1048575L) ^ 524288L) - 524288L;
    }
  }

  public static int Unmasked(int x) {
    unchecked {
      return (x ^ 128) - 128;
    }
  }

  public static uint Logical(uint x) {
    return (x << 20) >> 20;
  }

  public static int Different(int x) {
    return (x << 20) >> 19;
  }

  public static int NotAPower(int x) {
    unchecked {
      return ((x & 255) ^ 129) - 129;
    }
  }

}
