// zerocount: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

// trailing(x: number): number
function trailing(x) {
  var n = 0;
  while ((n < 32) && (((x | 0) & 1) === 0)) {
    x = x >>> 1;
    n = (n + 1) | 0;
  }
  return n;
}

// leading(x: number): number
function leading(x) {
  var n = 0;
  while ((n < 32) && ((x & (-2147483648)) === 0)) {
    x = x << 1;
    n = (n + 1) | 0;
  }
  return n;
}

// wrongBit(x: number): number
function wrongBit(x) {
  var n = 0;
  while ((n < 32) && (((x | 0) & 4) === 0)) {
    x = x >>> 1;
    n = (n + 1) | 0;
  }
  return n;
}

exports.trailing = trailing;
exports.leading = leading;
exports.wrongBit = wrongBit;
