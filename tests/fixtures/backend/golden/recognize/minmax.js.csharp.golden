#### net2.0+accurate minmax.cs 362
// minmax: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public static class @minmax {

  public static int smaller(int a, int b) {
    return (a < b) ? a : b;
  }

  public static uint larger(uint a, uint b) {
    return (a >= b) ? a : b;
  }

  public static int equal(int a, int b) {
    return (a == b) ? a : b;
  }

}
