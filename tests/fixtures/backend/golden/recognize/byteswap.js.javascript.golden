  "use strict";

  // swap32(x: number): number
  function swap32(x) {
    return (((((x >>> 0) >>> 24) | 0) | ((((x >>> 0) >>> 8) | 0) & 65280)) | ((x << 8) & 16711680)) | (x << 24);
  }

  // swap16(x: number): number
  function swap16(x) {
    return ((((x >>> 8) | 0) | (x << 8)) & 65535) & 0xFFFF;
  }

  // arithmetic(x: number): number
  function arithmetic(x) {
    return (((x >> 24) | ((x >> 8) & 65280)) | ((x << 8) & 16711680)) | (x << 24);
  }

  return {
    swap32: swap32,
    swap16: swap16,
    arithmetic: arithmetic
  };
})();
