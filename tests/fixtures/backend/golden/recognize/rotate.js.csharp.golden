// rotate: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public static class @rotate {

  public static int left8(int x) {
    unchecked {
      return (x << 8) | (int)((uint)x >> 24);
    }
  }

  public static uint unsigned(uint x) {
    unchecked {
      return (uint)(((int)x << 8) | (int)(x >> 24));
    }
  }

  public static int variable(int x, int n) {
    unchecked {
      return (x << n) | (int)((uint)x >> (32 - n));
    }
  }

  public static int rightXor(int x) {
    unchecked {
      return (int)((uint)x >> 7) ^ (x << 25);
    }
  }

  public static ushort @short(ushort x) {
    unchecked {
      return (ushort)(((x << 3) | (int)((uint)x >> 13)) & 65535);
    }
  }

  public static int arithmetic(int x) {
    return (x << 8) | (x >> 24);
  }

  public static int wrongAmount(int x) {
    unchecked {
      return (x << 8) | (int)((uint)x >> 23);
    }
  }

  public static int xorVariable(int x, int n) {
    unchecked {
      return (x << n) ^ (int)((uint)x >> -n);
    }
  }

}
