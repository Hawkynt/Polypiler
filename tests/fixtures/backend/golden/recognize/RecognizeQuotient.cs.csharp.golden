#### net2.0+accurate RecognizeQuotient.cs 1079
// RecognizeQuotient: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public static class RecognizeQuotient {

  public static int Both(int a, int b) {
    unchecked {
      int q = a / b;
      int r = a % b;
      return (q * 1000) + r;
    }
  }

  public static ulong Unsigned(ulong a, ulong b) {
    unchecked {
      ulong q = a / b;
      ulong sum = q;
      return sum + (a % b);
    }
  }

  public static long Assigned(long a, long b, long q) {
    unchecked {
      q = a / b;
      return q - (a % b);
    }
  }

  public static int Changed(int a, int b) {
    unchecked {
      int q = a / b;
      a = a + 1;
      return q + (a % b);
    }
  }

  public static int Other(int a, int b, int c) {
    unchecked {
      int q = a / b;
      return q + (a % c);
    }
  }

  public static int Before(int a, int b) {
    unchecked {
      int r = a % b;
      int q = a / b;
      return q + r;
    }
  }

  public static int Nested(int a, int b) {
    int q = a / b;
    if (q > 0) {
      return a % b;
    }
    return q;
  }

}
