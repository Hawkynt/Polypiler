  // BranchlessWrong(a: number, b: number, c: number): number
  function BranchlessWrong(a, b, c) {
    return b ^ ((a ^ c) & (-((a < b) ? 1 : 0) | 0));
  }

  return {
    Less: Less,
    LessOrEqual: LessOrEqual,
    Greater: Greater,
    Swapped: Swapped,
    Mirrored: Mirrored,
    Bytes: Bytes,
    Shorts: Shorts,
    Branchless: Branchless,
    BranchlessMax: BranchlessMax,
    BranchlessMask: BranchlessMask,
    Different: Different,
    Doubles: Doubles,
    Equality: Equality,
    FromArray: FromArray,
    BranchlessWrong: BranchlessWrong
  };
})();
