function FromByte(b) {
  return ((b << 2) + b) | 0;
}

// FromShort(s: number): number
function FromShort(s) {
  return ((s << 4) - (s << 1)) | 0;
}

// PowerOfTwo(x: number): number
function PowerOfTwo(x) {
  return ((x << 2) + (x << 2)) | 0;
}

// TwoValues(x: number, y: number): number
