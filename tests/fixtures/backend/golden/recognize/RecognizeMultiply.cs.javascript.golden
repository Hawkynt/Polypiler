  if (value < low || value > high) throw new RangeError("integer overflow");
  return value;
}

// Ten(x: number): number
function Ten(x) {
  return ((x << 3) + (x << 1)) | 0;
}

// Fifteen(x: number): number
function Fifteen(x) {
  return (((x << 4) >>> 0) - x) >>> 0;
}

