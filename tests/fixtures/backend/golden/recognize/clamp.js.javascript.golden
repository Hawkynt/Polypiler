#### es5+cjs+accurate clamp.cjs 523
// clamp: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

// nested(x: number): number
function nested(x) {
  return Math.min(Math.max(x, 0), 255);
}

// chain(x: number): number
function chain(x) {
  return (x < (-5)) ? (-5) : ((x > 5) ? 5 : x);
}

// variableBound(x: number, high: number): number
function variableBound(x, high) {
  return Math.min(Math.max(x, 0), high);
}

exports.nested = nested;
exports.chain = chain;
exports.variableBound = variableBound;
