    while (i < 16) {
      c = (c + (((x >>> (i | 0)) | 0) & 1)) | 0;
      i = i + 1;
    }
  }
  return c;
}

exports.kernighan = kernighan;
exports.shiftTest = shiftTest;
exports.halfWidth = halfWidth;
