// multiply: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

// ten(x: number): number
function ten(x) {
  return ((x << 3) + (x << 1)) | 0;
}

// twoValues(x: number, y: number): number
function twoValues(x, y) {
  return ((x << 3) + (y << 1)) | 0;
}

exports.ten = ten;
exports.twoValues = twoValues;
