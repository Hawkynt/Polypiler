    unchecked {
      return (x << 4) - x;
    }
  }

  public static long Chain(long x) {
    unchecked {
      return (((x << 5) + (x << 3)) - (x << 1)) + x;
    }
  }

  public static uint Jenkins(uint h) {
    unchecked {
      h = h + (h << 10);
      return h;
    }
  }

  public static int FromByte(byte b) {
    unchecked {
      return (b << 2) + b;
    }
  }

  public static int FromShort(short s) {
    unchecked {
      return (s << 4) - (s << 1);
    }
  }

  public static int PowerOfTwo(int x) {
    unchecked {
      return (x << 2) + (x << 2);
    }
  }

  public static int TwoValues(int x, int y) {
    unchecked {
      return (x << 3) + (y << 1);
    }
  }

  public static int Checked(int x) {
    return checked((x << 3) + (x << 1));
  }

  public static int WithConstant(int x) {
    unchecked {
      return ((x << 3) + (x << 1)) + 1;
    }
  }

  public static int Negation(int x) {
    unchecked {
      return 0 - x;
    }
  }

}
