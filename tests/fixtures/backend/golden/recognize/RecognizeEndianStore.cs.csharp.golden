      b[i + 2] = (byte)(v >> 16);
      b[i + 1] = (byte)(v >> 8);
      b[i] = (byte)v;
      return b;
    }
  }

  public static byte[] LowWord(byte[] b, int i, ulong v) {
    unchecked {
      b[i] = (byte)v;
      b[i + 1] = (byte)(v >> 8);
      b[i + 2] = (byte)(v >> 16);
      b[i + 3] = (byte)(v >> 24);
      return b;
    }
  }

  public static byte[] Gap(byte[] b, int i, uint v) {
    unchecked {
      b[i] = (byte)v;
      b[i + 1] = (byte)(v >> 8);
      b[i + 3] = (byte)(v >> 16);
      b[i + 4] = (byte)(v >> 24);
      return b;
    }
  }

  public static byte[] WrongByte(byte[] b, int i, uint v) {
    unchecked {
      b[i] = (byte)v;
      b[i + 1] = (byte)(v >> 16);
      return b;
    }
  }

  public static byte[] Interleaved(byte[] b, int i, uint v) {
    unchecked {
      b[i] = (byte)v;
      v = v >> 8;
      b[i + 1] = (byte)v;
      return b;
    }
  }

  public static byte[] TwoValues(byte[] b, int i, uint v, uint w) {
    unchecked {
      b[i] = (byte)v;
      b[i + 1] = (byte)(w >> 8);
      return b;
    }
  }

  public static byte[] Shifted(byte[] b, int i, uint v) {
    unchecked {
      b[i] = (byte)(v >> 4);
      b[i + 1] = (byte)(v >> 12);
      return b;
    }
  }

}
