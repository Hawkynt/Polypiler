#### net2.0+accurate singlebit.cs 461
// singlebit: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public static class @singlebit {

  public static bool test(uint x, int i) {
    unchecked {
      return ((int)(x >> i) & 1) != 0;
    }
  }

  public static int set(int x, int i) {
    return x | (1 << i);
  }

  public static int clear(int x, int i) {
    return x & ~(1 << i);
  }

  public static int twoBits(int x, int i) {
    return x ^ (3 << i);
  }

}
