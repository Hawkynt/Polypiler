public static class @popcountloop {

  public static int kernighan(uint x) {
    unchecked {
      int c = 0;
      while (x != 0u) {
        c = c + 1;
        x = (uint)((int)x & ((int)x - 1));
      }
      return c;
    }
  }

  public static int shiftTest(uint x) {
    unchecked {
      int c = 0;
      {
        double i = 0.0;
        while (i < 32.0) {
          c = c + ((int)(x >> ToInt32(i)) & 1);
          i = i + 1.0;
        }
      }
      return c;
    }
  }

  public static int halfWidth(uint x) {
    unchecked {
      int c = 0;
      {
        double i = 0.0;
        while (i < 16.0) {
          c = c + ((int)(x >> ToInt32(i)) & 1);
          i = i + 1.0;
        }
      }
      return c;
    }
  }

  private static int ToInt32(double value) {
    return double.IsNaN(value) || double.IsInfinity(value) ? 0 : unchecked((int)(long)(global::System.Math.Truncate(value) % 4294967296.0));
  }

}
