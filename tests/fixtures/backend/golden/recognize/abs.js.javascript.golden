#### es5+cjs+accurate abs.cjs 504
// abs: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

// masked(x: number): number
function masked(x) {
  var m = x >> 31;
  return ((x ^ m) - m) | 0;
}

// selected(x: number): number
function selected(x) {
  return (x < 0) ? ((0 - x) | 0) : x;
}

// wrongShift(x: number): number
function wrongShift(x) {
  var m = x >> 30;
  return ((x ^ m) - m) | 0;
}

exports.masked = masked;
exports.selected = selected;
exports.wrongShift = wrongShift;
