public static class @clamp {

  public static int nested(int x) {
    return global::System.Math.Min(global::System.Math.Max(x, 0), 255);
  }

  public static int chain(int x) {
    return (x < -5) ? -5 : ((x > 5) ? 5 : x);
  }

  public static int variableBound(int x, int high) {
    return global::System.Math.Min(global::System.Math.Max(x, 0), high);
  }

}
