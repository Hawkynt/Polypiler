// RecognizeEndianStore: generated by polypiler. Change the source, not this file.
// JavaScript profile: es2015, esm.
// A 64-bit integer is an object { hi, lo }: its upper and its lower 32 bits, each as an unsigned number.

function $shr64(value, count) {
  count &= 63;
  if (count === 0) return value;
  if (count >= 32) return { hi: 0, lo: value.hi >>> (count - 32) };
  return { hi: value.hi >>> count, lo: ((value.lo >>> count) | (value.hi << (32 - count))) >>> 0 };
}

function $set(array, index, value) {
  if (index < 0 || index >= array.length) throw new RangeError("index out of range");
  array[index] = value;
}

// Little32(b: Uint8Array, i: number, v: number): Uint8Array
export function Little32(b, i, v) {
  $set(b, i, v & 0xFF);
  $set(b, (i + 1) | 0, (v >>> 8) & 0xFF);
  $set(b, (i + 2) | 0, (v >>> 16) & 0xFF);
  $set(b, (i + 3) | 0, (v >>> 24) & 0xFF);
  return b;
}

// Big32(b: Uint8Array, i: number, v: number): Uint8Array
export function Big32(b, i, v) {
  $set(b, i, (v >> 24) & 0xFF);
  $set(b, (i + 1) | 0, (v >> 16) & 0xFF);
  $set(b, (i + 2) | 0, (v >> 8) & 0xFF);
  $set(b, (i + 3) | 0, v & 0xFF);
  return b;
}

// Little16(b: Uint8Array, i: number, v: number): Uint8Array
export function Little16(b, i, v) {
  $set(b, i, v & 0xFF);
  $set(b, (i + 1) | 0, (v >> 8) & 0xFF);
  return b;
}

// Big64(b: Uint8Array, i: number, v: { hi, lo }): Uint8Array
export function Big64(b, i, v) {
  $set(b, i, $shr64(v, 56).lo & 0xFF);
  $set(b, (i + 1) | 0, $shr64(v, 48).lo & 0xFF);
  $set(b, (i + 2) | 0, $shr64(v, 40).lo & 0xFF);
  $set(b, (i + 3) | 0, $shr64(v, 32).lo & 0xFF);
  $set(b, (i + 4) | 0, $shr64(v, 24).lo & 0xFF);
  $set(b, (i + 5) | 0, $shr64(v, 16).lo & 0xFF);
  $set(b, (i + 6) | 0, $shr64(v, 8).lo & 0xFF);
  $set(b, (i + 7) | 0, v.lo & 0xFF);
  return b;
}

// Descending(b: Uint8Array, i: number, v: number): Uint8Array
export function Descending(b, i, v) {
  $set(b, (i + 3) | 0, (v >>> 24) & 0xFF);
  $set(b, (i + 2) | 0, (v >>> 16) & 0xFF);
  $set(b, (i + 1) | 0, (v >>> 8) & 0xFF);
  $set(b, i, v & 0xFF);
  return b;
}

// LowWord(b: Uint8Array, i: number, v: { hi, lo }): Uint8Array
export function LowWord(b, i, v) {
  $set(b, i, v.lo & 0xFF);
  $set(b, (i + 1) | 0, $shr64(v, 8).lo & 0xFF);
  $set(b, (i + 2) | 0, $shr64(v, 16).lo & 0xFF);
  $set(b, (i + 3) | 0, $shr64(v, 24).lo & 0xFF);
  return b;
}

// Gap(b: Uint8Array, i: number, v: number): Uint8Array
export function Gap(b, i, v) {
  $set(b, i, v & 0xFF);
  $set(b, (i + 1) | 0, (v >>> 8) & 0xFF);
  $set(b, (i + 3) | 0, (v >>> 16) & 0xFF);
  $set(b, (i + 4) | 0, (v >>> 24) & 0xFF);
  return b;
}

// WrongByte(b: Uint8Array, i: number, v: number): Uint8Array
export function WrongByte(b, i, v) {
  $set(b, i, v & 0xFF);
  $set(b, (i + 1) | 0, (v >>> 16) & 0xFF);
  return b;
}

// Interleaved(b: Uint8Array, i: number, v: number): Uint8Array
export function Interleaved(b, i, v) {
  $set(b, i, v & 0xFF);
  v = v >>> 8;
  $set(b, (i + 1) | 0, v & 0xFF);
  return b;
}

// TwoValues(b: Uint8Array, i: number, v: number, w: number): Uint8Array
export function TwoValues(b, i, v, w) {
  $set(b, i, v & 0xFF);
  $set(b, (i + 1) | 0, (w >>> 8) & 0xFF);
  return b;
}

// Shifted(b: Uint8Array, i: number, v: number): Uint8Array
export function Shifted(b, i, v) {
  $set(b, i, (v >>> 4) & 0xFF);
  $set(b, (i + 1) | 0, (v >>> 12) & 0xFF);
  return b;
}
