public static class RecognizePopCountLoop {

  public static int Kernighan(uint x) {
    unchecked {
      int c = 0;
      while (x != 0u) {
        c = c + 1;
        x = x & (x - 1u);
      }
      return c;
    }
  }

  public static int KernighanSwapped(ulong x) {
    unchecked {
      int c = 0;
      while (x != 0UL) {
        x = x & (x - 1UL);
        c = c + 1;
      }
      return c;
    }
  }

  public static int KernighanSigned(int x) {
    unchecked {
      int c = 0;
      while (x != 0) {
        c = c + 1;
        x = x & (x - 1);
      }
      return c;
    }
  }

  public static int ShiftTest(uint x) {
    unchecked {
      int c = 0;
      {
        int i = 0;
        while (i < 32) {
          c = c + (int)((x >> i) & 1u);
          i = i + 1;
        }
      }
      return c;
    }
  }

  public static int ShiftTestIf(ulong x) {
    unchecked {
      int c = 0;
      {
        int i = 0;
        while (i < 64) {
          if (((x >> i) & 1UL) != 0UL) {
            c = c + 1;
          }
          i = i + 1;
        }
      }
      return c;
    }
  }

  public static int ShiftingValue(ushort value) {
    unchecked {
      int c = 0;
      uint x = (uint)value;
      {
        int i = 0;
        while (i < 32) {
          c = c + (int)(x & 1u);
          x = x >> 1;
          i = i + 1;
        }
      }
      return c;
    }
  }

  public static long Accumulated(uint x, long c) {
    unchecked {
      {
        int i = 0;
        while (i < 32) {
          c = c + (long)((x >> i) & 1u);
          i = i + 1;
        }
      }
      return c;
    }
  }

  public static int TooFewPasses(uint x) {
    unchecked {
      int c = 0;
      {
        int i = 0;
        while (i < 31) {
          c = c + (int)((x >> i) & 1u);
          i = i + 1;
        }
      }
      return c;
    }
  }

  public static int CountsTwice(uint x) {
    unchecked {
      int c = 0;
      {
        int i = 0;
        while (i < 32) {
          c = c + (int)((x >> i) & 3u);
          i = i + 1;
        }
      }
      return c;
    }
  }

  public static int WrongStep(uint x) {
    unchecked {
      int c = 0;
      while (x != 0u) {
        c = c + 1;
        x = x & (x - 2u);
        if (c > 40) {
          break;
        }
      }
      return c;
    }
  }

  public static int CheckedCounter(uint x) {
    unchecked {
      int c = 0;
      while (x != 0u) {
        {
          c = checked(c + 1);
        }
        x = x & (x - 1u);
      }
      return c;
    }
  }

