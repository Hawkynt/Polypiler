// Adler32: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

function $urem(a, b) {
  if (b === 0) throw new RangeError("divide by zero");
  return a % b;
}

function $get(array, index) {
  if (index < 0 || index >= array.length) throw new RangeError("index out of range");
  return array[index];
}

// Compute(data: Array<number>): number
function Compute(data) {
  var a = 1;
  var b = 0;
  {
    var i = 0;
    while (i < data.length) {
      a = $urem((a + $get(data, i)) >>> 0, 65521);
      b = $urem((b + a) >>> 0, 65521);
      i = (i + 1) | 0;
    }
  }
  return (((b << 16) >>> 0) | a) >>> 0;
}

exports.Compute = Compute;
