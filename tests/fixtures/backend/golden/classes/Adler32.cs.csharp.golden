// Adler32Demo: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public sealed class Adler32 {

  private uint _a;

  private uint _b;

  public uint Value {
    get {
      return (this._b << 16) | this._a;
    }
  }

  public Adler32() {
    this._a = 1;
  }

  public void Update(byte[] data, int offset, int count) {
    unchecked {
      {
        int index = offset;
        while (index < (offset + count)) {
          this._a = (this._a + (uint)data[index]) % 65521u;
          this._b = (this._b + this._a) % 65521u;
          index = index + 1;
        }
      }
    }
  }

}

public static class Adler32Demo {

  public static uint OfWikipedia() {
    Adler32 adler = new Adler32();
    adler.Update(new byte[] { 87, 105, 107, 105, 112, 101, 100, 105, 97 }, 0, 9);
    return adler.Value;
  }

  public static uint Of(byte[] data) {
    Adler32 adler = new Adler32();
    adler.Update(data, 0, data.Length);
    return adler.Value;
  }

  public static uint InTwoParts(byte[] data, int split) {
    unchecked {
      Adler32 adler = new Adler32();
      adler.Update(data, 0, split);
      adler.Update(data, split, data.Length - split);
      return adler.Value;
    }
  }

}
