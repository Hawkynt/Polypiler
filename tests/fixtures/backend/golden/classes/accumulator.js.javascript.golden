// accumulator: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

// class Acc
function Acc(start) {
  this.total = 0;
  this.count = 0;
  this.total = start;
  this.count = 0;
}
Acc.prototype.add = function (value) {
  this.total = this.total + value;
  this.count = this.count + 1;
  return this.total;
};
Acc.prototype.reset = function () {
  this.total = 0;
};
Object.defineProperty(Acc.prototype, "mean", {
  get: function () {
    return (this.count === 0) ? 0 : (this.total / this.count);
  },
  configurable: true
});

// sum(start: number, first: number, second: number): number
function sum(start, first, second) {
  var acc = new Acc(start);
  acc.add(first);
  return acc.add(second);
}

// mean(first: number, second: number): number
function mean(first, second) {
  var acc = new Acc(0);
  acc.add(first);
  acc.add(second);
  return acc.mean;
}

exports.sum = sum;
exports.mean = mean;
exports.Acc = Acc;
