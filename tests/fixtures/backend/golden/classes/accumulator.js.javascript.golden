// class Acc
export class Acc {
  constructor(start) {
    this.total = 0;
    this.count = 0;
    this.total = start;
    this.count = 0;
  }
  add(value) {
    this.total = this.total + value;
    this.count = this.count + 1;
    return this.total;
  }
  reset() {
    this.total = 0;
  }
  get mean() {
    return (this.count === 0) ? 0 : (this.total / this.count);
  }
}

// sum(start: number, first: number, second: number): number
export function sum(start, first, second) {
  let acc = new Acc(start);
  acc.add(first);
  return acc.add(second);
}

// mean(first: number, second: number): number
export function mean(first, second) {
  let acc = new Acc(0);
  acc.add(first);
  acc.add(second);
  return acc.mean;
}
