// accumulator: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public sealed class Acc {

  public double total;

  public double count;

  public double mean {
    get {
      return (this.count == 0.0) ? 0.0 : (this.total / this.count);
    }
  }

  public Acc(double start) {
    this.total = start;
    this.count = 0.0;
  }

  public double add(double value) {
    this.total = this.total + value;
    this.count = this.count + 1.0;
    return this.total;
  }

  public void reset() {
    this.total = 0.0;
  }

}

public static class @accumulator {

  public static double sum(double start, double first, double second) {
    Acc acc = new Acc(start);
    acc.add(first);
    return acc.add(second);
  }

  public static double mean(double first, double second) {
    Acc acc = new Acc(0.0);
    acc.add(first);
    acc.add(second);
    return acc.mean;
  }

}
