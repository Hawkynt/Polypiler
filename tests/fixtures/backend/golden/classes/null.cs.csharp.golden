#### net2.0+accurate NullDemo.cs 965
// NullDemo: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public sealed class Box {

  public int Value;

  public int Doubled {
    get {
      unchecked {
        return this.Value * 2;
      }
    }
  }

  public Box() {
  }

  public int Get() {
    return this.Value;
  }

}

public static class NullDemo {

  public static int CallOnNull() {
    Box box = null;
    return box.Get();
  }

  public static int ReadOnNull() {
    Box box = null;
    return box.Value;
  }

  public static int WriteOnNull(int value) {
    Box box = null;
    box.Value = value;
    return value;
  }

  public static int PropertyOnNull() {
    Box box = null;
    return box.Doubled;
  }

  public static int NotNull(int value) {
    unchecked {
      Box box = new Box();
      box.Value = value;
      Box other = null;
      return ((!(box == null) && (other == null)) && !(box == null)) ? (box.Get() + box.Doubled) : -1;
    }
  }

}
