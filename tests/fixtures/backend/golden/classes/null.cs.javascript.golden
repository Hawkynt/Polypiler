// NullDemo: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

function $imul(a, b) {
  var high = (a >>> 16) & 0xFFFF;
  var low = a & 0xFFFF;
  return (low * (b & 0xFFFF) + (((high * (b & 0xFFFF) + low * ((b >>> 16) & 0xFFFF)) << 16) >>> 0)) | 0;
}

// class Box
function Box() {
  this.Value = 0;
}
Box.prototype.Get = function () {
  return this.Value;
};
Object.defineProperty(Box.prototype, "Doubled", {
  get: function () {
    return $imul(this.Value, 2);
  },
  configurable: true
});

// CallOnNull(): number
function CallOnNull() {
  var box = null;
  return box.Get();
}

// ReadOnNull(): number
function ReadOnNull() {
  var box = null;
  return box.Value;
}

// WriteOnNull(value: number): number
function WriteOnNull(value) {
  var box = null;
  box.Value = value;
  return value;
}

// PropertyOnNull(): number
function PropertyOnNull() {
  var box = null;
  return box.Doubled;
}

// NotNull(value: number): number
function NotNull(value) {
  var box = new Box();
  box.Value = value;
  var other = null;
  return (((!(box === null)) && (other === null)) && (!(box === null))) ? ((box.Get() + box.Doubled) | 0) : (-1);
}

exports.CallOnNull = CallOnNull;
exports.ReadOnNull = ReadOnNull;
exports.WriteOnNull = WriteOnNull;
exports.PropertyOnNull = PropertyOnNull;
exports.NotNull = NotNull;
exports.Box = Box;
