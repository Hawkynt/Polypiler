"use strict";

function $urem(a, b) {
  if (b === 0) throw new RangeError("divide by zero");
  return a % b;
}

function $get(array, index) {
  if (index < 0 || index >= array.length) throw new RangeError("index out of range");
  return array[index];
}

// class Adler32
function Adler32() {
  this._a = 0;
  this._b = 0;
  this._a = 1;
}
Adler32.prototype.Update = function (data, offset, count) {
  {
    var index = offset;
    while (index < ((offset + count) | 0)) {
      this._a = $urem((this._a + $get(data, index)) >>> 0, 65521);
      this._b = $urem((this._b + this._a) >>> 0, 65521);
      index = (index + 1) | 0;
    }
  }
};
Object.defineProperty(Adler32.prototype, "Value", {
  get: function () {
    return (((this._b << 16) >>> 0) | this._a) >>> 0;
  },
  configurable: true
});

// OfWikipedia(): number
function OfWikipedia() {
  var adler = new Adler32();
  adler.Update([87, 105, 107, 105, 112, 101, 100, 105, 97], 0, 9);
  return adler.Value;
}

// Of(data: Array<number>): number
function Of(data) {
  var adler = new Adler32();
  adler.Update(data, 0, data.length);
  return adler.Value;
}

// InTwoParts(data: Array<number>, split: number): number
function InTwoParts(data, split) {
  var adler = new Adler32();
  adler.Update(data, 0, split);
  adler.Update(data, split, (data.length - split) | 0);
  return adler.Value;
}

exports.OfWikipedia = OfWikipedia;
exports.Of = Of;
exports.InTwoParts = InTwoParts;
exports.Adler32 = Adler32;
