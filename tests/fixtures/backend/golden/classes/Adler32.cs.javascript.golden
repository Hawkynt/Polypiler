class IndexOutOfRangeError extends RangeError {
  constructor(message) {
    super(message);
    this.name = "IndexOutOfRangeError";
  }
}

function $get(array, index) {
  if (index < 0 || index >= array.length) throw new IndexOutOfRangeError("index out of range");
  return array[index];
}

// class Adler32
class Adler32 {
  #a = 0;
  #b = 0;
  constructor() {
    this.#a = 1;
  }
  Update(data, offset, count) {
    {
      let index = offset;
      while (index < ((offset + count) | 0)) {
        this.#a = RemainderUnsigned32((this.#a + $get(data, index)) >>> 0, 65521);
        this.#b = RemainderUnsigned32((this.#b + this.#a) >>> 0, 65521);
        index = (index + 1) | 0;
      }
    }
  }
  get Value() {
    return (((this.#b << 16) >>> 0) | this.#a) >>> 0;
  }
}

