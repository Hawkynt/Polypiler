// RangeDemo: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

function $equals_Range(a, b) {
  return a === b || a !== null && b !== null && a.Lo === b.Lo && a.Hi === b.Hi;
}

// class Range
function Range(Lo, Hi) {
  this.Lo = 0;
  this.Hi = 0;
  this.Lo = Lo;
  this.Hi = Hi;
}
Object.defineProperty(Range.prototype, "Length", {
  get: function () {
    return (this.Hi - this.Lo) | 0;
  },
  configurable: true
});

// ValueEqual(lo: number, hi: number): boolean
function ValueEqual(lo, hi) {
  return $equals_Range(new Range(lo, hi), new Range(lo, hi));
}

// Differs(lo: number, hi: number): boolean
function Differs(lo, hi) {
  return !$equals_Range(new Range(lo, hi), new Range(lo, (hi + 1) | 0));
}

// EqualsCall(lo: number, hi: number): boolean
function EqualsCall(lo, hi) {
  return $equals_Range(new Range(lo, hi), new Range(lo, hi));
}

// SameReference(lo: number, hi: number): boolean
function SameReference(lo, hi) {
  return new Range(lo, hi) === new Range(lo, hi);
}

// Length(lo: number, hi: number): number
function Length(lo, hi) {
  return new Range(lo, hi).Length;
}

// NullEqual(lo: number): boolean
function NullEqual(lo) {
  var missing = null;
  return $equals_Range(missing, null) && (!$equals_Range(new Range(lo, lo), missing));
}

exports.ValueEqual = ValueEqual;
exports.Differs = Differs;
exports.EqualsCall = EqualsCall;
exports.SameReference = SameReference;
exports.Length = Length;
exports.NullEqual = NullEqual;
exports.Range = Range;
