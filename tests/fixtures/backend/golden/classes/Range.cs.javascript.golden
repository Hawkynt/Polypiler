// class Range
export class Range {
  constructor(Lo, Hi) {
    this.Lo = 0;
    this.Hi = 0;
    this.Lo = Lo;
    this.Hi = Hi;
  }
  get Length() {
    return (this.Hi - this.Lo) | 0;
  }
}

// ValueEqual(lo: number, hi: number): boolean
export function ValueEqual(lo, hi) {
  return $equals_Range(new Range(lo, hi), new Range(lo, hi));
}

