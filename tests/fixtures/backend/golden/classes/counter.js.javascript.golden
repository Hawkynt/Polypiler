"use strict";

// class Counter
function Counter(start) {
  this._count = 0;
  this.step = 0;
  this.step = 1;
  this._count = start;
  Counter.created = Counter.created + 1;
}
Counter.created = 0;
Counter.prototype.next = function () {
  this._count = this._count + this.step;
  return this._count;
};
Counter.prototype.reset = function () {
  this._count = 0;
};
Object.defineProperty(Counter.prototype, "count", {
  get: function () {
    return this._count;
  },
  configurable: true
});

// run(start: number, step: number): number
function run(start, step) {
  var counter = new Counter(start);
  counter.step = step;
  counter.next();
  return counter.next();
}

// aliased(): number
function aliased() {
  var a = new Counter(0);
  var b = a;
  b.next();
  return a.count;
}

// sameObject(): boolean
function sameObject() {
  var a = new Counter(0);
  var b = a;
  return (a === b) && (!(a === new Counter(0)));
}

// made(): number
function made() {
  var before = Counter.created;
  var first = new Counter(5);
  first.reset();
  return (Counter.created - before) + first.count;
}

exports.run = run;
exports.aliased = aliased;
exports.sameObject = sameObject;
exports.made = made;
exports.Counter = Counter;
