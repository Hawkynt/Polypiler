    let before = Counter.created;
    let first = new Counter(5);
    first.reset();
    return (Counter.created - before) + first.count;
  }

  return {
    run: run,
    aliased: aliased,
    sameObject: sameObject,
    made: made,
    Counter: Counter
  };
})();
