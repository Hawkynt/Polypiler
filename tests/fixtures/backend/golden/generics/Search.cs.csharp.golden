  public static bool DefBoxIsNull() => Def<Box>() == null;

  public static bool MakeBoxIsNew() => !global::System.Object.ReferenceEquals(Make<Box>(), Make<Box>());

  public static int MakeBoxValue() => Make<Box>().Value;

  public static int IndexOf<T>(T[] a, T v) where T : global::System.IEquatable<T> {
    unchecked {
      {
        int i = 0;
        while (i < a.Length) {
          if (a[i].Equals(v)) {
            return i;
          }
          i = i + 1;
        }
      }
      return -1;
    }
  }

  public static void Swap<T>(T[] a, int i, int j) {
    var t = a[i];
    a[i] = a[j];
    a[j] = t;
  }

  public static T Max<T>(T a, T b) where T : global::System.IComparable<T> => (a.CompareTo(b) >= 0) ? a : b;

  public static T Def<T>() => default(T);

  public static T Make<T>() where T : new() => new T();

}
