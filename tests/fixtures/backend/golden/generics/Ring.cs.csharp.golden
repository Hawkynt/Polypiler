public sealed class Ring_Int64 {

  private readonly long[] _items;

  private int _count;

  public long Last {
    get {
      unchecked {
        return this._items[(this._count - 1) % this._items.Length];
      }
    }
  }

  public int Count {
    get {
      return this._count;
    }
  }

  public Ring_Int64(int capacity) {
    this._items = new long[capacity];
  }

  public void Push(long value) {
    unchecked {
      this._items[this._count % this._items.Length] = value;
      this._count = this._count + 1;
    }
  }

}

