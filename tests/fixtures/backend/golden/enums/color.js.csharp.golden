// color: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public enum Color : int {
  Red = 0,
  Green = 5,
  Blue = 6
}

public static class @color {

  public static int shade(int c) {
    switch (c) {
      case 0: {
        return 10;
      }
      case 5: {
        return 20;
      }
      default: {
        return 30;
      }
    }
  }

  private static int weight(Color c) {
    return (c == Color.Blue) ? 3 : 1;
  }

  public static int total() {
    unchecked {
      Color favourite = Color.Green;
      if (weight(Color.Blue) > 2) {
        favourite = Color.Blue;
      }
      return weight(favourite) + weight(Color.Red);
    }
  }

  public static int mix(int a) {
    return a | (int)Color.Green;
  }

}
