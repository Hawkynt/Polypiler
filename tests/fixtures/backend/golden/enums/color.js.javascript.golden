  const Color = Object.freeze({ Red: 0, Green: 5, Blue: 6 });

  // shade(c: number): number
  function shade(c) {
    switch (c) {
      case 0: {
        return 10;
      }
      case 5: {
        return 20;
      }
      default: {
        return 30;
      }
    }
  }

  // weight(c: number): number
  function weight(c) {
    return (c === Color.Blue) ? 3 : 1;
  }

  // total(): number
  function total() {
    let favourite = Color.Green;
    if (weight(Color.Blue) > 2) {
      favourite = Color.Blue;
    }
    return (weight(favourite) + weight(Color.Red)) | 0;
  }

  // mix(a: number): number
  function mix(a) {
    return a | Color.Green;
  }

  return {
    shade: shade,
    total: total,
    mix: mix,
    Color: Color
  };
})();
