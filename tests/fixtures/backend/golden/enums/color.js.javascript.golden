#### es5+cjs+accurate color.cjs 798
// color: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

var Color = Object.freeze({ Red: 0, Green: 5, Blue: 6 });

// shade(c: number): number
function shade(c) {
  switch (c) {
    case 0: {
      return 10;
    }
    case 5: {
      return 20;
    }
    default: {
      return 30;
    }
  }
}

// weight(c: number): number
function weight(c) {
  return (c === Color.Blue) ? 3 : 1;
}

// total(): number
function total() {
  var favourite = Color.Green;
  if (weight(Color.Blue) > 2) {
    favourite = Color.Blue;
  }
  return (weight(favourite) + weight(Color.Red)) | 0;
}

// mix(a: number): number
function mix(a) {
  return a | Color.Green;
}

exports.shade = shade;
exports.total = total;
exports.mix = mix;
exports.Color = Color;
