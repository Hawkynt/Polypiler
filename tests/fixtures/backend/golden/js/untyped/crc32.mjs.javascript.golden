// JavaScript profile: es5, cjs.
"use strict";

function $trunc(value) {
  return value < 0 ? Math.ceil(value) : Math.floor(value);
}

function $f2ic(value, low, high) {
  var whole = $trunc(value);
  if (!(whole >= low && whole <= high)) throw new RangeError("integer overflow");
  return whole + 0;
}

function $get(array, index) {
  if (index < 0 || index >= array.length) throw new RangeError("index out of range");
  return array[index];
}

// compute(data: Array<number>): number
function compute(data) {
  var crc = 4294967295;
  {
    var i = 0;
    while (i < data.length) {
      crc = ((crc | 0) ^ $get(data, $f2ic(i, -2147483648, 2147483647))) >>> 0;
      {
        var bit = 0;
        while (bit < 8) {
          crc = (((crc >>> 1) | 0) ^ ((-306674912) & ((0 - ((crc | 0) & 1)) | 0))) >>> 0;
          bit = bit + 1;
        }
      }
      i = i + 1;
    }
  }
  return ((crc | 0) ^ (-1)) >>> 0;
}

// check(): boolean
function check() {
  return compute([49, 50, 51, 52, 53, 54, 55, 56, 57]) === 3421780262;
}

exports.compute = compute;
exports.check = check;
