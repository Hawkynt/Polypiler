  let high = sorted.length - 1;
  while (low <= high) {
    let middle = ((low + high) >>> 0) >>> 1;
    let value = $get(sorted, middle);
    if (value === target) {
      return middle;
    }
    if (value < target) {
      low = middle + 1;
    } else {
      high = middle - 1;
    }
  }
  return -1;
}

// check(): boolean
