  return array[index];
}

// find(sorted: Int32Array, target: number): number
function find(sorted, target) {
  let low = 0;
  let high = sorted.length - 1;
  while (low <= high) {
    let middle = ((low + high) >>> 0) >>> 1;
    let value = $get(sorted, middle);
    if (value === target) {
      return middle;
    }
    if (value < target) {
      low = middle + 1;
    } else {
      high = middle - 1;
    }
  }
  return -1;
}

// check(): boolean
function check() {
  let sorted = new Int32Array([-7, -1, 0, 3, 8, 21]);
  return (find(sorted, 8) === 4) && (find(sorted, 4) === (-1));
}

exports.find = find;
exports.check = check;
