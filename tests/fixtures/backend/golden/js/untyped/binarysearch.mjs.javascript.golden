// binarysearch: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

function $get(array, index) {
  if (index < 0 || index >= array.length) throw new RangeError("index out of range");
  return array[index];
}

// find(sorted: Array<number>, target: number): number
function find(sorted, target) {
  var low = 0;
  var high = sorted.length - 1;
  while (low <= high) {
    var middle = ((low + high) >>> 0) >>> 1;
    var value = $get(sorted, middle);
    if (value === target) {
      return middle;
    }
    if (value < target) {
      low = middle + 1;
    } else {
      high = middle - 1;
    }
  }
  return -1;
}

// check(): boolean
function check() {
  var sorted = [-7, -1, 0, 3, 8, 21];
  return (find(sorted, 8) === 4) && (find(sorted, 4) === (-1));
}

exports.find = find;
exports.check = check;
