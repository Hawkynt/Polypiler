// stats: generated by polypiler. Change the source, not this file.
// JavaScript profile: es2015, esm.

class ArithmeticError extends RangeError {
  constructor(message) {
    super(message);
    this.name = "ArithmeticError";
  }
}

class OverflowError extends ArithmeticError {
  constructor(message) {
    super(message);
    this.name = "OverflowError";
  }
}

class IndexOutOfRangeError extends RangeError {
  constructor(message) {
    super(message);
    this.name = "IndexOutOfRangeError";
  }
}

function $f2ic(value, low, high) {
  const whole = Math.trunc(value);
  if (!(whole >= low && whole <= high)) throw new OverflowError("integer overflow");
  return whole + 0;
}

function $get(array, index) {
  if (index < 0 || index >= array.length) throw new IndexOutOfRangeError("index out of range");
  return array[index];
}

// mean(values: Float64Array): number
export function mean(values) {
  let sum = 0;
  {
    let i = 0;
    while (i < values.length) {
      sum = sum + $get(values, $f2ic(i, -2147483648, 2147483647));
      i = i + 1;
    }
  }
  return sum / values.length;
}

// variance(values: Float64Array): number
export function variance(values) {
  let center = mean(values);
  let sum = 0;
  {
    let i = 0;
    while (i < values.length) {
      let distance = $get(values, $f2ic(i, -2147483648, 2147483647)) - center;
      sum = sum + (distance * distance);
      i = i + 1;
    }
  }
  return sum / values.length;
}

// check(): boolean
export function check() {
  let values = new Float64Array([2, 4, 4, 4, 5, 5, 7, 9]);
  return (mean(values) === 5) && (variance(values) === 4);
}
