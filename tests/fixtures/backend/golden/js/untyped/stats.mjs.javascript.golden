// stats: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

function $trunc(value) {
  return value < 0 ? Math.ceil(value) : Math.floor(value);
}

function $f2ic(value, low, high) {
  var whole = $trunc(value);
  if (!(whole >= low && whole <= high)) throw new RangeError("integer overflow");
  return whole + 0;
}

function $get(array, index) {
  if (index < 0 || index >= array.length) throw new RangeError("index out of range");
  return array[index];
}

// mean(values: Array<number>): number
function mean(values) {
  var sum = 0;
  {
    var i = 0;
    while (i < values.length) {
      sum = sum + $get(values, $f2ic(i, -2147483648, 2147483647));
      i = i + 1;
    }
  }
  return sum / values.length;
}

// variance(values: Array<number>): number
function variance(values) {
  var center = mean(values);
  var sum = 0;
  {
    var i = 0;
    while (i < values.length) {
      var distance = $get(values, $f2ic(i, -2147483648, 2147483647)) - center;
      sum = sum + (distance * distance);
      i = i + 1;
    }
  }
  return sum / values.length;
}

// check(): boolean
function check() {
  var values = [2, 4, 4, 4, 5, 5, 7, 9];
  return (mean(values) === 5) && (variance(values) === 4);
}

exports.mean = mean;
exports.variance = variance;
exports.check = check;
