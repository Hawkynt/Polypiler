  function next(state) {
    state = state ^ (state << 13);
    state = state ^ (((state >>> 0) >>> 17) | 0);
    state = state ^ (state << 5);
    return state >>> 0;
  }

  // skip(state: number, count: number): number
  function skip(state, count) {
    let x = state;
    {
      let i = 0;
      while (i < count) {
        x = next(x) | 0;
        i = i + 1;
      }
    }
    return x >>> 0;
  }

  return {
    next: next,
    skip: skip
  };
})();
