      result = (result * x) + $get(coefficients, $f2ic(i, -2147483648, 2147483647));
      i = i + 1;
    }
  }
  return result;
}

// check(): boolean
function check() {
  return evaluate([2, -6, 2, -1], 3) === 5;
}

exports.evaluate = evaluate;
exports.check = check;
