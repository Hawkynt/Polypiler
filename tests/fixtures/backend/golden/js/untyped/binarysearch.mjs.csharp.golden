public static class @binarysearch {

  public static double find(int[] sorted, double target) {
    double low = 0.0;
    double high = (double)sorted.Length - 1.0;
    while (low <= high) {
      uint middle = ToUint32(low + high) >> 1;
      int value = sorted[middle];
      if ((double)value == target) {
        return (double)middle;
      }
      if ((double)value < target) {
        low = (double)middle + 1.0;
      } else {
        high = (double)middle - 1.0;
      }
    }
    return -1.0;
  }

  public static bool check() {
    int[] sorted = new int[] { -7, -1, 0, 3, 8, 21 };
    return (find(sorted, 8.0) == 4.0) && (find(sorted, 4.0) == -1.0);
  }

  private static uint ToUint32(double value) {
    return double.IsNaN(value) || double.IsInfinity(value) ? 0u : unchecked((uint)(long)(global::System.Math.Truncate(value) % 4294967296.0));
  }

}
