      }
      return count;
    }
  }

  public static bool check() {
    var data = new byte[] { 49, 50, 0, 0, 97, 55 };
    return ((runs(data, 1.0) == 2) && (runs(data, 0.0) == 1)) && (runs(data, 2.0) == 1);
  }

}
