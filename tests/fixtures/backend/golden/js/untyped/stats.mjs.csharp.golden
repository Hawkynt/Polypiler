// stats: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public static class @stats {

  public static double mean(double[] values) {
    double sum = 0.0;
    {
      double i = 0.0;
      while (i < (double)values.Length) {
        sum = sum + values[checked((int)i)];
        i = i + 1.0;
      }
    }
    return sum / (double)values.Length;
  }

  public static double variance(double[] values) {
    double center = mean(values);
    double sum = 0.0;
    {
      double i = 0.0;
      while (i < (double)values.Length) {
        double distance = values[checked((int)i)] - center;
        sum = sum + (distance * distance);
        i = i + 1.0;
      }
    }
    return sum / (double)values.Length;
  }

  public static bool check() {
    double[] values = new double[] { 2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0 };
    return (mean(values) == 5.0) && (variance(values) == 4.0);
  }

}
