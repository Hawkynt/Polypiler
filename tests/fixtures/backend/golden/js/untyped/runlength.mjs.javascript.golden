function $f2ic(value, low, high) {
  const whole = Math.trunc(value);
  if (!(whole >= low && whole <= high)) throw new RangeError("integer overflow");
  return whole + 0;
}

function $get(array, index) {
  if (index < 0 || index >= array.length) throw new RangeError("index out of range");
  return array[index];
}

// runs(data: Uint8Array, kind: number): number
function runs(data, kind) {
  let count = 0;
  let inside = false;
  {
    let i = 0;
    while (i < data.length) {
      let matches;
      switch ($get(data, $f2ic(i, -2147483648, 2147483647))) {
        case 0: {
          matches = kind === 0;
          break;
        }
        case 48:
        case 49:
        case 50:
        case 51:
        case 52:
        case 53:
        case 54:
        case 55:
        case 56:
        case 57: {
          matches = kind === 1;
          break;
        }
        default: {
          matches = kind === 2;
          break;
        }
      }
      if (matches && (!inside)) {
        count = (count + 1) | 0;
      }
      inside = matches;
      i = i + 1;
    }
  }
  return count;
}

// check(): boolean
function check() {
  let data = new Uint8Array([49, 50, 0, 0, 97, 55]);
  return ((runs(data, 1) === 2) && (runs(data, 0) === 1)) && (runs(data, 2) === 1);
}

exports.runs = runs;
exports.check = check;
