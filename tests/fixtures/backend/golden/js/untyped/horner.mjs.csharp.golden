    double result = 0.0;
    {
      double i = 0.0;
      while (i < (double)coefficients.Length) {
        result = (result * x) + coefficients[checked((int)i)];
        i = i + 1.0;
      }
    }
    return result;
  }

  public static bool check() => evaluate(new double[] { 2.0, -6.0, 2.0, -1.0 }, 3.0) == 5.0;

}
