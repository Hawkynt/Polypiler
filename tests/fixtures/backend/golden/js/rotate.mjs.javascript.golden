// rotate: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

// rotateLeft(value: number, count: number): number
function rotateLeft(value, count) {
  return (((value | 0) << count) | ((value >>> ((32 - count) | 0)) | 0)) >>> 0;
}

// rotateRight(value: number, count: number): number
function rotateRight(value, count) {
  return (((value >>> count) | 0) | ((value | 0) << ((32 - count) | 0))) >>> 0;
}

exports.rotateLeft = rotateLeft;
exports.rotateRight = rotateRight;
