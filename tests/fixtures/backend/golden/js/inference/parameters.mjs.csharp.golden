    int count = 0;
    if (value <= 0x0000FFFFu) { count += 16; value <<= 16; }
    if (value <= 0x00FFFFFFu) { count += 8; value <<= 8; }
    if (value <= 0x0FFFFFFFu) { count += 4; value <<= 4; }
    if (value <= 0x3FFFFFFFu) { count += 2; value <<= 2; }
    if (value <= 0x7FFFFFFFu) { count += 1; }
