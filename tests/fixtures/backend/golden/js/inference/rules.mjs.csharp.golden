    var x = a < b;
    return x;
  }

  public static int fromConditional(int a, double b) {
    var x = (b > 0.0) ? a : 7;
    return x;
  }

  public static ulong fromBigIntWrapper(int a) {
    unchecked {
      var x = (ulong)(long)a * 3UL;
      return x;
    }
  }

  public static long fromSignedBigIntWrapper(int a) {
    unchecked {
      var x = (long)a * 3L;
      return x;
    }
  }

  public static long fromBigIntLiteral() {
    long x = 123;
    return x;
  }

  public static ulong fromLargeBigIntLiteral() {
    ulong x = 18446744073709551615;
    return x;
  }

  public static int fromRecursion(double a) {
    var x = ((ToInt32(a) & 7) == 0) ? 1 : fromRecursion((double)(ToInt32(a) & 7) - 1.0);
    return x;
  }

  private static int ToInt32(double value) {
    return double.IsNaN(value) || double.IsInfinity(value) ? 0 : unchecked((int)(long)(global::System.Math.Truncate(value) % 4294967296.0));
  }

}
