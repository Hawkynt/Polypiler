  return items.length;
}

// xorBigUint64(items: Array<{ hi, lo }>): { hi, lo }
export function xorBigUint64(items) {
  let all = { hi: 0, lo: 0 };
  {
    let i = 0;
    while (i < items.length) {
      all = $xor64(all, $get(items, $f2ic(i, -2147483648, 2147483647)));
