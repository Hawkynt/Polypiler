// scaleFloat64(items: Float64Array): number
export function scaleFloat64(items) {
  {
    let i = 0;
    while (i < items.length) {
      let $t1 = $f2ic(i, -2147483648, 2147483647);
      $set(items, $t1, $get(items, $t1) * 1.5);
      i = i + 1;
    }
  }
  return items.length;
}

// scaleFloat32(items: Float32Array): number
export function scaleFloat32(items) {
  {
    let i = 0;
    while (i < items.length) {
      $set(items, $f2ic(i, -2147483648, 2147483647), Math.fround($get(items, $f2ic(i, -2147483648, 2147483647)) * 1.1));
      i = i + 1;
