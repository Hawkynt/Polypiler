  for (let index = 0; index < length; ++index) array[index] = zero;
  return array;
}

function $step(array, index, delta, post) {
  if (index < 0 || index >= array.length) throw new RangeError("index out of range");
  const before = array[index];
  array[index] = before + delta;
  return post ? before : array[index];
}

function $step64(array, index, up, post) {
  if (index < 0 || index >= array.length) throw new RangeError("index out of range");
  const before = array[index];
  const after = up ? $add64(before, { hi: 0, lo: 1 }) : $sub64(before, { hi: 0, lo: 1 });
  array[index] = after;
  return post ? before : after;
}

function $len(length) {
  if (length < 0) throw new RangeError("integer overflow");
  return length;
}

// int8(a: number): number
export function int8(a) {
  let items = new Int8Array($len(2));
  $set(items, 0, (a | 0) << 24 >> 24);
  $set(items, 1, (($get(items, 1) + a) | 0) << 24 >> 24);
  $step(items, 1, 1, true);
  return ($get(items, 0) + $get(items, 1)) + items.length;
}

// uint8(a: number): number
export function uint8(a) {
  let items = new Uint8Array($len(2));
  $set(items, 0, (a | 0) & 0xFF);
  $set(items, 1, (($get(items, 1) - a) | 0) & 0xFF);
  $step(items, 1, -1, true);
  return ($get(items, 0) + $get(items, 1)) + items.length;
}

// int16(a: number): number
export function int16(a) {
  let items = new Int16Array($len(2));
  $set(items, 0, (a | 0) << 16 >> 16);
  $set(items, 1, ($get(items, 1) ^ (a | 0)) << 16 >> 16);
  return ($get(items, 0) + $get(items, 1)) + items.length;
}

// uint16(a: number): number
export function uint16(a) {
  let items = new Uint16Array($len(2));
  $set(items, 0, (a | 0) & 0xFFFF);
  $set(items, 1, ($get(items, 1) | (a | 0)) & 0xFFFF);
  return ($get(items, 0) + $get(items, 1)) + items.length;
}

// int32(a: number): number
export function int32(a) {
  let items = new Int32Array($len(2));
  $set(items, 0, a | 0);
  $set(items, 1, ($get(items, 1) + a) | 0);
  $set(items, 1, $get(items, 1) << 1);
  return ($get(items, 0) + $get(items, 1)) + items.length;
}

// uint32(a: number): number
export function uint32(a) {
  let items = new Uint32Array($len(2));
  $set(items, 0, (a | 0) >>> 0);
  $set(items, 1, (($get(items, 1) - a) | 0) >>> 0);
  $set(items, 1, $get(items, 1) >>> 1);
  return ($get(items, 0) + $get(items, 1)) + items.length;
}

// float32(a: number): number
export function float32(a) {
  let items = new Float32Array($len(2));
  $set(items, 0, Math.fround(a));
  $set(items, 1, Math.fround($get(items, 1) + a));
  $step(items, 1, 1, true);
  return ($get(items, 0) + $get(items, 1)) + items.length;
}

// float64(a: number): number
export function float64(a) {
  let items = new Float64Array($len(2));
  $set(items, 0, a);
  $set(items, 1, $get(items, 1) + a);
  $set(items, 1, $get(items, 1) / 3);
  $step(items, 1, -1, true);
  return ($get(items, 0) + $get(items, 1)) + items.length;
}

// bigInt64(a: { hi, lo }): { hi, lo }
export function bigInt64(a) {
  let items = $new($len(2), { hi: 0, lo: 0 });
  $set(items, 0, a);
  $set(items, 1, $mul64(a, { hi: 0, lo: 3 }));
  $step64(items, 1, true, true);
  return $add64($get(items, 0), $get(items, 1));
}

// bigUint64(a: { hi, lo }): { hi, lo }
export function bigUint64(a) {
  let items = $new($len(2), { hi: 0, lo: 0 });
  $set(items, 0, a);
  $set(items, 1, $mul64(a, { hi: 0, lo: 3 }));
  $step64(items, 1, false, true);
  return $xor64($get(items, 0), $get(items, 1));
}

// postfixElement(a: number): number
export function postfixElement(a) {
  let items = new Uint8Array($len(1));
  $set(items, 0, (a | 0) & 0xFF);
  let before = $step(items, 0, 1, true);
  return before + ($get(items, 0) * 1000);
}

// listedElements(a: number): number
export function listedElements(a) {
  let items = new Uint8Array([1, 2, 44, (a | 0) & 0xFF]);
  return ((($get(items, 0) + $get(items, 1)) + $get(items, 2)) + $get(items, 3)) + items.length;
}

// listedFloats(a: number): number
export function listedFloats(a) {
  let items = new Float32Array([Math.fround(0.1), Math.fround(a)]);
  return $get(items, 0) + $get(items, 1);
}

// literalOfIntegers(n: number): number
export function literalOfIntegers(n) {
  let items = new Int32Array([1, 2, 3, n]);
  $set(items, 1, n >> 1);
  return (($get(items, 0) + $get(items, 1)) + $get(items, 3)) + items.length;
}

// literalOfNumbers(n: number): number
export function literalOfNumbers(n) {
  let items = new Float64Array([1, 2.5, n]);
  return ($get(items, 0) + $get(items, 1)) + $get(items, 2);
}

// literalThenFraction(n: number): number
export function literalThenFraction(n) {
  let items = new Float64Array([1, 2, 3]);
  $set(items, 0, n / 2);
  return $get(items, 0) + $get(items, 1);
}

// literalStepped(n: number): number
export function literalStepped(n) {
  let items = new Float64Array([1, 2, n]);
  $step(items, 2, 1, true);
  $set(items, 0, $get(items, 0) + 0.5);
  return $get(items, 0) + $get(items, 2);
}

// emptyLiteral(n: number): number
export function emptyLiteral(n) {
  let items = new Float64Array([]);
  return items.length + n;
}

// newArray(n: number): number
export function newArray(n) {
  let items = new Int32Array($len(4));
  {
    let i = 0;
    while (i < 4) {
      $set(items, $f2ic(i, -2147483648, 2147483647), (n + i) | 0);
      i = i + 1;
    }
  }
  return ($get(items, 0) + $get(items, 3)) + items.length;
}

// newArrayOfNumbers(n: number): number
export function newArrayOfNumbers(n) {
  let items = new Float64Array($len(n & 3));
  {
    let i = 0;
    while (i < items.length) {
      $set(items, $f2ic(i, -2147483648, 2147483647), n / 2);
      i = i + 1;
    }
  }
  let sum = 0;
  {
    let i = 0;
    while (i < items.length) {
      sum = sum + $get(items, $f2ic(i, -2147483648, 2147483647));
      i = i + 1;
    }
  }
  return sum;
}

// newArrayWithoutLength(): number
export function newArrayWithoutLength() {
  let items = new Float64Array($len(0));
  return items.length;
}

// fractionalLength(a: number): number
export function fractionalLength(a) {
  return new Uint8Array($len($f2i(Math.abs(a % 8), -2147483648, 2147483647))).length;
}

// unsignedLength(u: number): number
export function unsignedLength(u) {
  return new Uint8Array($len((u | 0) & 15)).length + new Float64Array($len((u | 0) & 3)).length;
}

// unsignedIndex(u: number): number
export function unsignedIndex(u) {
  let items = new Uint8Array([5, 6, 7, 8]);
  return $get(items, (u | 0) & 3) + $get(items, u >>> 30);
}

// chosenArray(n: number): number
export function chosenArray(n) {
  let first = new Int32Array([1, 2]);
  let second = new Int32Array([3, 4]);
  return $get((n > 0) ? first : second, 1);
}

// returnedLiteral(n: number): number
export function returnedLiteral(n) {
  return $get(pair(n), 1);
}

// pair(n: number): Uint8Array
function pair(n) {
  return new Uint8Array([(n & 255) & 0xFF, ((n >> 8) & 255) & 0xFF]);
}

// sumInt8(items: Int8Array): number
export function sumInt8(items) {
  let sum = 0;
  {
    let i = 0;
    while (i < items.length) {
      sum = sum + $get(items, $f2ic(i, -2147483648, 2147483647));
      i = i + 1;
    }
  }
  return sum;
}

