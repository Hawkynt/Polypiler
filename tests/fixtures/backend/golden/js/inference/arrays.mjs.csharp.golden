        double i = 0.0;
        while (i < (double)items.Length) {
          items[checked((int)i)] = 0L - items[checked((int)i)];
          i = i + 1.0;
        }
      }
      return items.Length;
    }
  }

  public static byte readAt(byte[] items, double a) => unchecked((byte)(int)items[checked((int)a)]);

  public static double sumNumbers(double[] items) {
    double sum = 0.0;
    {
      double i = 0.0;
      while (i < (double)items.Length) {
        sum = sum + items[checked((int)i)];
        i = i + 1.0;
      }
    }
    return sum;
  }

  private static int ToInt32(double value) {
    return double.IsNaN(value) || double.IsInfinity(value) ? 0 : unchecked((int)(long)(global::System.Math.Truncate(value) % 4294967296.0));
  }

}
