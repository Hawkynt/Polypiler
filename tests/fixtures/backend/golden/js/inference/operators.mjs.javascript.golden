// operators: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

// add(a: number, b: number): number
function add(a, b) {
  return a + b;
}

// subtract(a: number, b: number): number
function subtract(a, b) {
  return a - b;
}

// multiply(a: number, b: number): number
function multiply(a, b) {
  return a * b;
}

// quotient(a: number, b: number): number
function quotient(a, b) {
  return a / b;
}

// modulo(a: number, b: number): number
function modulo(a, b) {
  return a % b;
}

// negate(a: number): number
function negate(a) {
  return -a;
}

// plus(a: number): number
function plus(a) {
  return a;
}

// or(a: number, b: number): number
function or(a, b) {
  return (a | 0) | (b | 0);
}

// and(a: number, b: number): number
function and(a, b) {
  return (a | 0) & (b | 0);
}

// xor(a: number, b: number): number
function xor(a, b) {
  return (a | 0) ^ (b | 0);
}

// not(a: number): number
function not(a) {
  return ~(a | 0);
}

// shiftLeft(a: number, b: number): number
function shiftLeft(a, b) {
  return (a | 0) << (b | 0);
}

// shiftRight(a: number, b: number): number
function shiftRight(a, b) {
  return (a | 0) >> (b | 0);
}

// shiftRightLogical(a: number, b: number): number
function shiftRightLogical(a, b) {
  return (a >>> 0) >>> (b | 0);
}

// less(a: number, b: number): boolean
function less(a, b) {
  return a < b;
}

// lessOrEqual(a: number, b: number): boolean
function lessOrEqual(a, b) {
  return a <= b;
}

// greater(a: number, b: number): boolean
function greater(a, b) {
  return a > b;
}

// greaterOrEqual(a: number, b: number): boolean
function greaterOrEqual(a, b) {
  return a >= b;
}

// strictlyEqual(a: number, b: number): boolean
function strictlyEqual(a, b) {
  return a === b;
}

// strictlyUnequal(a: number, b: number): boolean
function strictlyUnequal(a, b) {
  return a !== b;
}

// looselyEqual(a: number, b: number): boolean
function looselyEqual(a, b) {
  return a === b;
}

// looselyUnequal(a: number, b: number): boolean
function looselyUnequal(a, b) {
  return a !== b;
}

// truthy(a: number): number
function truthy(a) {
  return (Math.abs(a) > 0) ? 1 : 0;
}

// falsy(a: number): boolean
function falsy(a) {
  return !(Math.abs(a) > 0);
}

// andValue(a: number, b: number): number
function andValue(a, b) {
  return (Math.abs(a) > 0) ? b : a;
}

// orValue(a: number, b: number): number
function orValue(a, b) {
  return (Math.abs(a) > 0) ? a : b;
}

// andCondition(a: number, b: number): number
function andCondition(a, b) {
  return ((Math.abs(a) > 0) && (Math.abs(b) > 0)) ? 1 : 0;
}

// orCondition(a: number, b: number): number
function orCondition(a, b) {
  if ((Math.abs(a) > 0) || (Math.abs(b) > 0)) {
    return 1;
  }
  return 0;
}

// choose(a: number, b: number): number
function choose(a, b) {
  return (a > b) ? a : b;
}

// addMixed(i: number, d: number): number
function addMixed(i, d) {
  return i + d;
}

// multiplyMixed(i: number, d: number): number
function multiplyMixed(i, d) {
  return i * d;
}

// moduloMixed(i: number, d: number): number
function moduloMixed(i, d) {
  return i % d;
}

// lessMixed(i: number, d: number): boolean
function lessMixed(i, d) {
  return i < d;
}

// equalMixed(i: number, d: number): boolean
function equalMixed(i, d) {
  return i === d;
}

// xorMixed(i: number, d: number): number
function xorMixed(i, d) {
  return i ^ (d | 0);
}

// chooseMixed(i: number, d: number): number
function chooseMixed(i, d) {
  return (d > 0) ? i : d;
}

// lessSignedUnsigned(i: number, u: number): boolean
function lessSignedUnsigned(i, u) {
  return i < u;
}

// equalSignedUnsigned(i: number, u: number): boolean
function equalSignedUnsigned(i, u) {
  return i === u;
}

// addSignedUnsigned(i: number, u: number): number
function addSignedUnsigned(i, u) {
  return i + u;
}

// moduloSignedUnsigned(i: number, u: number): number
function moduloSignedUnsigned(i, u) {
  return i % u;
}

// quotientSignedUnsigned(i: number, u: number): number
function quotientSignedUnsigned(i, u) {
  return (i / u) | 0;
}

// lessIntByte(i: number, c: number): boolean
function lessIntByte(i, c) {
  return i < c;
}

// lessUintByte(u: number, c: number): boolean
function lessUintByte(u, c) {
  return u < c;
}

// truthyInt(i: number): number
function truthyInt(i) {
  return (i !== 0) ? 1 : 0;
}

// truthyUint(u: number): number
function truthyUint(u) {
  return (u !== 0) ? 1 : 0;
}

// truthyByte(c: number): number
function truthyByte(c) {
  return (c !== 0) ? 1 : 0;
}

// orValueInts(i: number, j: number): number
function orValueInts(i, j) {
  return (i !== 0) ? i : j;
}

// andTruths(s: boolean, t: boolean): boolean
function andTruths(s, t) {
  return s && t;
}

// equalTruths(s: boolean, t: boolean): boolean
function equalTruths(s, t) {
  return s === t;
}

// unequalTruths(s: boolean, t: boolean): boolean
function unequalTruths(s, t) {
  return s !== t;
}

// moduloInts(i: number, j: number): number
function moduloInts(i, j) {
  return i % j;
}

// moduloIntsIsZero(i: number, j: number): boolean
function moduloIntsIsZero(i, j) {
  return (i % j) === 0;
}

// quotientInts(i: number, j: number): number
function quotientInts(i, j) {
  return i / j;
}

