  // notSigned(a: bigint): bigint
  function notSigned(a) {
    return ~a;
  }

  // shiftRightSigned(a: bigint): bigint
  function shiftRightSigned(a) {
    return a >> 7n;
  }

  // shiftLeftSigned(a: bigint): bigint
  function shiftLeftSigned(a) {
    return BigInt.asIntN(64, a << 1n);
  }

  // divideSigned(a: bigint, b: bigint): bigint
  function divideSigned(a, b) {
    return $div64(a, b);
  }

  // remainderSigned(a: bigint, b: bigint): bigint
  function remainderSigned(a, b) {
    return $rem64(a, b);
  }

  // lessSigned(a: bigint, b: bigint): boolean
  function lessSigned(a, b) {
    return a < b;
  }

  // isNegative(a: bigint): boolean
  function isNegative(a) {
    return a < 0n;
  }

  // toUnsigned(a: bigint): bigint
  function toUnsigned(a) {
    return BigInt.asUintN(64, a);
  }

  // steps(a: bigint): number
  function steps(a) {
    let x = a;
    let count = 0;
    while ((x !== 0n) && (count < 70)) {
      x = x >> 1n;
      count = (count + 1) | 0;
    }
    return count;
  }

  // fromInt(i: number): bigint
  function fromInt(i) {
    return BigInt.asIntN(64, BigInt(i) * 4294967296n);
  }

  // fromUint(u: number): bigint
  function fromUint(u) {
    return BigInt.asUintN(64, BigInt.asUintN(64, BigInt(u)) * 4294967297n);
  }

  // largest(): bigint
  function largest() {
    return 18446744073709551615n;
  }

  // smallest(): bigint
  function smallest() {
    return -9223372036854775808n;
  }

  return {
    add: add,
    subtract: subtract,
    multiply: multiply,
    and: and,
    or: or,
    xor: xor,
    not: not,
    negate: negate,
    shiftLeft: shiftLeft,
    shiftLeftBy63: shiftLeftBy63,
    shiftRight: shiftRight,
    shiftRightBy0: shiftRightBy0,
    divide: divide,
    remainder: remainder,
    mix: mix,
    less: less,
    equal: equal,
    isZero: isZero,
    isLarge: isLarge,
    toSigned: toSigned,
    addSigned: addSigned,
    multiplySigned: multiplySigned,
    negateSigned: negateSigned,
    notSigned: notSigned,
    shiftRightSigned: shiftRightSigned,
    shiftLeftSigned: shiftLeftSigned,
    divideSigned: divideSigned,
    remainderSigned: remainderSigned,
    lessSigned: lessSigned,
    isNegative: isNegative,
    toUnsigned: toUnsigned,
    steps: steps,
    fromInt: fromInt,
    fromUint: fromUint,
    largest: largest,
    smallest: smallest
  };
})();
