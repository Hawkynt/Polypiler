// sib: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

// h(n: number): number
function h(n) {
  var s = 0;
  if (n > 0) {
    var t = n | 0;
    s = s + t;
  } else {
    var t = n * 0.5;
    s = s + t;
  }
  return s;
}

exports.h = h;
