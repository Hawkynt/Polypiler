// records: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
// A struct is an object of its fields, copied wherever the place it is read from can still be used.
"use strict";

// f(n: number): number
function f(n) {
  var s = 0;
  if (n > 1) {
    var p = { x: n | 0, y: 3 };
    s = s + (p.x * p.y);
  }
  var p = { x: 0.5, y: n };
  return s + (p.x * p.y);
}

exports.f = f;
