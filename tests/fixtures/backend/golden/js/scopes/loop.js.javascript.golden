// loop: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

// g(n: number): number
function g(n) {
  var s = 0;
  {
    var i = 0;
    while (i < n) {
      s = s + n;
      i = i + 1;
    }
  }
  var i = 10;
  return (n > 0) ? s : i;
}

exports.g = g;
