// gcd: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public static class @gcd {

  public static double gcd_(int a, int b) {
    double a_0 = (double)a;
    double b_0 = (double)b;
    while (b_0 != 0.0) {
      double remainder = a_0 % b_0;
      a_0 = b_0;
      b_0 = remainder;
    }
    return a_0;
  }

}
