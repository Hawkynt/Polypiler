  // BothThrow(): string
  function BothThrow() {
    let log = new Int32Array($len(16));
    try {
      const outer = new Res(log, 1, true);
      try {
        const inner = new Res(log, 2, true);
        try {
          Res.Write(log, 5);
        } finally {
          if (inner != null) inner.Dispose();
        }
      } finally {
        if (outer != null) outer.Dispose();
      }
    } catch (e) {
      if (e instanceof X) {
        return Text(log, e.message);
      } else {
        throw e;
      }
    }
    return Text(log, "");
  }

  // BodyAndDisposeThrow(): string
  function BodyAndDisposeThrow() {
    let log = new Int32Array($len(16));
    try {
      const resource = new Res(log, 1, true);
      try {
        Res.Write(log, 5);
        throw new X("body");
      } finally {
        if (resource != null) resource.Dispose();
      }
    } catch (e) {
      if (e instanceof X) {
        return Text(log, e.message);
      } else {
        throw e;
      }
    }
  }

  // Declarators(): string
  function Declarators() {
    let log = new Int32Array($len(16));
    const first = new Res(log, 1, false);
    try {
      const second = new Res(log, 2, false);
      try {
        Res.Write(log, 5);
      } finally {
        if (second != null) second.Dispose();
      }
    } finally {
      if (first != null) first.Dispose();
    }
    return Text(log, "");
  }

  // Expression(): string
  function Expression() {
    let log = new Int32Array($len(16));
    let resource = new Res(log, 1, false);
    const $t2 = resource;
    try {
      Res.Write(log, 5);
    } finally {
      if ($t2 != null) $t2.Dispose();
    }
    return Text(log, "");
  }

  // Three(): string
  function Three() {
    let log = new Int32Array($len(16));
    const first = new Res(log, 1, false);
    try {
      const second = new Res(log, 2, false);
      try {
        const third = new Res(log, 3, false);
        try {
          Res.Write(log, 5);
        } finally {
          if (third != null) third.Dispose();
        }
      } finally {
        if (second != null) second.Dispose();
      }
    } finally {
      if (first != null) first.Dispose();
    }
    return Text(log, "");
  }

  // Computed(log: Int32Array): number
  function Computed(log) {
    const resource = new Res(log, 1, false);
    try {
      return ($get(log, 0) + 6) | 0;
    } finally {
      if (resource != null) resource.Dispose();
    }
  }

  // Returns(): string
  function Returns() {
    let log = new Int32Array($len(16));
    Res.Write(log, Computed(log));
    return Text(log, "");
  }

  // Breaks(): string
  function Breaks() {
    let log = new Int32Array($len(16));
    {
      let id = 1;
      while (id <= 3) {
        const resource = new Res(log, id, false);
        try {
          if (id === 2) {
            break;
          }
          Res.Write(log, 5);
        } finally {
          if (resource != null) resource.Dispose();
        }
        id = (id + 1) | 0;
      }
    }
    return Text(log, "");
  }

  // Continues(): string
  function Continues() {
    let log = new Int32Array($len(16));
    {
      let id = 1;
      for (; id <= 3; id = (id + 1) | 0) {
        const resource = new Res(log, id, false);
        try {
          if (id === 2) {
            continue;
          }
          Res.Write(log, 5);
        } finally {
          if (resource != null) resource.Dispose();
        }
      }
    }
    return Text(log, "");
  }

  // Explicit(): string
  function Explicit() {
    let log = new Int32Array($len(16));
    const quiet = new Quiet(log, 1);
    try {
      const disposable = new Quiet(log, 2);
      try {
        Res.Write(log, 5);
      } finally {
        if (disposable != null) disposable.Dispose();
      }
    } finally {
      if (quiet != null) quiet.Dispose();
    }
    return Text(log, "");
  }

  return {
    Nest: Nest,
    BodyThrows: BodyThrows,
    DisposeThrows: DisposeThrows,
    NullResource: NullResource,
    BothThrow: BothThrow,
    BodyAndDisposeThrow: BodyAndDisposeThrow,
    Declarators: Declarators,
    Expression: Expression,
    Three: Three,
    Returns: Returns,
    Breaks: Breaks,
    Continues: Continues,
    Explicit: Explicit,
    Res: Res,
    Quiet: Quiet,
    X: X
  };
})();
