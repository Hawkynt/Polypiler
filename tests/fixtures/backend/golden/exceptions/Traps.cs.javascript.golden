    if (a === -2147483648 && b === -1) throw new OverflowError("integer overflow");
    return (a / b) | 0;
  }

  function $ck(value, low, high) {
    if (value < low || value > high) throw new OverflowError("integer overflow");
    return value;
  }

  function $get(array, index) {
    if (index < 0 || index >= array.length) throw new IndexOutOfRangeError("index out of range");
    return array[index];
  }

  function $len(length) {
    if (length < 0) throw new OverflowError("integer overflow");
    return length;
  }

  function $cast_Square(value) {
    if (value === null || value instanceof Square) return value;
    throw new InvalidCastError("invalid cast");
  }

  // class Box
  class Box {
    Value = 0;
    constructor() {
    }
  }

  // class Shape
  class Shape {
    constructor() {
    }
  }

  // class Circle
  class Circle extends Shape {
    constructor() {
      super();
    }
  }

  // class Square
  class Square extends Shape {
    Side = 0;
    constructor() {
      super();
    }
  }

  // Raise(k: number): number
  function Raise(k) {
    let zero = (k - k) | 0;
    let empty = new Int32Array($len(zero));
    let box = null;
    if (k === 0) {
      return $div(1, zero);
    }
    if (k === 1) {
      return $get(empty, k);
    }
    if (k === 2) {
      return $ck(2147483647 + k, -2147483648, 2147483647);
    }
    if (k === 3) {
      return SignOf(NaN + k);
    }
    if (k === 4) {
      return box.Value;
    }
    return k;
  }

  // Classify(k: number): number
  function Classify(k) {
    try {
      Raise(k);
      return 0;
    } catch ($e) {
      if ($e instanceof DivideByZeroError) {
        return 1;
      } else if ($e instanceof IndexOutOfRangeError) {
        return 2;
      } else if ($e instanceof OverflowError) {
        return 3;
      } else if ($e instanceof ArithmeticError) {
        return 4;
      } else if ($e instanceof TypeError && !($e instanceof InvalidCastError)) {
        return 5;
      } else {
        throw $e;
      }
    }
  }

  // ByBase(k: number): number
  function ByBase(k) {
    try {
      try {
        Raise(k);
        return 0;
      } catch ($e) {
        if ($e instanceof IndexOutOfRangeError) {
          return 7;
        } else {
          throw $e;
        }
      }
    } catch ($e) {
      if ($e instanceof ArithmeticError) {
        return 8;
      } else {
        return 9;
      }
    }
  }

  // Cast(k: number): number
  function Cast(k) {
    let shape = new Circle();
    let box = null;
    try {
      if (k === 0) {
        return $cast_Square(shape).Side;
      }
      return box.Value;
    } catch ($e) {
      if ($e instanceof InvalidCastError) {
        return 6;
      } else if ($e instanceof TypeError && !($e instanceof InvalidCastError)) {
        return 5;
      } else {
        throw $e;
      }
    }
  }

  // SignOf(value: number): number
  function SignOf(value) {
    if ((!(value < 0)) && (!(value >= 0))) {
      throw new ArithmeticError("invalid operation");
    }
    return (value < 0) ? (-1) : ((value > 0) ? 1 : 0);
  }

  return {
    Classify: Classify,
    ByBase: ByBase,
    Cast: Cast,
    Box: Box,
    Shape: Shape,
    Circle: Circle,
    Square: Square
  };
})();
