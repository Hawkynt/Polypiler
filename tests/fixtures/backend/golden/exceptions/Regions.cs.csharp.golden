public sealed class RegionException : global::System.Exception {

  public RegionException(string message) : base(message) {
  }

}

public static class RegionsDemo {

  internal static string _log = "";

  internal static bool Log(string entry) {
    _log = string.Concat(_log, entry);
    return true;
  }

  internal static string Thrower(bool fail) {
    if (fail) {
      throw new RegionException("boom");
    }
    return "ok";
  }

  public static string Observed(bool fail) {
    var trace = "t1";
    try {
      trace = string.Concat(trace, " ", Thrower(fail));
    } catch (RegionException e) {
      trace = string.Concat(trace, " caught ", e.Message);
    } finally {
      trace = string.Concat(trace, " finally");
    }
    return trace;
  }

  public static int Returned(int k) {
    unchecked {
      var s = k;
      try {
        if (k > 0) {
          return s * 2;
        }
        s = -1;
      } finally {
        s = s + 100;
      }
      return s;
    }
  }

  public static int Jumps(int n) {
    unchecked {
      int s = 0;
      {
        int i = 0;
        for (; i < n; i = i + 1) {
          try {
            if (i == 5) {
              break;
            }
            if ((i % 2) == 0) {
              continue;
            }
            s = s + i;
          } finally {
            s = s + 100;
          }
        }
      }
      return s;
    }
  }

  public static string Ways(int k) {
    unchecked {
      var trace = "";
      {
        int i = 0;
        for (; i < 2; i = i + 1) {
          try {
            try {
              if (k == 0) {
                return string.Concat(trace, "r");
              }
              if (k == 1) {
                throw new RegionException("e");
              }
              if (k == 2) {
                break;
              }
              if (k == 3) {
                continue;
              }
              trace = string.Concat(trace, "n");
            } finally {
              trace = string.Concat(trace, "f");
            }
          } catch (RegionException e) {
            trace = string.Concat(trace, e.Message);
          }
          trace = string.Concat(trace, ".");
        }
      }
      return trace;
    }
  }

  public static string Nested() {
    _log = "";
    try {
      try {
        try {
          throw new RegionException("x");
        } finally {
          Log("A");
        }
      } finally {
        Log("B");
      }
    } catch (RegionException) when (Log("W")) {
      Log("C");
    }
    return _log;
  }

  public static string Declined(bool take) {
    _log = "";
    try {
      try {
        throw new RegionException("x");
      } finally {
        Log("F");
      }
    } catch (RegionException) when (Log("W") && take) {
      Log("C");
    } catch {
      Log("D");
    }
    return _log;
  }

  public static string Passed(int k) {
    var trace = "";
    try {
      try {
        if (k > 0) {
          throw new RegionException("p");
        }
        trace = string.Concat(trace, "n");
      } catch (global::System.InvalidOperationException) {
        trace = string.Concat(trace, "i");
      } finally {
        trace = string.Concat(trace, "f");
      }
    } catch (RegionException e) {
      trace = string.Concat(trace, e.Message);
    }
    return trace;
  }

  internal static int Check(int k) {
    if (k < 0) {
      throw new RegionException("neg");
    }
    return k;
  }

  public static string AroundCall(int k) {
    var trace = "";
    try {
      try {
        trace = string.Concat(trace, (Check(k) > 0) ? "p" : "z");
      } finally {
        trace = string.Concat(trace, "f");
      }
    } catch (RegionException e) {
      trace = string.Concat(trace, e.Message);
    }
    return trace;
  }

  public static string Replaced() {
    try {
      try {
        throw new RegionException("first");
      } finally {
        throw new RegionException("second");
      }
    } catch (RegionException e) {
      return e.Message;
    }
  }

}
