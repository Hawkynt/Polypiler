public static class DigitSum {

  public static int Sum(uint number) {
    unchecked {
      int sum = 0;
      do {
        sum = sum + (int)(number % 10u);
        number = number / 10u;
      } while (number != 0u);
      return sum;
    }
  }

  public static int Count(ulong number) {
    unchecked {
      int digits = 0;
      do {
        digits = digits + 1;
        number = number / 10UL;
      } while (number != 0UL);
      return digits;
    }
  }

  public static int Root(uint number) {
    unchecked {
      do {
        uint sum = 0;
        do {
          sum = sum + (number % 10u);
          number = number / 10u;
        } while (number != 0u);
        number = sum;
      } while (number >= 10u);
      return (int)number;
    }
  }

  public static int SumOfEven(long number) {
    unchecked {
      if (number < 0L) {
        number = -number;
      }
      int sum = 0;
      do {
        long digit = number % 10L;
        number = number / 10L;
        if ((digit & 1L) != 0L) {
          continue;
        }
        sum = sum + (int)digit;
      } while (number > 0L);
      return sum;
    }
  }

}
