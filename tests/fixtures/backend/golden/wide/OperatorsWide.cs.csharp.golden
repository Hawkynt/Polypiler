  public static double NegateDouble(double a) => -a;

  public static double AddAssignDouble(double a, double b) {
    a = a + b;
    return a;
  }

  public static double SubtractAssignDouble(double a, double b) {
    a = a - b;
    return a;
  }

  public static double MultiplyAssignDouble(double a, double b) {
    a = a * b;
    return a;
  }

  public static double DivideAssignDouble(double a, double b) {
    a = a / b;
    return a;
  }

  public static double RemainderAssignDouble(double a, double b) {
    a = a % b;
    return a;
  }

  public static double IncrementDouble(double a) {
    a = a + 1.0;
    a = a + 1.0;
    return a;
  }

  public static double DecrementDouble(double a) {
    a = a - 1.0;
    a = a - 1.0;
    return a;
  }

  public static double ChooseDouble(bool first, double a, double b) => first ? a : b;

  public static double AddCheckedDouble(double a, double b) => a + b;

  public static double SubtractCheckedDouble(double a, double b) => a - b;

  public static double MultiplyCheckedDouble(double a, double b) => a * b;

  public static double NegateCheckedDouble(double a) => -a;

  public static double AddAssignCheckedDouble(double a, double b) {
    {
      a = a + b;
    }
    return a;
  }

  public static double SubtractAssignCheckedDouble(double a, double b) {
    {
      a = a - b;
    }
    return a;
  }

  public static double MultiplyAssignCheckedDouble(double a, double b) {
    {
      a = a * b;
    }
    return a;
  }

  public static double IncrementCheckedDouble(double a) {
    {
      a = a + 1.0;
      a = a + 1.0;
    }
    return a;
  }

  public static double DecrementCheckedDouble(double a) {
    {
      a = a - 1.0;
      a = a - 1.0;
    }
    return a;
  }

  public static double UncheckedInsideCheckedDouble(double a, double b) => (a + b) - b;

  public static long AddUIntInt(uint a, int b) => unchecked((long)a + (long)b);

  public static long MultiplyIntUInt(int a, uint b) => unchecked((long)a * (long)b);

  public static bool LessUIntInt(uint a, int b) => (long)a < (long)b;

  public static long NegateUInt(uint a) => unchecked(-(long)a);

  public static long AddLongInt(long a, int b) => unchecked(a + (long)b);

  public static ulong AddULongUInt(ulong a, uint b) => unchecked(a + (ulong)b);

  public static int AddSByteByte(sbyte a, byte b) => unchecked(a + b);

  public static long ShiftLongBySByte(long a, sbyte count) => a << count;

  public static ulong MaskLong(ulong a) => a & 18374966859414961920UL;

  public static long SmallestLong() => -9223372036854775808;

  public static ulong LargestULong() => 18446744073709551615;

  public static long WidenedConstant(long a) => unchecked(a + 1L);

  public static ulong UnsignedConstant(ulong a) => unchecked((a * 1099511628211UL) + 1UL);

  public static short SmallestShort() => -32768;

  public static sbyte SmallestSByte() => -128;

  public static ushort Letter() => 65;

  public static bool IsDigit(ushort c) => (c >= 48) && (c <= 57);

  public static int DigitValue(ushort c) => unchecked(c - 48);

  public static double AddFloatDouble(float a, double b) => (double)a + b;

  public static float AddIntFloat(int a, float b) => (float)((float)a + b);

  public static double AddLongDouble(long a, double b) => (double)a + b;

  public static float MultiplyAdd(float a, float b) => (float)((float)(a * b) + a);

  public static double MultiplyAddDouble(double a, double b) => (a * b) + a;

  public static bool IsNaN(double a) {
    var b = a;
    return a != b;
  }

  public static bool NotLess(double a, double b) => !(a < b);

  public static double Third() => 0.3333333333333333;

  public static float ThirdFloat() => 0.33333334f;

  public static double NotANumber() => double.NaN;

  public static double Infinite() => double.NegativeInfinity;

  public static float InfiniteFloat() => float.PositiveInfinity;

  public static double NegativeZero() => -0.0;

  public static double Largest() => 1.7976931348623157E+308;

  public static float SmallestFloat() => 1E-45f;

  public static double Scale(double a) => (a * 1E-07) + 1E+21;

  public static float Tenth(float a) => (float)(a * 0.1f);

