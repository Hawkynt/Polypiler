public static class Fletcher16 {

  public static ushort Compute(byte[] data) {
    unchecked {
      ushort sum1 = 0;
      ushort sum2 = 0;
      {
        int i = 0;
        while (i < data.Length) {
          sum1 = (ushort)((sum1 + data[i]) % 255);
          sum2 = (ushort)((sum2 + sum1) % 255);
          i = i + 1;
        }
      }
      return (ushort)((sum2 << 8) | sum1);
    }
  }

}
