// JavaScript profile: es2015, esm.
// A 64-bit integer is an object { hi, lo }: its upper and its lower 32 bits, each as an unsigned number.

class IndexOutOfRangeError extends RangeError {
  constructor(message) {
    super(message);
    this.name = "IndexOutOfRangeError";
  }
}

function $get(array, index) {
  if (index < 0 || index >= array.length) throw new IndexOutOfRangeError("index out of range");
  return array[index];
}

// Find(sorted: Int32Array, key: number): number
export function Find(sorted, key) {
  let low = 0;
  let high = (sorted.length - 1) | 0;
  let found = -1;
  while (low <= high) {
    let middle = (low + (((high - low) | 0) >> 1)) | 0;
    if ($get(sorted, middle) < key) {
      low = (middle + 1) | 0;
      continue;
    }
    if ($get(sorted, middle) > key) {
      high = (middle - 1) | 0;
      continue;
    }
    found = middle;
    break;
  }
  return found;
}

// LowerBound(sorted: Array<{ hi, lo }>, key: { hi, lo }): number
export function LowerBound(sorted, key) {
  let low = 0;
  let high = sorted.length;
  {
    while (true) {
      if (low >= high) {
        break;
      }
      let middle = ((((low >>> 0) + (high >>> 0)) >>> 0) >>> 1) | 0;
      if (CompareSigned64($get(sorted, middle), key) < 0) {
        low = (middle + 1) | 0;
      } else {
        high = middle;
      }
    }
  }
  return low;
}

// FindDouble(sorted: Float64Array, key: number): number
export function FindDouble(sorted, key) {
  let low = 0;
  let high = (sorted.length - 1) | 0;
  while (low <= high) {
    let middle = (((low + high) | 0) >>> 1) | 0;
    if ($get(sorted, middle) === key) {
      return middle;
    }
    if ($get(sorted, middle) < key) {
      low = (middle + 1) | 0;
    } else {
      high = (middle - 1) | 0;
    }
  }
  return ~low;
}

// CompareSigned64(left: { hi, lo }, right: { hi, lo }): number
function CompareSigned64(left, right) {
  let leftHigh = left.hi | 0;
  let rightHigh = right.hi | 0;
  if (leftHigh !== rightHigh) {
    return (leftHigh < rightHigh) ? (-1) : 1;
  }
  return CompareLow(left.lo, right.lo);
}

// CompareLow(left: number, right: number): number
function CompareLow(left, right) {
  return (left === right) ? 0 : ((left < right) ? (-1) : 1);
}
