        if ($get(sorted, middle) < key) {
          low = (middle + 1) | 0;
        } else {
          high = middle;
        }
      }
    }
    return low;
  }

  // FindDouble(sorted: Float64Array, key: number): number
  function FindDouble(sorted, key) {
    let low = 0;
    let high = (sorted.length - 1) | 0;
    while (low <= high) {
      let middle = (((low + high) | 0) >>> 1) | 0;
      if ($get(sorted, middle) === key) {
        return middle;
      }
      if ($get(sorted, middle) < key) {
        low = (middle + 1) | 0;
      } else {
        high = (middle - 1) | 0;
      }
    }
    return ~low;
  }

  return {
    Find: Find,
    LowerBound: LowerBound,
    FindDouble: FindDouble
  };
})();
