// FillLarge(data: Array<{ hi, lo }>, value: { hi, lo }): void
export function FillLarge(data, value) {
  data.fill(value);
}

// FillWithConstant(data: Uint8Array): void
export function FillWithConstant(data) {
  data.fill(4);
}

// FillFloats(data: Float32Array, value: number): void
export function FillFloats(data, value) {
  data.fill(Math.fround(value));
}

// Clear(data: Float32Array): void
export function Clear(data) {
  data.fill(0);
}

// ClearLongs(data: Array<{ hi, lo }>): void
export function ClearLongs(data) {
  data.fill({ hi: 0, lo: 0 });
