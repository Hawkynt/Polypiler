// NothingLength(): number
export function NothingLength() {
  return Nothing.length;
}

// ReadNothing(index: number): number
export function ReadNothing(index) {
  return $get(Nothing, index);
}

// ReadOne(index: number): number
export function ReadOne(index) {
  return $get(One, index);
}

// Square(index: number): number
export function Square(index) {
  return $get(Squares, index);
}

// Power(index: number): { hi, lo }
export function Power(index) {
  return $get(Powers, index);
}

// ReadLarge(index: number): { hi, lo }
export function ReadLarge(index) {
  return $get(Large, index);
}

// ReadSigned(index: number): number
export function ReadSigned(index) {
  return $get(Signed, index);
}

// ReadShort(index: number): number
export function ReadShort(index) {
  return $get(Shorts, index);
}

// ReadLetter(index: number): number
export function ReadLetter(index) {
  return $get(Letters, index);
}

// Weight(index: number): number
export function Weight(index) {
  return $get(Weights, index);
}

// Root(index: number): number
export function Root(index) {
  return $get(Roots, index);
}

// Sign(index: number): number
export function Sign(index) {
  return $get(Signs, index);
}

// RampAt(index: number): number
export function RampAt(index) {
  return $get(Ramp, index);
}

// RampLength(): number
export function RampLength() {
  return (((Ramp.length + Squares.length) | 0) + Powers.length) | 0;
}

// SumOfSquares(): number
export function SumOfSquares() {
  let sum = 0;
  {
    let $t1 = 0;
    while ($t1 < Squares.length) {
      let square = $get(Squares, $t1);
      sum = (sum + square) | 0;
      $t1 = ($t1 + 1) | 0;
    }
  }
  return sum;
}

// SumOfWeights(): number
export function SumOfWeights() {
  let sum = 0;
  {
    let $t1 = 0;
    for (; $t1 < Weights.length; $t1 = ($t1 + 1) | 0) {
      let weight = $get(Weights, $t1);
      if (weight > 1) {
        continue;
      }
      sum = sum + weight;
    }
  }
  return sum;
}

// RampChecksum(): number
export function RampChecksum() {
  let sum = 0;
  {
    let i = 0;
    while (i < Ramp.length) {
      sum = (((((sum << 1) >>> 0) | (sum >>> 31)) >>> 0) ^ $get(Ramp, i)) >>> 0;
      i = (i + 1) | 0;
    }
  }
  return sum;
}

// Scaled(a: number): number
export function Scaled(a) {
  return Enabled ? (((((a + Offset) | 0) * Half) + 1099511627776) + 0.1) : 4;
}

// Masked(a: number): number
export function Masked(a) {
  return (((a & 255) >>> 0) & 255) >>> 0;
}

// Complement(a: { hi, lo }): { hi, lo }
export function Complement(a) {
  return $sub64(Largest, a);
}

// ThirdOf(a: number): number
export function ThirdOf(a) {
  return Math.fround(a * Third);
}

// LetterDistance(c: number): number
export function LetterDistance(c) {
  return (((c - Letter) | 0) + Digit) | 0;
}

// Triple(a: number, b: number): Int32Array
export function Triple(a, b) {
  return new Int32Array([a, b, (a + b) | 0]);
}

// Pair(a: { hi, lo }): Array<{ hi, lo }>
export function Pair(a) {
  return [a, $neg64(a)];
}

// Bytes(a: number): Uint8Array
export function Bytes(a) {
  return new Uint8Array([a, 1, 2]);
}

// Doubled(a: number): Float64Array
export function Doubled(a) {
  let values = new Float64Array([a, a * 2]);
  return values;
}

// NoElements(): Array<{ hi, lo }>
export function NoElements() {
  return [];
}

// NoFloats(): Float32Array
export function NoFloats() {
  return new Float32Array([]);
}

// LengthOfLiteral(a: number): number
export function LengthOfLiteral(a) {
  return (new Int16Array([a, a]).length + $get(new Uint16Array([120]), 0)) | 0;
}

// CopyOfSquares(): Uint16Array
export function CopyOfSquares() {
  let copy = new Uint16Array($len(Squares.length));
  $copy(Squares, 0, copy, 0, Squares.length);
  return copy;
}

// RampSlice(from: number, length: number): Uint32Array
export function RampSlice(from, length) {
  let slice = new Uint32Array($len(length));
  $copy(Ramp, from, slice, 0, length);
  return slice;
}

// Copy(source: Int32Array, sourceIndex: number, target: Int32Array, targetIndex: number, length: number): void
export function Copy(source, sourceIndex, target, targetIndex, length) {
  $copy(source, sourceIndex, target, targetIndex, length);
}

// Move(data: Array<{ hi, lo }>, from: number, to: number, length: number): void
export function Move(data, from, to, length) {
  $copya(data, from, data, to, length);
}

// CopyDoubles(source: Float64Array, target: Float64Array): void
export function CopyDoubles(source, target) {
  $copy(source, 0, target, 1, source.length);
}

// Fill(data: Int16Array, value: number): void
export function Fill(data, value) {
  data.fill(value);
}

// FillLarge(data: Array<{ hi, lo }>, value: { hi, lo }): void
export function FillLarge(data, value) {
  data.fill(value);
}

// FillWithConstant(data: Uint8Array): void
export function FillWithConstant(data) {
  data.fill(4);
}

// FillFloats(data: Float32Array, value: number): void
export function FillFloats(data, value) {
  data.fill(Math.fround(value));
}

// Clear(data: Float32Array): void
export function Clear(data) {
  data.fill(0);
}

// ClearLongs(data: Array<{ hi, lo }>): void
export function ClearLongs(data) {
  data.fill({ hi: 0, lo: 0 });
}

// ClearChars(data: Uint16Array): void
export function ClearChars(data) {
  data.fill(0);
}
