    $copy(source, sourceIndex, target, targetIndex, length);
  }

  // Move(data: BigInt64Array, from: number, to: number, length: number): void
  function Move(data, from, to, length) {
    $copy(data, from, data, to, length);
  }

  // CopyDoubles(source: Float64Array, target: Float64Array): void
  function CopyDoubles(source, target) {
    $copy(source, 0, target, 1, source.length);
  }

  // Fill(data: Int16Array, value: number): void
  function Fill(data, value) {
    data.fill(value);
  }

  // FillLarge(data: BigUint64Array, value: bigint): void
  function FillLarge(data, value) {
    data.fill(value);
  }

  // FillWithConstant(data: Uint8Array): void
  function FillWithConstant(data) {
    data.fill(4);
  }

  // FillFloats(data: Float32Array, value: number): void
  function FillFloats(data, value) {
    data.fill(Math.fround(value));
  }

  // Clear(data: Float32Array): void
  function Clear(data) {
    data.fill(0);
  }

  // ClearLongs(data: BigInt64Array): void
  function ClearLongs(data) {
    data.fill(0n);
  }

  // ClearChars(data: Uint16Array): void
  function ClearChars(data) {
    data.fill(0);
  }

  return {
    NothingLength: NothingLength,
    ReadNothing: ReadNothing,
    ReadOne: ReadOne,
    Square: Square,
    Power: Power,
    ReadLarge: ReadLarge,
    ReadSigned: ReadSigned,
    ReadShort: ReadShort,
    ReadLetter: ReadLetter,
    Weight: Weight,
    Root: Root,
    Sign: Sign,
    RampAt: RampAt,
    RampLength: RampLength,
    SumOfSquares: SumOfSquares,
    SumOfWeights: SumOfWeights,
    RampChecksum: RampChecksum,
    Scaled: Scaled,
    Masked: Masked,
    Complement: Complement,
    ThirdOf: ThirdOf,
    LetterDistance: LetterDistance,
    Triple: Triple,
    Pair: Pair,
    Bytes: Bytes,
    Doubled: Doubled,
    NoElements: NoElements,
    NoFloats: NoFloats,
    LengthOfLiteral: LengthOfLiteral,
    CopyOfSquares: CopyOfSquares,
    RampSlice: RampSlice,
    Copy: Copy,
    Move: Move,
    CopyDoubles: CopyDoubles,
    Fill: Fill,
    FillLarge: FillLarge,
    FillWithConstant: FillWithConstant,
    FillFloats: FillFloats,
    Clear: Clear,
    ClearLongs: ClearLongs,
    ClearChars: ClearChars
  };
})();
