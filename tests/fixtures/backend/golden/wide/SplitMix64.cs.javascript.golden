  return { hi: value.hi >>> count, lo: ((value.lo >>> count) | (value.hi << (32 - count))) >>> 0 };
}

function $mulw(a, b) {
  const u = [a.lo & 0xFFFF, a.lo >>> 16, a.hi & 0xFFFF, a.hi >>> 16];
