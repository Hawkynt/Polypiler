// First(seed: bigint): bigint
function First(seed) {
  return Mix(BigInt.asUintN(64, seed + 11400714819323198485n));
}

// Nth(seed: bigint, n: number): bigint
function Nth(seed, n) {
  let state = seed;
  let output = 0n;
  {
    let i = 0;
    while (i < n) {
      state = BigInt.asUintN(64, state + 11400714819323198485n);
      output = Mix(state);
      i = (i + 1) | 0;
    }
  }
  return output;
}

// Mix(z: bigint): bigint
function Mix(z) {
  z = BigInt.asUintN(64, (z ^ (z >> 30n)) * 13787848793156543929n);
  z = BigInt.asUintN(64, (z ^ (z >> 27n)) * 10723151780598845931n);
  return z ^ (z >> 31n);
}

exports.First = First;
exports.Nth = Nth;
