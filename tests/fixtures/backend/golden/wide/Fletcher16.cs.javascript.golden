"use strict";

class ArithmeticError extends RangeError {
  constructor(message) {
    super(message);
    this.name = "ArithmeticError";
  }
}

class DivideByZeroError extends ArithmeticError {
  constructor(message) {
    super(message);
    this.name = "DivideByZeroError";
  }
}

class OverflowError extends ArithmeticError {
  constructor(message) {
    super(message);
    this.name = "OverflowError";
  }
}

class IndexOutOfRangeError extends RangeError {
  constructor(message) {
    super(message);
    this.name = "IndexOutOfRangeError";
  }
}

function $rem(a, b) {
  if (b === 0) throw new DivideByZeroError("divide by zero");
  if (a === -2147483648 && b === -1) throw new OverflowError("integer overflow");
  return (a % b) | 0;
}

function $get(array, index) {
  if (index < 0 || index >= array.length) throw new IndexOutOfRangeError("index out of range");
  return array[index];
}

// Compute(data: Uint8Array): number
function Compute(data) {
  let sum1 = 0;
  let sum2 = 0;
  {
    let i = 0;
    while (i < data.length) {
      sum1 = $rem((sum1 + $get(data, i)) | 0, 255) & 0xFFFF;
      sum2 = $rem((sum2 + sum1) | 0, 255) & 0xFFFF;
      i = (i + 1) | 0;
    }
  }
  return ((sum2 << 8) | sum1) & 0xFFFF;
}

exports.Compute = Compute;
