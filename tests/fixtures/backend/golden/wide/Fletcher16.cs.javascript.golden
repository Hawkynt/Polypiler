// Fletcher16: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

function $rem(a, b) {
  if (b === 0) throw new RangeError("divide by zero");
  if (a === -2147483648 && b === -1) throw new RangeError("integer overflow");
  return (a % b) | 0;
}

function $get(array, index) {
  if (index < 0 || index >= array.length) throw new RangeError("index out of range");
  return array[index];
}

// Compute(data: Array<number>): number
function Compute(data) {
  var sum1 = 0;
  var sum2 = 0;
  {
    var i = 0;
    while (i < data.length) {
      sum1 = $rem((sum1 + $get(data, i)) | 0, 255) & 0xFFFF;
      sum2 = $rem((sum2 + sum1) | 0, 255) & 0xFFFF;
      i = (i + 1) | 0;
    }
  }
  return ((sum2 << 8) | sum1) & 0xFFFF;
}

exports.Compute = Compute;
