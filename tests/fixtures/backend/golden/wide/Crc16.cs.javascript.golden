  return array[index];
}

// Compute(data: Array<number>): number
function Compute(data) {
  var crc = 65535;
  {
    var i = 0;
    while (i < data.length) {
      crc = (crc ^ (($get(data, i) << 8) & 0xFFFF)) & 0xFFFF;
