// Xorshift64: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public static class Xorshift64 {

  public static ulong Next(ulong x) {
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    return x;
  }

  public static ulong NextStar(ulong x) {
    unchecked {
      x = x ^ (x >> 12);
      x = x ^ (x << 25);
      x = x ^ (x >> 27);
      return x * 2685821657736338717UL;
    }
  }

  public static long NextSigned(long x) {
    unchecked {
      x = x ^ (x << 13);
      x = x ^ (long)((ulong)x >> 7);
      x = x ^ (x << 17);
      return x;
    }
  }

  public static ulong Skip(ulong x, int count) {
    unchecked {
      {
        int i = 0;
        while (i < count) {
          x = Next(x);
          i = i + 1;
        }
      }
      return x;
    }
  }

}
