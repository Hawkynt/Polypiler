"use strict";

function $get(array, index) {
  if (index < 0 || index >= array.length) throw new RangeError("index out of range");
  return array[index];
}

function $set(array, index, value) {
  if (index < 0 || index >= array.length) throw new RangeError("index out of range");
  array[index] = value;
}

// Decode(input: Array<number>, output: Array<number>): number
function Decode(input, output) {
  var $p;
  var state = 0;
  var count = 0;
  var written = 0;
  {
    var i = 0;
    while (i < input.length) {
      var value = $get(input, i);
      switch (state) {
        case 0: {
          if (value === 255) {
            state = 3;
          } else if (value < 128) {
            state = 1;
            count = (value + 1) | 0;
          } else {
            state = 2;
            count = (value - 125) | 0;
          }
          break;
        }
        case 1: {
          $set(output, ($p = written, written = ($p + 1) | 0, $p), value);
          if ((count = (count - 1) | 0) === 0) {
            state = 0;
          }
          break;
        }
        case 2: {
          while (count > 0) {
            $set(output, ($p = written, written = ($p + 1) | 0, $p), value);
            count = (count - 1) | 0;
          }
          state = 0;
          break;
        }
        default: {
          return written;
        }
      }
      i = (i + 1) | 0;
    }
  }
  return written;
}

// DecodedLength(input: Array<number>): number
function DecodedLength(input) {
  var $p;
  var length = 0;
  var i = 0;
  while (i < input.length) {
    var control = $get(input, ($p = i, i = ($p + 1) | 0, $p));
    switch (control >> 7) {
      case 0: {
        length = (length + ((control + 1) | 0)) | 0;
        i = (i + ((control + 1) | 0)) | 0;
        continue;
      }
      case 1: {
        if (control === 255) {
          return length;
        }
        length = (length + ((control - 125) | 0)) | 0;
        i = (i + 1) | 0;
        break;
      }
    }
  }
  return length;
}

exports.Decode = Decode;
exports.DecodedLength = DecodedLength;
