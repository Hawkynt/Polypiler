  constructor(message) {
    super(message);
    this.name = "IndexOutOfRangeError";
  }
}

function $xor64(a, b) {
  return { hi: (a.hi ^ b.hi) >>> 0, lo: (a.lo ^ b.lo) >>> 0 };
}

function $mulw(a, b) {
  const u = [a.lo & 0xFFFF, a.lo >>> 16, a.hi & 0xFFFF, a.hi >>> 16];
  const v = [b.lo & 0xFFFF, b.lo >>> 16, b.hi & 0xFFFF, b.hi >>> 16];
  const w = [0, 0, 0, 0, 0, 0, 0, 0];
  for (let j = 0; j < 4; ++j) {
    let carry = 0;
    for (let i = 0; i < 4; ++i) {
      const t = u[i] * v[j] + w[i + j] + carry;
      w[i + j] = t & 0xFFFF;
      carry = t >>> 16;
    }
    w[j + 4] = carry;
  }
  return w;
}

function $mul64(a, b) {
  const w = $mulw(a, b);
  return { hi: ((w[3] << 16) | w[2]) >>> 0, lo: ((w[1] << 16) | w[0]) >>> 0 };
}

function $get(array, index) {
  if (index < 0 || index >= array.length) throw new IndexOutOfRangeError("index out of range");
  return array[index];
}

// Hash(data: Uint8Array): { hi, lo }
function Hash(data) {
  let hash = { hi: 3421674724, lo: 2216829733 };
  {
    let i = 0;
    while (i < data.length) {
      hash = $xor64(hash, { hi: 0, lo: $get(data, i) });
      hash = $mul64(hash, { hi: 256, lo: 435 });
      i = (i + 1) | 0;
    }
  }
  return hash;
}

exports.Hash = Hash;
