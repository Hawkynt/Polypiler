    }
    if (value <= 268435455) {
      count = (count + 4) | 0;
      value = (value << 4) >>> 0;
    }
    if (value <= 1073741823) {
      count = (count + 2) | 0;
      value = (value << 2) >>> 0;
    }
    return (value <= 2147483647) ? ((count + 1) | 0) : count;
  }

  return {
    AbsSByte: AbsSByte,
    AbsShort: AbsShort,
    AbsInt: AbsInt,
    AbsLong: AbsLong,
    AbsFloat: AbsFloat,
    AbsDouble: AbsDouble,
    AbsSingle: AbsSingle,
    AbsOfUInt: AbsOfUInt,
    MinSByte: MinSByte,
