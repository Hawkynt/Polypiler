    MaxUShort: MaxUShort,
    MaxInt: MaxInt,
    MaxUInt: MaxUInt,
    MaxLong: MaxLong,
    MaxULong: MaxULong,
    MaxFloat: MaxFloat,
    MaxDouble: MaxDouble,
    MaxSingle: MaxSingle,
    MaxFloatDouble: MaxFloatDouble,
    SignSByte: SignSByte,
    SignShort: SignShort,
    SignInt: SignInt,
    SignLong: SignLong,
    SignFloat: SignFloat,
    SignDouble: SignDouble,
    SignSingle: SignSingle,
    SignOfUInt: SignOfUInt,
    SqrtDouble: SqrtDouble,
    SqrtSingle: SqrtSingle,
    SqrtOfFloat: SqrtOfFloat,
    FloorDouble: FloorDouble,
    FloorSingle: FloorSingle,
    CeilingDouble: CeilingDouble,
    CeilingSingle: CeilingSingle,
    TruncateDouble: TruncateDouble,
    TruncateSingle: TruncateSingle,
    RoundDouble: RoundDouble,
    RoundSingle: RoundSingle,
    RoundToEvenDouble: RoundToEvenDouble,
    RoundAwayDouble: RoundAwayDouble,
    RoundAwaySingle: RoundAwaySingle,
    RoundToInt: RoundToInt,
    RotateLeftUInt: RotateLeftUInt,
    RotateRightUInt: RotateRightUInt,
    RotateLeftULong: RotateLeftULong,
    RotateRightULong: RotateRightULong,
    PopCountUInt: PopCountUInt,
    PopCountULong: PopCountULong,
    LeadingZeroCountUInt: LeadingZeroCountUInt,
    LeadingZeroCountULong: LeadingZeroCountULong,
    TrailingZeroCountUInt: TrailingZeroCountUInt,
    TrailingZeroCountULong: TrailingZeroCountULong,
    Log2UInt: Log2UInt,
    Log2ULong: Log2ULong,
    BigMul: BigMul,
    DoubleBits: DoubleBits,
