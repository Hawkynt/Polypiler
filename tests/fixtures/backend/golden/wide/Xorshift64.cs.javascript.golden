// Next(x: bigint): bigint
export function Next(x) {
  x = x ^ BigInt.asUintN(64, x << 13n);
  x = x ^ (x >> 7n);
  x = x ^ BigInt.asUintN(64, x << 17n);
  return x;
}

// NextStar(x: bigint): bigint
export function NextStar(x) {
  x = x ^ (x >> 12n);
  x = x ^ BigInt.asUintN(64, x << 25n);
  x = x ^ (x >> 27n);
  return BigInt.asUintN(64, x * 2685821657736338717n);
}

// NextSigned(x: bigint): bigint
export function NextSigned(x) {
  x = x ^ BigInt.asIntN(64, x << 13n);
  x = x ^ BigInt.asIntN(64, BigInt.asUintN(64, x) >> 7n);
  x = x ^ BigInt.asIntN(64, x << 17n);
  return x;
}

// Skip(x: bigint, count: number): bigint
export function Skip(x, count) {
  {
    let i = 0;
    while (i < count) {
      x = Next(x);
      i = (i + 1) | 0;
    }
  }
  return x;
}
