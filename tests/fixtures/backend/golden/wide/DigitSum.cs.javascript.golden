"use strict";

function $udiv(a, b) {
  if (b === 0) throw new RangeError("divide by zero");
  return (a / b) >>> 0;
}

function $urem(a, b) {
  if (b === 0) throw new RangeError("divide by zero");
  return a % b;
}

function $div64(a, b) {
  if (b === 0n) throw new RangeError("divide by zero");
  if (a === -9223372036854775808n && b === -1n) throw new RangeError("integer overflow");
  return a / b;
}

function $rem64(a, b) {
  if (b === 0n) throw new RangeError("divide by zero");
  if (a === -9223372036854775808n && b === -1n) throw new RangeError("integer overflow");
  return a % b;
}

function $udiv64(a, b) {
  if (b === 0n) throw new RangeError("divide by zero");
  return a / b;
}

// Sum(number: number): number
function Sum(number) {
  let sum = 0;
  do {
    sum = (sum + ($urem(number, 10) | 0)) | 0;
    number = $udiv(number, 10);
  } while (number !== 0);
  return sum;
}

// Count(number: bigint): number
function Count(number) {
  let digits = 0;
  do {
    digits = (digits + 1) | 0;
    number = $udiv64(number, 10n);
  } while (number !== 0n);
  return digits;
}

// Root(number: number): number
function Root(number) {
  do {
    let sum = 0;
    do {
      sum = (sum + $urem(number, 10)) >>> 0;
      number = $udiv(number, 10);
    } while (number !== 0);
    number = sum;
  } while (number >= 10);
  return number | 0;
}

// SumOfEven(number: bigint): number
function SumOfEven(number) {
  if (number < 0n) {
    number = BigInt.asIntN(64, -number);
  }
  let sum = 0;
  do {
    let digit = $rem64(number, 10n);
    number = $div64(number, 10n);
    if ((digit & 1n) !== 0n) {
      continue;
    }
    sum = (sum + Number(BigInt.asIntN(32, digit))) | 0;
  } while (number > 0n);
  return sum;
}

exports.Sum = Sum;
exports.Count = Count;
exports.Root = Root;
exports.SumOfEven = SumOfEven;
