  const whole = Math.trunc(value);
  if (!(whole >= low && whole <= high)) throw new RangeError("integer overflow");
  return whole + 0;
}

function $f2lc(value, low, limit) {
  const whole = Math.trunc(value);
  if (!(whole >= low && whole < limit)) throw new RangeError("integer overflow");
  return BigInt(whole);
