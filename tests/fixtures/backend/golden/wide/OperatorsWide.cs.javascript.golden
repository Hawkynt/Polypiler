}

// Checked32(value: number, low: number, high: number): number
function Checked32(value, low, high) {
  if ((value < low) || (value > high)) {
    throw new OverflowError("integer overflow");
  }
  return value | 0;
}

// CheckedUnsigned32(value: number, high: number): number
function CheckedUnsigned32(value, high) {
  if ((value < 0) || (value > high)) {
    throw new OverflowError("integer overflow");
  }
  return value >>> 0;
}

// MulHighUnsigned32(left: number, right: number): number
function MulHighUnsigned32(left, right) {
  var leftLow = (left & 65535) >>> 0;
  var leftHigh = left >>> 16;
  var rightLow = (right & 65535) >>> 0;
  var rightHigh = right >>> 16;
  var middle = (($imul(leftHigh, rightLow) >>> 0) + (($imul(leftLow, rightLow) >>> 0) >>> 16)) >>> 0;
  var cross = (($imul(leftLow, rightHigh) >>> 0) + ((middle & 65535) >>> 0)) >>> 0;
  return (((($imul(leftHigh, rightHigh) >>> 0) + (middle >>> 16)) >>> 0) + (cross >>> 16)) >>> 0;
}

// Magnitude64(value: { hi, lo }): { hi, lo }
function Magnitude64(value) {
  return IsNegative64(value) ? Negate64(value) : value;
}

// DivideWords(dividend: { hi, lo }, divisor: { hi, lo }, remainder: boolean): { hi, lo }
function DivideWords(dividend, divisor, remainder) {
  var divisorHigh = divisor.hi;
  var divisorLow = divisor.lo;
  if ((divisorHigh === 0) && (divisorLow === 0)) {
    throw new DivideByZeroError("divide by zero");
  }
  var high = dividend.hi;
  var low = dividend.lo;
  if ((divisorHigh === 0) && (high === 0)) {
    return { hi: 0, lo: remainder ? RemainderUnsigned32(low, divisorLow) : DivideUnsigned32(low, divisorLow) };
  }
  var quotientHigh = 0;
  var quotientLow = 0;
  var restHigh = 0;
  var restLow = 0;
  {
    var bit = 63;
    while (bit >= 0) {
      restHigh = (((restHigh << 1) >>> 0) | (restLow >>> 31)) >>> 0;
      restLow = (((restLow << 1) >>> 0) | ((((bit >= 32) ? (high >>> ((bit - 32) | 0)) : (low >>> bit)) & 1) >>> 0)) >>> 0;
      if ((restHigh > divisorHigh) || ((restHigh === divisorHigh) && (restLow >= divisorLow))) {
        restHigh = (((restHigh - divisorHigh) >>> 0) - ((restLow < divisorLow) ? 1 : 0)) >>> 0;
        restLow = (restLow - divisorLow) >>> 0;
        if (bit >= 32) {
          quotientHigh = (quotientHigh | ((1 << ((bit - 32) | 0)) >>> 0)) >>> 0;
        } else {
          quotientLow = (quotientLow | ((1 << bit) >>> 0)) >>> 0;
        }
      }
      bit = (bit - 1) | 0;
    }
  }
  return remainder ? { hi: restHigh, lo: restLow } : { hi: quotientHigh, lo: quotientLow };
}

// CheckQuotient64(dividend: { hi, lo }, divisor: { hi, lo }): void
function CheckQuotient64(dividend, divisor) {
  if ((((divisor.hi === 4294967295) && (divisor.lo === 4294967295)) && (dividend.hi === 2147483648)) && (dividend.lo === 0)) {
    throw new OverflowError("integer overflow");
  }
}

// IsNegative64(value: { hi, lo }): boolean
function IsNegative64(value) {
  return (value.hi | 0) < 0;
}

// CompareLow(left: number, right: number): number
function CompareLow(left, right) {
  return (left === right) ? 0 : ((left < right) ? (-1) : 1);
}

// MulHighUnsigned64(left: { hi, lo }, right: { hi, lo }): { hi, lo }
function MulHighUnsigned64(left, right) {
  var leftLow = And64(left, { hi: 0, lo: 4294967295 });
  var leftHigh = ShiftRightLogical64(left, 32);
  var rightLow = And64(right, { hi: 0, lo: 4294967295 });
