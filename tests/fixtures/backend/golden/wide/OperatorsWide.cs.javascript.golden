  }
  return a;
}

// ShiftLeftAssignCheckedUInt(a: number, count: number): number
export function ShiftLeftAssignCheckedUInt(a, count) {
  {
    a = (a << count) >>> 0;
  }
  return a;
}

// IncrementCheckedUInt(a: number): number
export function IncrementCheckedUInt(a) {
  {
    a = $ck(a + 1, 0, 4294967295);
    a = $ck(a + 1, 0, 4294967295);
  }
  return a;
}

// DecrementCheckedUInt(a: number): number
export function DecrementCheckedUInt(a) {
  {
    a = $ck(a - 1, 0, 4294967295);
    a = $ck(a - 1, 0, 4294967295);
  }
  return a;
}

// UncheckedInsideCheckedUInt(a: number, b: number): number
export function UncheckedInsideCheckedUInt(a, b) {
  return $ck(((a + b) >>> 0) - b, 0, 4294967295);
}

