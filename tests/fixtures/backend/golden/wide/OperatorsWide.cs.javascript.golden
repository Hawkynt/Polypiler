// ShiftLeftAssignLong(a: bigint, count: number): bigint
export function ShiftLeftAssignLong(a, count) {
  a = BigInt.asIntN(64, a << BigInt(count & 63));
  return a;
}

// ShiftRightAssignLong(a: bigint, count: number): bigint
