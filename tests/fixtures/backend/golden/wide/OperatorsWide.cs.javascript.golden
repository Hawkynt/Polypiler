  return $add64({ hi: 0, lo: a }, $sx64(b));
}

// MultiplyIntUInt(a: number, b: number): { hi, lo }
export function MultiplyIntUInt(a, b) {
  return $mul64($sx64(a), { hi: 0, lo: b });
}

// LessUIntInt(a: number, b: number): boolean
export function LessUIntInt(a, b) {
  return $scmp64({ hi: 0, lo: a }, $sx64(b)) < 0;
}

// NegateUInt(a: number): { hi, lo }
export function NegateUInt(a) {
  return $neg64({ hi: 0, lo: a });
}

// AddLongInt(a: { hi, lo }, b: number): { hi, lo }
export function AddLongInt(a, b) {
  return $add64(a, $sx64(b));
}

// AddULongUInt(a: { hi, lo }, b: number): { hi, lo }
export function AddULongUInt(a, b) {
  return $add64(a, { hi: 0, lo: b });
}

// AddSByteByte(a: number, b: number): number
export function AddSByteByte(a, b) {
  return (a + b) | 0;
}

// ShiftLongBySByte(a: { hi, lo }, count: number): { hi, lo }
export function ShiftLongBySByte(a, count) {
  return $shl64(a, count);
}

// MaskLong(a: { hi, lo }): { hi, lo }
export function MaskLong(a) {
  return $and64(a, { hi: 4278255360, lo: 4278255360 });
}

// SmallestLong(): { hi, lo }
export function SmallestLong() {
  return { hi: 2147483648, lo: 0 };
}

// LargestULong(): { hi, lo }
export function LargestULong() {
  return { hi: 4294967295, lo: 4294967295 };
}

// WidenedConstant(a: { hi, lo }): { hi, lo }
export function WidenedConstant(a) {
  return $add64(a, { hi: 0, lo: 1 });
}

// UnsignedConstant(a: { hi, lo }): { hi, lo }
export function UnsignedConstant(a) {
  return $add64($mul64(a, { hi: 256, lo: 435 }), { hi: 0, lo: 1 });
}

// SmallestShort(): number
export function SmallestShort() {
  return -32768;
}

// SmallestSByte(): number
export function SmallestSByte() {
  return -128;
}

// Letter(): number
export function Letter() {
  return 65;
}

// IsDigit(c: number): boolean
export function IsDigit(c) {
  return (c >= 48) && (c <= 57);
}

// DigitValue(c: number): number
export function DigitValue(c) {
  return (c - 48) | 0;
}

// AddFloatDouble(a: number, b: number): number
export function AddFloatDouble(a, b) {
  return a + b;
}

// AddIntFloat(a: number, b: number): number
export function AddIntFloat(a, b) {
  return Math.fround(Math.fround(a) + b);
}

// AddLongDouble(a: { hi, lo }, b: number): number
export function AddLongDouble(a, b) {
  return $l2d(a) + b;
}

// MultiplyAdd(a: number, b: number): number
export function MultiplyAdd(a, b) {
  return Math.fround(Math.fround(a * b) + a);
}

// MultiplyAddDouble(a: number, b: number): number
export function MultiplyAddDouble(a, b) {
  return (a * b) + a;
}

// IsNaN(a: number): boolean
export function IsNaN(a) {
  let b = a;
  return a !== b;
}

// NotLess(a: number, b: number): boolean
export function NotLess(a, b) {
  return !(a < b);
}

// Third(): number
export function Third() {
  return 0.3333333333333333;
}

// ThirdFloat(): number
export function ThirdFloat() {
  return 0.3333333432674408;
}

// NotANumber(): number
export function NotANumber() {
  return NaN;
}

// Infinite(): number
export function Infinite() {
  return -Infinity;
}

// InfiniteFloat(): number
export function InfiniteFloat() {
  return Infinity;
}

// NegativeZero(): number
export function NegativeZero() {
  return -0;
}

// Largest(): number
export function Largest() {
  return 1.7976931348623157E+308;
}

// SmallestFloat(): number
export function SmallestFloat() {
  return 1.401298464324817E-45;
}

// Scale(a: number): number
export function Scale(a) {
  return (a * 1E-07) + 1E+21;
}

// Tenth(a: number): number
export function Tenth(a) {
  return Math.fround(a * 0.10000000149011612);
}
