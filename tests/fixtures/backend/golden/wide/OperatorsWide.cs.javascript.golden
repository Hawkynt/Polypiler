// OperatorsWide: generated by polypiler. Change the source, not this file.
// JavaScript profile: es2022, esm.

class ArithmeticError extends RangeError {
  constructor(message) {
    super(message);
    this.name = "ArithmeticError";
  }
}

class DivideByZeroError extends ArithmeticError {
  constructor(message) {
    super(message);
    this.name = "DivideByZeroError";
  }
}

class OverflowError extends ArithmeticError {
  constructor(message) {
    super(message);
    this.name = "OverflowError";
  }
}

function $div64(a, b) {
  if (b === 0n) throw new DivideByZeroError("divide by zero");
  if (a === -9223372036854775808n && b === -1n) throw new OverflowError("integer overflow");
  return a / b;
}

function $rem64(a, b) {
  if (b === 0n) throw new DivideByZeroError("divide by zero");
  if (a === -9223372036854775808n && b === -1n) throw new OverflowError("integer overflow");
  return a % b;
}

function $udiv64(a, b) {
  if (b === 0n) throw new DivideByZeroError("divide by zero");
  return a / b;
}

function $urem64(a, b) {
  if (b === 0n) throw new DivideByZeroError("divide by zero");
  return a % b;
}

// AddSByte(a: number, b: number): number
export function AddSByte(a, b) {
  return (a + b) | 0;
}

// SubtractSByte(a: number, b: number): number
export function SubtractSByte(a, b) {
  return (a - b) | 0;
}

// MultiplySByte(a: number, b: number): number
export function MultiplySByte(a, b) {
  return Math.imul(a, b);
}

// DivideSByte(a: number, b: number): number
export function DivideSByte(a, b) {
  return Divide32(a, b, -2147483648);
}

// RemainderSByte(a: number, b: number): number
export function RemainderSByte(a, b) {
  return Remainder32(a, b, -2147483648);
}

// AndSByte(a: number, b: number): number
export function AndSByte(a, b) {
  return a & b;
}

// OrSByte(a: number, b: number): number
export function OrSByte(a, b) {
  return a | b;
}

// XorSByte(a: number, b: number): number
export function XorSByte(a, b) {
  return a ^ b;
}

// EqualSByte(a: number, b: number): boolean
export function EqualSByte(a, b) {
  return a === b;
}

// NotEqualSByte(a: number, b: number): boolean
export function NotEqualSByte(a, b) {
  return a !== b;
}

// LessSByte(a: number, b: number): boolean
export function LessSByte(a, b) {
  return a < b;
}

// LessOrEqualSByte(a: number, b: number): boolean
export function LessOrEqualSByte(a, b) {
  return a <= b;
}

// GreaterSByte(a: number, b: number): boolean
export function GreaterSByte(a, b) {
  return a > b;
}

// GreaterOrEqualSByte(a: number, b: number): boolean
export function GreaterOrEqualSByte(a, b) {
  return a >= b;
}

// ShiftLeftSByte(a: number, count: number): number
export function ShiftLeftSByte(a, count) {
  return a << count;
}

// ShiftRightSByte(a: number, count: number): number
export function ShiftRightSByte(a, count) {
  return a >> count;
}

// ShiftRightLogicalSByte(a: number, count: number): number
export function ShiftRightLogicalSByte(a, count) {
  return (a >>> count) | 0;
}

// NotSByte(a: number): number
export function NotSByte(a) {
  return ~a;
}

// PlusSByte(a: number): number
export function PlusSByte(a) {
  return a;
}

// NegateSByte(a: number): number
export function NegateSByte(a) {
  return -a | 0;
}

// AddAssignSByte(a: number, b: number): number
export function AddAssignSByte(a, b) {
  a = ((a + b) | 0) << 24 >> 24;
  return a;
}

// SubtractAssignSByte(a: number, b: number): number
export function SubtractAssignSByte(a, b) {
  a = ((a - b) | 0) << 24 >> 24;
  return a;
}

// MultiplyAssignSByte(a: number, b: number): number
export function MultiplyAssignSByte(a, b) {
  a = Math.imul(a, b) << 24 >> 24;
  return a;
}

// DivideAssignSByte(a: number, b: number): number
export function DivideAssignSByte(a, b) {
  a = Divide32(a, b, -2147483648) << 24 >> 24;
