// Divide32(dividend: number, divisor: number, smallest: number): number
function Divide32(dividend, divisor, smallest) {
  CheckDivision32(dividend, divisor, smallest);
  return (dividend / divisor) | 0;
}

// Remainder32(dividend: number, divisor: number, smallest: number): number
function Remainder32(dividend, divisor, smallest) {
  CheckDivision32(dividend, divisor, smallest);
  return (dividend % divisor) | 0;
}

// AddChecked32(left: number, right: number, low: number, high: number): number
function AddChecked32(left, right, low, high) {
  return Checked32(left + right, low, high);
}

// SubtractChecked32(left: number, right: number, low: number, high: number): number
function SubtractChecked32(left, right, low, high) {
  return Checked32(left - right, low, high);
}

// MultiplyChecked32(left: number, right: number, low: number, high: number): number
function MultiplyChecked32(left, right, low, high) {
  return Checked32(left * right, low, high);
}

// CheckRange32(value: number, low: number, high: number): number
function CheckRange32(value, low, high) {
  if ((value < low) || (value > high)) {
    throw new OverflowError("integer overflow");
  }
  return value;
}

// AddCheckedUnsigned32(left: number, right: number, high: number): number
function AddCheckedUnsigned32(left, right, high) {
  return CheckedUnsigned32(left + right, high);
}

// SubtractCheckedUnsigned32(left: number, right: number, high: number): number
function SubtractCheckedUnsigned32(left, right, high) {
  return CheckedUnsigned32(left - right, high);
}

// MultiplyCheckedUnsigned32(left: number, right: number, high: number): number
function MultiplyCheckedUnsigned32(left, right, high) {
  return CheckedUnsigned32(left * right, high);
}

// SubtractCheckedSigned64(left: bigint, right: bigint): bigint
function SubtractCheckedSigned64(left, right) {
  let difference = BigInt.asIntN(64, left - right);
  if ((((((Number(BigInt.asUintN(64, left) >> 32n) ^ Number(BigInt.asUintN(64, right) >> 32n)) >>> 0) & ((Number(BigInt.asUintN(64, left) >> 32n) ^ Number(BigInt.asUintN(64, difference) >> 32n)) >>> 0)) >>> 0) | 0) < 0) {
    throw new OverflowError("integer overflow");
  }
  return difference;
}

// AddCheckedSigned64(left: bigint, right: bigint): bigint
function AddCheckedSigned64(left, right) {
  let sum = BigInt.asIntN(64, left + right);
  if ((((((Number(BigInt.asUintN(64, left) >> 32n) ^ Number(BigInt.asUintN(64, sum) >> 32n)) >>> 0) & ((Number(BigInt.asUintN(64, right) >> 32n) ^ Number(BigInt.asUintN(64, sum) >> 32n)) >>> 0)) >>> 0) | 0) < 0) {
    throw new OverflowError("integer overflow");
  }
  return sum;
}

// MultiplyCheckedSigned64(left: bigint, right: bigint): bigint
function MultiplyCheckedSigned64(left, right) {
  let negative = IsNegative64(left) !== IsNegative64(right);
  let leftMagnitude = Magnitude64(left);
  let rightMagnitude = Magnitude64(right);
  let product = BigInt.asUintN(64, leftMagnitude * rightMagnitude);
  let limit = negative ? 9223372036854775808n : 9223372036854775807n;
  if ((MulHighUnsigned64(leftMagnitude, rightMagnitude) !== 0n) || (product > limit)) {
    throw new OverflowError("integer overflow");
  }
  return negative ? BigInt.asIntN(64, -BigInt.asIntN(64, product)) : BigInt.asIntN(64, product);
}

// AddCheckedUnsigned64(left: bigint, right: bigint): bigint
function AddCheckedUnsigned64(left, right) {
  let sum = BigInt.asUintN(64, left + right);
  if (sum < left) {
    throw new OverflowError("integer overflow");
  }
  return sum;
}

// SubtractCheckedUnsigned64(left: bigint, right: bigint): bigint
function SubtractCheckedUnsigned64(left, right) {
  if (left < right) {
    throw new OverflowError("integer overflow");
  }
  return BigInt.asUintN(64, left - right);
}

// MultiplyCheckedUnsigned64(left: bigint, right: bigint): bigint
function MultiplyCheckedUnsigned64(left, right) {
  if (MulHighUnsigned64(left, right) !== 0n) {
    throw new OverflowError("integer overflow");
  }
  return BigInt.asUintN(64, left * right);
}

// CheckDivision32(dividend: number, divisor: number, smallest: number): void
function CheckDivision32(dividend, divisor, smallest) {
  if (divisor === 0) {
    throw new DivideByZeroError("divide by zero");
  }
  if ((divisor === (-1)) && (dividend === smallest)) {
    throw new OverflowError("integer overflow");
  }
}

// Checked32(value: number, low: number, high: number): number
function Checked32(value, low, high) {
  if ((value < low) || (value > high)) {
    throw new OverflowError("integer overflow");
  }
  return value | 0;
}

// CheckedUnsigned32(value: number, high: number): number
function CheckedUnsigned32(value, high) {
  if ((value < 0) || (value > high)) {
    throw new OverflowError("integer overflow");
  }
  return value >>> 0;
}

// IsNegative64(value: bigint): boolean
function IsNegative64(value) {
  return (Number(BigInt.asUintN(64, value) >> 32n) | 0) < 0;
}

// Magnitude64(value: bigint): bigint
function Magnitude64(value) {
  return IsNegative64(value) ? BigInt.asUintN(64, BigInt.asIntN(64, -value)) : BigInt.asUintN(64, value);
}

// MulHighUnsigned64(left: bigint, right: bigint): bigint
function MulHighUnsigned64(left, right) {
  let leftLow = left & 4294967295n;
  let leftHigh = left >> 32n;
  let rightLow = right & 4294967295n;
  let rightHigh = right >> 32n;
  let middle = BigInt.asUintN(64, BigInt.asUintN(64, leftHigh * rightLow) + (BigInt.asUintN(64, leftLow * rightLow) >> 32n));
  let cross = BigInt.asUintN(64, BigInt.asUintN(64, leftLow * rightHigh) + (middle & 4294967295n));
  return BigInt.asUintN(64, BigInt.asUintN(64, BigInt.asUintN(64, leftHigh * rightHigh) + (middle >> 32n)) + (cross >> 32n));
}

