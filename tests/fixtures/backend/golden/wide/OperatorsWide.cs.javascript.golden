// AddUIntInt(a: number, b: number): bigint
export function AddUIntInt(a, b) {
  return BigInt.asIntN(64, BigInt(a) + BigInt(b));
}

// MultiplyIntUInt(a: number, b: number): bigint
export function MultiplyIntUInt(a, b) {
  return BigInt.asIntN(64, BigInt(a) * BigInt(b));
}

// LessUIntInt(a: number, b: number): boolean
export function LessUIntInt(a, b) {
  return BigInt(a) < BigInt(b);
}

// NegateUInt(a: number): bigint
export function NegateUInt(a) {
  return BigInt.asIntN(64, -BigInt(a));
}

// AddLongInt(a: bigint, b: number): bigint
export function AddLongInt(a, b) {
  return BigInt.asIntN(64, a + BigInt(b));
}

// AddULongUInt(a: bigint, b: number): bigint
export function AddULongUInt(a, b) {
  return BigInt.asUintN(64, a + BigInt(b));
}

// AddSByteByte(a: number, b: number): number
export function AddSByteByte(a, b) {
  return (a + b) | 0;
}

// ShiftLongBySByte(a: bigint, count: number): bigint
export function ShiftLongBySByte(a, count) {
  return BigInt.asIntN(64, a << BigInt(count & 63));
}

// MaskLong(a: bigint): bigint
export function MaskLong(a) {
  return a & 18374966859414961920n;
}

// SmallestLong(): bigint
export function SmallestLong() {
  return -9223372036854775808n;
}

// LargestULong(): bigint
export function LargestULong() {
  return 18446744073709551615n;
}

// WidenedConstant(a: bigint): bigint
export function WidenedConstant(a) {
  return BigInt.asIntN(64, a + 1n);
}

// UnsignedConstant(a: bigint): bigint
export function UnsignedConstant(a) {
  return BigInt.asUintN(64, BigInt.asUintN(64, a * 1099511628211n) + 1n);
}

// SmallestShort(): number
export function SmallestShort() {
  return -32768;
}

// SmallestSByte(): number
export function SmallestSByte() {
  return -128;
}

// Letter(): number
export function Letter() {
  return 65;
}

// IsDigit(c: number): boolean
export function IsDigit(c) {
  return (c >= 48) && (c <= 57);
}

// DigitValue(c: number): number
export function DigitValue(c) {
  return (c - 48) | 0;
}

// AddFloatDouble(a: number, b: number): number
export function AddFloatDouble(a, b) {
  return a + b;
}

// AddIntFloat(a: number, b: number): number
export function AddIntFloat(a, b) {
  return Math.fround(Math.fround(a) + b);
}

// AddLongDouble(a: bigint, b: number): number
export function AddLongDouble(a, b) {
  return Number(a) + b;
}

// MultiplyAdd(a: number, b: number): number
export function MultiplyAdd(a, b) {
  return Math.fround(Math.fround(a * b) + a);
}

// MultiplyAddDouble(a: number, b: number): number
export function MultiplyAddDouble(a, b) {
  return (a * b) + a;
}

// IsNaN(a: number): boolean
export function IsNaN(a) {
  let b = a;
  return a !== b;
}

// NotLess(a: number, b: number): boolean
export function NotLess(a, b) {
  return !(a < b);
}

// Third(): number
export function Third() {
  return 0.3333333333333333;
}

// ThirdFloat(): number
export function ThirdFloat() {
  return 0.3333333432674408;
}

// NotANumber(): number
export function NotANumber() {
  return NaN;
}

// Infinite(): number
export function Infinite() {
  return -Infinity;
}

// InfiniteFloat(): number
export function InfiniteFloat() {
  return Infinity;
}

// NegativeZero(): number
export function NegativeZero() {
  return -0;
}

// Largest(): number
export function Largest() {
  return 1.7976931348623157E+308;
}

// SmallestFloat(): number
export function SmallestFloat() {
  return 1.401298464324817E-45;
}

// Scale(a: number): number
export function Scale(a) {
  return (a * 1E-07) + 1E+21;
}

// Tenth(a: number): number
export function Tenth(a) {
  return Math.fround(a * 0.10000000149011612);
}

// Divide32(dividend: number, divisor: number, smallest: number): number
function Divide32(dividend, divisor, smallest) {
  CheckDivision32(dividend, divisor, smallest);
  return (dividend / divisor) | 0;
}

// Remainder32(dividend: number, divisor: number, smallest: number): number
function Remainder32(dividend, divisor, smallest) {
  CheckDivision32(dividend, divisor, smallest);
  return (dividend % divisor) | 0;
}

// AddChecked32(left: number, right: number, low: number, high: number): number
function AddChecked32(left, right, low, high) {
  return Checked32(left + right, low, high);
}

// SubtractChecked32(left: number, right: number, low: number, high: number): number
function SubtractChecked32(left, right, low, high) {
  return Checked32(left - right, low, high);
}

// MultiplyChecked32(left: number, right: number, low: number, high: number): number
function MultiplyChecked32(left, right, low, high) {
