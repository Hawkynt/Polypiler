// AddFloat(a: number, b: number): number
export function AddFloat(a, b) {
  return Math.fround(a + b);
}

// SubtractFloat(a: number, b: number): number
export function SubtractFloat(a, b) {
  return Math.fround(a - b);
}

// MultiplyFloat(a: number, b: number): number
export function MultiplyFloat(a, b) {
  return Math.fround(a * b);
}

// DivideFloat(a: number, b: number): number
export function DivideFloat(a, b) {
  return Math.fround(a / b);
}

// RemainderFloat(a: number, b: number): number
export function RemainderFloat(a, b) {
  return Math.fround(a % b);
}

// EqualFloat(a: number, b: number): boolean
export function EqualFloat(a, b) {
  return a === b;
}

// NotEqualFloat(a: number, b: number): boolean
export function NotEqualFloat(a, b) {
  return a !== b;
}

// LessFloat(a: number, b: number): boolean
