    a = CheckRange32(SubtractChecked32(a, 1, -2147483648, 2147483647), -32768, 32767) << 16 >> 16;
    a = CheckRange32(SubtractChecked32(a, 1, -2147483648, 2147483647), -32768, 32767) << 16 >> 16;
  }
  return a;
}

