  return $ck(a * b, -2147483648, 2147483647) | 0;
}

// NegateCheckedUShort(a: number): number
export function NegateCheckedUShort(a) {
  return $ck(-a, -2147483648, 2147483647) | 0;
}

// AddAssignCheckedUShort(a: number, b: number): number
export function AddAssignCheckedUShort(a, b) {
  {
    a = $ck($ck(a + b, -2147483648, 2147483647), 0, 65535);
  }
  return a;
}

// SubtractAssignCheckedUShort(a: number, b: number): number
export function SubtractAssignCheckedUShort(a, b) {
  {
    a = $ck($ck(a - b, -2147483648, 2147483647), 0, 65535);
  }
  return a;
}

// MultiplyAssignCheckedUShort(a: number, b: number): number
export function MultiplyAssignCheckedUShort(a, b) {
  {
    a = $ck($ck(a * b, -2147483648, 2147483647) | 0, 0, 65535);
  }
  return a;
}

// ShiftLeftAssignCheckedUShort(a: number, count: number): number
export function ShiftLeftAssignCheckedUShort(a, count) {
  {
    a = $ck(a << count, 0, 65535);
  }
  return a;
}

// IncrementCheckedUShort(a: number): number
export function IncrementCheckedUShort(a) {
  {
    a = $ck($ck(a + 1, -2147483648, 2147483647), 0, 65535);
    a = $ck($ck(a + 1, -2147483648, 2147483647), 0, 65535);
  }
  return a;
}

// DecrementCheckedUShort(a: number): number
export function DecrementCheckedUShort(a) {
  {
    a = $ck($ck(a - 1, -2147483648, 2147483647), 0, 65535);
    a = $ck($ck(a - 1, -2147483648, 2147483647), 0, 65535);
  }
  return a;
}

// UncheckedInsideCheckedUShort(a: number, b: number): number
export function UncheckedInsideCheckedUShort(a, b) {
  return $ck(((a + b) | 0) - b, -2147483648, 2147483647);
}

// AddChar(a: number, b: number): number
export function AddChar(a, b) {
  return (a + b) | 0;
}

// SubtractChar(a: number, b: number): number
export function SubtractChar(a, b) {
  return (a - b) | 0;
}

// MultiplyChar(a: number, b: number): number
export function MultiplyChar(a, b) {
  return Math.imul(a, b);
}

// DivideChar(a: number, b: number): number
export function DivideChar(a, b) {
  return $div(a, b);
}

// RemainderChar(a: number, b: number): number
export function RemainderChar(a, b) {
  return $rem(a, b);
}

// AndChar(a: number, b: number): number
export function AndChar(a, b) {
  return a & b;
}

// OrChar(a: number, b: number): number
export function OrChar(a, b) {
  return a | b;
}

// XorChar(a: number, b: number): number
export function XorChar(a, b) {
  return a ^ b;
}

// EqualChar(a: number, b: number): boolean
export function EqualChar(a, b) {
  return a === b;
}

// NotEqualChar(a: number, b: number): boolean
export function NotEqualChar(a, b) {
  return a !== b;
}

// LessChar(a: number, b: number): boolean
export function LessChar(a, b) {
  return a < b;
}

// LessOrEqualChar(a: number, b: number): boolean
export function LessOrEqualChar(a, b) {
  return a <= b;
}

// GreaterChar(a: number, b: number): boolean
export function GreaterChar(a, b) {
  return a > b;
}

// GreaterOrEqualChar(a: number, b: number): boolean
export function GreaterOrEqualChar(a, b) {
  return a >= b;
}

// ShiftLeftChar(a: number, count: number): number
export function ShiftLeftChar(a, count) {
  return a << count;
}

// ShiftRightChar(a: number, count: number): number
export function ShiftRightChar(a, count) {
  return a >> count;
}

// ShiftRightLogicalChar(a: number, count: number): number
export function ShiftRightLogicalChar(a, count) {
  return (a >>> count) | 0;
}

// NotChar(a: number): number
export function NotChar(a) {
  return ~a;
}

// PlusChar(a: number): number
export function PlusChar(a) {
  return a;
}

// NegateChar(a: number): number
export function NegateChar(a) {
  return -a | 0;
}

// AddAssignChar(a: number, b: number): number
export function AddAssignChar(a, b) {
  a = ((a + b) | 0) & 0xFFFF;
  return a;
}

// SubtractAssignChar(a: number, b: number): number
export function SubtractAssignChar(a, b) {
  a = ((a - b) | 0) & 0xFFFF;
  return a;
}

// MultiplyAssignChar(a: number, b: number): number
export function MultiplyAssignChar(a, b) {
  a = Math.imul(a, b) & 0xFFFF;
  return a;
}

// DivideAssignChar(a: number, b: number): number
export function DivideAssignChar(a, b) {
  a = $div(a, b) & 0xFFFF;
  return a;
}

// RemainderAssignChar(a: number, b: number): number
export function RemainderAssignChar(a, b) {
  a = $rem(a, b) & 0xFFFF;
  return a;
}

// AndAssignChar(a: number, b: number): number
export function AndAssignChar(a, b) {
  a = (a & b) & 0xFFFF;
  return a;
}

// OrAssignChar(a: number, b: number): number
export function OrAssignChar(a, b) {
  a = (a | b) & 0xFFFF;
  return a;
}

// XorAssignChar(a: number, b: number): number
export function XorAssignChar(a, b) {
  a = (a ^ b) & 0xFFFF;
  return a;
}

// ShiftLeftAssignChar(a: number, count: number): number
export function ShiftLeftAssignChar(a, count) {
  a = (a << count) & 0xFFFF;
  return a;
}

// ShiftRightAssignChar(a: number, count: number): number
export function ShiftRightAssignChar(a, count) {
  a = (a >> count) & 0xFFFF;
  return a;
}

// ShiftRightLogicalAssignChar(a: number, count: number): number
export function ShiftRightLogicalAssignChar(a, count) {
  a = ((a >>> count) | 0) & 0xFFFF;
  return a;
}

// IncrementChar(a: number): number
export function IncrementChar(a) {
  a = ((a + 1) | 0) & 0xFFFF;
  a = ((a + 1) | 0) & 0xFFFF;
  return a;
}

// DecrementChar(a: number): number
export function DecrementChar(a) {
  a = ((a - 1) | 0) & 0xFFFF;
  a = ((a - 1) | 0) & 0xFFFF;
  return a;
}

// ChooseChar(first: boolean, a: number, b: number): number
export function ChooseChar(first, a, b) {
  return first ? a : b;
}

