  return DivideWords(dividend, divisor, false);
}

// RemainderUnsigned64(dividend: { hi, lo }, divisor: { hi, lo }): { hi, lo }
function RemainderUnsigned64(dividend, divisor) {
  return DivideWords(dividend, divisor, true);
}

// CompareUnsigned64(left: { hi, lo }, right: { hi, lo }): number
function CompareUnsigned64(left, right) {
  var leftHigh = left.hi;
  var rightHigh = right.hi;
  if (leftHigh !== rightHigh) {
    return (leftHigh < rightHigh) ? (-1) : 1;
  }
  return CompareLow(left.lo, right.lo);
}

// AddCheckedUnsigned64(left: { hi, lo }, right: { hi, lo }): { hi, lo }
function AddCheckedUnsigned64(left, right) {
  var sum = Add64(left, right);
  if (CompareUnsigned64(sum, left) < 0) {
    throw new OverflowError("integer overflow");
  }
  return sum;
