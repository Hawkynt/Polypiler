// ShiftLeftAssignLong(a: bigint, count: number): bigint
export function ShiftLeftAssignLong(a, count) {
  a = BigInt.asIntN(64, a << BigInt(count & 63));
  return a;
}

// ShiftRightAssignLong(a: bigint, count: number): bigint
export function ShiftRightAssignLong(a, count) {
  a = a >> BigInt(count & 63);
  return a;
}

// ShiftRightLogicalAssignLong(a: bigint, count: number): bigint
export function ShiftRightLogicalAssignLong(a, count) {
  a = BigInt.asIntN(64, BigInt.asUintN(64, a) >> BigInt(count & 63));
  return a;
}

// IncrementLong(a: bigint): bigint
export function IncrementLong(a) {
  a = BigInt.asIntN(64, a + 1n);
  a = BigInt.asIntN(64, a + 1n);
  return a;
}

// DecrementLong(a: bigint): bigint
export function DecrementLong(a) {
  a = BigInt.asIntN(64, a - 1n);
  a = BigInt.asIntN(64, a - 1n);
  return a;
}

// ChooseLong(first: boolean, a: bigint, b: bigint): bigint
export function ChooseLong(first, a, b) {
  return first ? a : b;
}

// AddCheckedLong(a: bigint, b: bigint): bigint
export function AddCheckedLong(a, b) {
  return AddCheckedSigned64(a, b);
}

// SubtractCheckedLong(a: bigint, b: bigint): bigint
export function SubtractCheckedLong(a, b) {
  return SubtractCheckedSigned64(a, b);
}

// MultiplyCheckedLong(a: bigint, b: bigint): bigint
export function MultiplyCheckedLong(a, b) {
  return MultiplyCheckedSigned64(a, b);
}

// NegateCheckedLong(a: bigint): bigint
export function NegateCheckedLong(a) {
  return SubtractCheckedSigned64(0n, a);
}

// AddAssignCheckedLong(a: bigint, b: bigint): bigint
export function AddAssignCheckedLong(a, b) {
  {
    a = AddCheckedSigned64(a, b);
  }
  return a;
}

// SubtractAssignCheckedLong(a: bigint, b: bigint): bigint
export function SubtractAssignCheckedLong(a, b) {
  {
    a = SubtractCheckedSigned64(a, b);
  }
  return a;
}

// MultiplyAssignCheckedLong(a: bigint, b: bigint): bigint
export function MultiplyAssignCheckedLong(a, b) {
  {
    a = MultiplyCheckedSigned64(a, b);
  }
  return a;
}

// ShiftLeftAssignCheckedLong(a: bigint, count: number): bigint
export function ShiftLeftAssignCheckedLong(a, count) {
  {
    a = BigInt.asIntN(64, a << BigInt(count & 63));
  }
  return a;
}

// IncrementCheckedLong(a: bigint): bigint
export function IncrementCheckedLong(a) {
  {
    a = AddCheckedSigned64(a, 1n);
    a = AddCheckedSigned64(a, 1n);
  }
  return a;
}

// DecrementCheckedLong(a: bigint): bigint
export function DecrementCheckedLong(a) {
  {
    a = SubtractCheckedSigned64(a, 1n);
    a = SubtractCheckedSigned64(a, 1n);
  }
  return a;
}

// UncheckedInsideCheckedLong(a: bigint, b: bigint): bigint
export function UncheckedInsideCheckedLong(a, b) {
  return SubtractCheckedSigned64(BigInt.asIntN(64, a + b), b);
}

// AddULong(a: bigint, b: bigint): bigint
export function AddULong(a, b) {
  return BigInt.asUintN(64, a + b);
}

// SubtractULong(a: bigint, b: bigint): bigint
export function SubtractULong(a, b) {
  return BigInt.asUintN(64, a - b);
}

// MultiplyULong(a: bigint, b: bigint): bigint
export function MultiplyULong(a, b) {
  return BigInt.asUintN(64, a * b);
}

// DivideULong(a: bigint, b: bigint): bigint
export function DivideULong(a, b) {
  return $udiv64(a, b);
}

// RemainderULong(a: bigint, b: bigint): bigint
export function RemainderULong(a, b) {
  return $urem64(a, b);
}

// AndULong(a: bigint, b: bigint): bigint
export function AndULong(a, b) {
  return a & b;
}

// OrULong(a: bigint, b: bigint): bigint
export function OrULong(a, b) {
  return a | b;
}

// XorULong(a: bigint, b: bigint): bigint
export function XorULong(a, b) {
  return a ^ b;
}

// EqualULong(a: bigint, b: bigint): boolean
export function EqualULong(a, b) {
  return a === b;
}

// NotEqualULong(a: bigint, b: bigint): boolean
export function NotEqualULong(a, b) {
  return a !== b;
