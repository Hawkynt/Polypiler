// AddUIntInt(a: number, b: number): bigint
function AddUIntInt(a, b) {
  return BigInt.asIntN(64, BigInt(a) + BigInt(b));
}

// MultiplyIntUInt(a: number, b: number): bigint
function MultiplyIntUInt(a, b) {
  return BigInt.asIntN(64, BigInt(a) * BigInt(b));
}

// LessUIntInt(a: number, b: number): boolean
function LessUIntInt(a, b) {
  return BigInt(a) < BigInt(b);
}

// NegateUInt(a: number): bigint
function NegateUInt(a) {
  return BigInt.asIntN(64, -BigInt(a));
}

// AddLongInt(a: bigint, b: number): bigint
function AddLongInt(a, b) {
  return BigInt.asIntN(64, a + BigInt(b));
}

// AddULongUInt(a: bigint, b: number): bigint
function AddULongUInt(a, b) {
  return BigInt.asUintN(64, a + BigInt(b));
}

// AddSByteByte(a: number, b: number): number
function AddSByteByte(a, b) {
  return (a + b) | 0;
}

// ShiftLongBySByte(a: bigint, count: number): bigint
function ShiftLongBySByte(a, count) {
  return BigInt.asIntN(64, a << BigInt(count & 63));
}

// MaskLong(a: bigint): bigint
function MaskLong(a) {
  return a & 18374966859414961920n;
}

// SmallestLong(): bigint
function SmallestLong() {
  return -9223372036854775808n;
}

// LargestULong(): bigint
function LargestULong() {
  return 18446744073709551615n;
}

// WidenedConstant(a: bigint): bigint
function WidenedConstant(a) {
  return BigInt.asIntN(64, a + 1n);
}

// UnsignedConstant(a: bigint): bigint
function UnsignedConstant(a) {
  return BigInt.asUintN(64, BigInt.asUintN(64, a * 1099511628211n) + 1n);
}

// SmallestShort(): number
function SmallestShort() {
  return -32768;
}

// SmallestSByte(): number
function SmallestSByte() {
  return -128;
}

// Letter(): number
function Letter() {
  return 65;
}

// IsDigit(c: number): boolean
function IsDigit(c) {
  return (c >= 48) && (c <= 57);
}

// DigitValue(c: number): number
function DigitValue(c) {
  return (c - 48) | 0;
}

// AddFloatDouble(a: number, b: number): number
function AddFloatDouble(a, b) {
  return a + b;
}

// AddIntFloat(a: number, b: number): number
function AddIntFloat(a, b) {
  return Math.fround(Math.fround(a) + b);
}

// AddLongDouble(a: bigint, b: number): number
function AddLongDouble(a, b) {
  return Number(a) + b;
}

// MultiplyAdd(a: number, b: number): number
function MultiplyAdd(a, b) {
  return Math.fround(Math.fround(a * b) + a);
}

// MultiplyAddDouble(a: number, b: number): number
function MultiplyAddDouble(a, b) {
  return (a * b) + a;
}

// IsNaN(a: number): boolean
function IsNaN(a) {
  let b = a;
  return a !== b;
}

// NotLess(a: number, b: number): boolean
function NotLess(a, b) {
  return !(a < b);
}

// Third(): number
function Third() {
  return 0.3333333333333333;
}

// ThirdFloat(): number
function ThirdFloat() {
  return 0.3333333432674408;
}

// NotANumber(): number
function NotANumber() {
  return NaN;
}

// Infinite(): number
function Infinite() {
  return -Infinity;
}

// InfiniteFloat(): number
function InfiniteFloat() {
  return Infinity;
}

// NegativeZero(): number
function NegativeZero() {
  return -0;
}

// Largest(): number
function Largest() {
  return 1.7976931348623157E+308;
}

// SmallestFloat(): number
function SmallestFloat() {
  return 1.401298464324817E-45;
}

// Scale(a: number): number
function Scale(a) {
  return (a * 1E-07) + 1E+21;
}

// Tenth(a: number): number
function Tenth(a) {
  return Math.fround(a * 0.10000000149011612);
}

