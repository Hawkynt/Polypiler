// RemainderSigned64(dividend: { hi, lo }, divisor: { hi, lo }): { hi, lo }
function RemainderSigned64(dividend, divisor) {
  var rest = DivideWords(Magnitude64(dividend), Magnitude64(divisor), true);
  CheckQuotient64(dividend, divisor);
  return IsNegative64(dividend) ? Negate64(rest) : rest;
}

// And64(left: { hi, lo }, right: { hi, lo }): { hi, lo }
function And64(left, right) {
  return { hi: (left.hi & right.hi) >>> 0, lo: (left.lo & right.lo) >>> 0 };
}

// Or64(left: { hi, lo }, right: { hi, lo }): { hi, lo }
function Or64(left, right) {
  return { hi: (left.hi | right.hi) >>> 0, lo: (left.lo | right.lo) >>> 0 };
}

// Xor64(left: { hi, lo }, right: { hi, lo }): { hi, lo }
function Xor64(left, right) {
  return { hi: (left.hi ^ right.hi) >>> 0, lo: (left.lo ^ right.lo) >>> 0 };
}

// Equal64(left: { hi, lo }, right: { hi, lo }): boolean
function Equal64(left, right) {
  return (left.lo === right.lo) && (left.hi === right.hi);
}

// CompareSigned64(left: { hi, lo }, right: { hi, lo }): number
function CompareSigned64(left, right) {
  var leftHigh = left.hi | 0;
  var rightHigh = right.hi | 0;
  if (leftHigh !== rightHigh) {
    return (leftHigh < rightHigh) ? (-1) : 1;
  }
  return CompareLow(left.lo, right.lo);
}

// ShiftLeft64(value: { hi, lo }, count: number): { hi, lo }
function ShiftLeft64(value, count) {
  count = count & 63;
  if (count === 0) {
    return value;
  }
  var low = value.lo;
  if (count >= 32) {
    return { hi: (low << ((count - 32) | 0)) >>> 0, lo: 0 };
  }
  return { hi: (((value.hi << count) >>> 0) | (low >>> ((32 - count) | 0))) >>> 0, lo: (low << count) >>> 0 };
}

// ShiftRightArithmetic64(value: { hi, lo }, count: number): { hi, lo }
function ShiftRightArithmetic64(value, count) {
  count = count & 63;
  if (count === 0) {
    return value;
  }
  var high = value.hi | 0;
  if (count >= 32) {
    return { hi: (high >> 31) >>> 0, lo: (high >> ((count - 32) | 0)) >>> 0 };
  }
  return { hi: (high >> count) >>> 0, lo: ((value.lo >>> count) | (((high >>> 0) << ((32 - count) | 0)) >>> 0)) >>> 0 };
}

// ShiftRightLogical64(value: { hi, lo }, count: number): { hi, lo }
function ShiftRightLogical64(value, count) {
  count = count & 63;
  if (count === 0) {
    return value;
  }
  var high = value.hi;
  if (count >= 32) {
    return { hi: 0, lo: high >>> ((count - 32) | 0) };
  }
  return { hi: high >>> count, lo: ((value.lo >>> count) | ((high << ((32 - count) | 0)) >>> 0)) >>> 0 };
}

// Not64(value: { hi, lo }): { hi, lo }
function Not64(value) {
  return { hi: ~value.hi >>> 0, lo: ~value.lo >>> 0 };
}

// Negate64(value: { hi, lo }): { hi, lo }
function Negate64(value) {
  var low = (0 - value.lo) >>> 0;
  return { hi: ((~value.hi >>> 0) + ((low === 0) ? 1 : 0)) >>> 0, lo: low };
}

// AddCheckedSigned64(left: { hi, lo }, right: { hi, lo }): { hi, lo }
function AddCheckedSigned64(left, right) {
  var sum = Add64(left, right);
  if ((((((left.hi ^ sum.hi) >>> 0) & ((right.hi ^ sum.hi) >>> 0)) >>> 0) | 0) < 0) {
    throw new OverflowError("integer overflow");
  }
  return sum;
}

// MultiplyCheckedSigned64(left: { hi, lo }, right: { hi, lo }): { hi, lo }
function MultiplyCheckedSigned64(left, right) {
  var negative = IsNegative64(left) !== IsNegative64(right);
  var leftMagnitude = Magnitude64(left);
  var rightMagnitude = Magnitude64(right);
  var product = Multiply64(leftMagnitude, rightMagnitude);
  var limit = negative ? { hi: 2147483648, lo: 0 } : { hi: 2147483647, lo: 4294967295 };
  if ((!Equal64(MulHighUnsigned64(leftMagnitude, rightMagnitude), { hi: 0, lo: 0 })) || (CompareUnsigned64(product, limit) > 0)) {
    throw new OverflowError("integer overflow");
  }
  return negative ? Negate64(product) : product;
}

// DivideUnsigned64(dividend: { hi, lo }, divisor: { hi, lo }): { hi, lo }
function DivideUnsigned64(dividend, divisor) {
  return DivideWords(dividend, divisor, false);
}

// RemainderUnsigned64(dividend: { hi, lo }, divisor: { hi, lo }): { hi, lo }
function RemainderUnsigned64(dividend, divisor) {
  return DivideWords(dividend, divisor, true);
}

// CompareUnsigned64(left: { hi, lo }, right: { hi, lo }): number
function CompareUnsigned64(left, right) {
  var leftHigh = left.hi;
  var rightHigh = right.hi;
  if (leftHigh !== rightHigh) {
    return (leftHigh < rightHigh) ? (-1) : 1;
  }
  return CompareLow(left.lo, right.lo);
}

// AddCheckedUnsigned64(left: { hi, lo }, right: { hi, lo }): { hi, lo }
function AddCheckedUnsigned64(left, right) {
  var sum = Add64(left, right);
  if (CompareUnsigned64(sum, left) < 0) {
    throw new OverflowError("integer overflow");
  }
  return sum;
}

// SubtractCheckedUnsigned64(left: { hi, lo }, right: { hi, lo }): { hi, lo }
function SubtractCheckedUnsigned64(left, right) {
  if (CompareUnsigned64(left, right) < 0) {
    throw new OverflowError("integer overflow");
  }
  return Subtract64(left, right);
}

// MultiplyCheckedUnsigned64(left: { hi, lo }, right: { hi, lo }): { hi, lo }
function MultiplyCheckedUnsigned64(left, right) {
  if (!Equal64(MulHighUnsigned64(left, right), { hi: 0, lo: 0 })) {
    throw new OverflowError("integer overflow");
  }
  return Multiply64(left, right);
}

// Widen64(value: number): { hi, lo }
function Widen64(value) {
  return { hi: (value < 0) ? 4294967295 : 0, lo: value >>> 0 };
}

// ToDouble64(value: { hi, lo }): number
function ToDouble64(value) {
