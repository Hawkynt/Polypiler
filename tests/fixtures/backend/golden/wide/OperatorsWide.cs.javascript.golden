// LessLong(a: { hi, lo }, b: { hi, lo }): boolean
export function LessLong(a, b) {
  return CompareSigned64(a, b) < 0;
}

// LessOrEqualLong(a: { hi, lo }, b: { hi, lo }): boolean
export function LessOrEqualLong(a, b) {
  return CompareSigned64(a, b) <= 0;
}

// GreaterLong(a: { hi, lo }, b: { hi, lo }): boolean
export function GreaterLong(a, b) {
