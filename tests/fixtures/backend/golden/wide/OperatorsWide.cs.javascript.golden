  return SubtractChecked32((a + b) | 0, b, -2147483648, 2147483647);
}

// AddUShort(a: number, b: number): number
export function AddUShort(a, b) {
  return (a + b) | 0;
}

// SubtractUShort(a: number, b: number): number
export function SubtractUShort(a, b) {
  return (a - b) | 0;
}

// MultiplyUShort(a: number, b: number): number
export function MultiplyUShort(a, b) {
  return Math.imul(a, b);
}

// DivideUShort(a: number, b: number): number
export function DivideUShort(a, b) {
  return Divide32(a, b, -2147483648);
}

// RemainderUShort(a: number, b: number): number
export function RemainderUShort(a, b) {
  return Remainder32(a, b, -2147483648);
}

// AndUShort(a: number, b: number): number
export function AndUShort(a, b) {
  return a & b;
}

// OrUShort(a: number, b: number): number
export function OrUShort(a, b) {
  return a | b;
}

// XorUShort(a: number, b: number): number
export function XorUShort(a, b) {
  return a ^ b;
}

// EqualUShort(a: number, b: number): boolean
export function EqualUShort(a, b) {
  return a === b;
}

// NotEqualUShort(a: number, b: number): boolean
export function NotEqualUShort(a, b) {
  return a !== b;
}

// LessUShort(a: number, b: number): boolean
export function LessUShort(a, b) {
  return a < b;
}

// LessOrEqualUShort(a: number, b: number): boolean
export function LessOrEqualUShort(a, b) {
  return a <= b;
}

// GreaterUShort(a: number, b: number): boolean
export function GreaterUShort(a, b) {
  return a > b;
}

// GreaterOrEqualUShort(a: number, b: number): boolean
export function GreaterOrEqualUShort(a, b) {
  return a >= b;
}

// ShiftLeftUShort(a: number, count: number): number
export function ShiftLeftUShort(a, count) {
  return a << count;
}

// ShiftRightUShort(a: number, count: number): number
export function ShiftRightUShort(a, count) {
  return a >> count;
}

// ShiftRightLogicalUShort(a: number, count: number): number
export function ShiftRightLogicalUShort(a, count) {
  return (a >>> count) | 0;
}

// NotUShort(a: number): number
export function NotUShort(a) {
  return ~a;
}

// PlusUShort(a: number): number
export function PlusUShort(a) {
  return a;
}

// NegateUShort(a: number): number
export function NegateUShort(a) {
  return -a | 0;
}

// AddAssignUShort(a: number, b: number): number
export function AddAssignUShort(a, b) {
  a = ((a + b) | 0) & 0xFFFF;
  return a;
}

// SubtractAssignUShort(a: number, b: number): number
export function SubtractAssignUShort(a, b) {
  a = ((a - b) | 0) & 0xFFFF;
  return a;
}

// MultiplyAssignUShort(a: number, b: number): number
export function MultiplyAssignUShort(a, b) {
  a = Math.imul(a, b) & 0xFFFF;
  return a;
}

// DivideAssignUShort(a: number, b: number): number
export function DivideAssignUShort(a, b) {
  a = Divide32(a, b, -2147483648) & 0xFFFF;
  return a;
}

// RemainderAssignUShort(a: number, b: number): number
export function RemainderAssignUShort(a, b) {
  a = Remainder32(a, b, -2147483648) & 0xFFFF;
  return a;
}

// AndAssignUShort(a: number, b: number): number
export function AndAssignUShort(a, b) {
  a = (a & b) & 0xFFFF;
  return a;
}

// OrAssignUShort(a: number, b: number): number
export function OrAssignUShort(a, b) {
  a = (a | b) & 0xFFFF;
  return a;
}

// XorAssignUShort(a: number, b: number): number
export function XorAssignUShort(a, b) {
  a = (a ^ b) & 0xFFFF;
  return a;
}

// ShiftLeftAssignUShort(a: number, count: number): number
export function ShiftLeftAssignUShort(a, count) {
  a = (a << count) & 0xFFFF;
  return a;
}

// ShiftRightAssignUShort(a: number, count: number): number
export function ShiftRightAssignUShort(a, count) {
  a = (a >> count) & 0xFFFF;
  return a;
}

// ShiftRightLogicalAssignUShort(a: number, count: number): number
export function ShiftRightLogicalAssignUShort(a, count) {
  a = ((a >>> count) | 0) & 0xFFFF;
  return a;
}

// IncrementUShort(a: number): number
export function IncrementUShort(a) {
  a = ((a + 1) | 0) & 0xFFFF;
  a = ((a + 1) | 0) & 0xFFFF;
  return a;
}

// DecrementUShort(a: number): number
export function DecrementUShort(a) {
  a = ((a - 1) | 0) & 0xFFFF;
  a = ((a - 1) | 0) & 0xFFFF;
  return a;
}

// ChooseUShort(first: boolean, a: number, b: number): number
export function ChooseUShort(first, a, b) {
  return first ? a : b;
}

