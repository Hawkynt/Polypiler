// AddLong(a: bigint, b: bigint): bigint
export function AddLong(a, b) {
  return BigInt.asIntN(64, a + b);
}

// SubtractLong(a: bigint, b: bigint): bigint
export function SubtractLong(a, b) {
  return BigInt.asIntN(64, a - b);
}

// MultiplyLong(a: bigint, b: bigint): bigint
export function MultiplyLong(a, b) {
  return BigInt.asIntN(64, a * b);
}

// DivideLong(a: bigint, b: bigint): bigint
export function DivideLong(a, b) {
  return $div64(a, b);
}

// RemainderLong(a: bigint, b: bigint): bigint
export function RemainderLong(a, b) {
  return $rem64(a, b);
}

// AndLong(a: bigint, b: bigint): bigint
export function AndLong(a, b) {
  return a & b;
}

// OrLong(a: bigint, b: bigint): bigint
export function OrLong(a, b) {
  return a | b;
}

// XorLong(a: bigint, b: bigint): bigint
export function XorLong(a, b) {
  return a ^ b;
}

// EqualLong(a: bigint, b: bigint): boolean
export function EqualLong(a, b) {
  return a === b;
}

// NotEqualLong(a: bigint, b: bigint): boolean
export function NotEqualLong(a, b) {
  return a !== b;
}

// LessLong(a: bigint, b: bigint): boolean
export function LessLong(a, b) {
  return a < b;
}

// LessOrEqualLong(a: bigint, b: bigint): boolean
export function LessOrEqualLong(a, b) {
  return a <= b;
}

// GreaterLong(a: bigint, b: bigint): boolean
export function GreaterLong(a, b) {
  return a > b;
}

// GreaterOrEqualLong(a: bigint, b: bigint): boolean
export function GreaterOrEqualLong(a, b) {
  return a >= b;
}

// ShiftLeftLong(a: bigint, count: number): bigint
export function ShiftLeftLong(a, count) {
  return BigInt.asIntN(64, a << BigInt(count & 63));
}

// ShiftRightLong(a: bigint, count: number): bigint
export function ShiftRightLong(a, count) {
  return a >> BigInt(count & 63);
}

// ShiftRightLogicalLong(a: bigint, count: number): bigint
export function ShiftRightLogicalLong(a, count) {
  return BigInt.asIntN(64, BigInt.asUintN(64, a) >> BigInt(count & 63));
}

// NotLong(a: bigint): bigint
export function NotLong(a) {
  return ~a;
}

// PlusLong(a: bigint): bigint
export function PlusLong(a) {
  return a;
}

// NegateLong(a: bigint): bigint
export function NegateLong(a) {
  return BigInt.asIntN(64, -a);
}

// AddAssignLong(a: bigint, b: bigint): bigint
export function AddAssignLong(a, b) {
  a = BigInt.asIntN(64, a + b);
  return a;
}

// SubtractAssignLong(a: bigint, b: bigint): bigint
export function SubtractAssignLong(a, b) {
  a = BigInt.asIntN(64, a - b);
  return a;
}

// MultiplyAssignLong(a: bigint, b: bigint): bigint
export function MultiplyAssignLong(a, b) {
  a = BigInt.asIntN(64, a * b);
  return a;
}

// DivideAssignLong(a: bigint, b: bigint): bigint
export function DivideAssignLong(a, b) {
  a = $div64(a, b);
