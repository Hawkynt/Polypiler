  a = Math.imul(a, b) << 16 >> 16;
  return a;
}

// DivideAssignShort(a: number, b: number): number
export function DivideAssignShort(a, b) {
  a = $div(a, b) << 16 >> 16;
  return a;
}

// RemainderAssignShort(a: number, b: number): number
export function RemainderAssignShort(a, b) {
  a = $rem(a, b) << 16 >> 16;
  return a;
}

// AndAssignShort(a: number, b: number): number
export function AndAssignShort(a, b) {
  a = (a & b) << 16 >> 16;
  return a;
}

// OrAssignShort(a: number, b: number): number
export function OrAssignShort(a, b) {
  a = (a | b) << 16 >> 16;
  return a;
}

// XorAssignShort(a: number, b: number): number
export function XorAssignShort(a, b) {
  a = (a ^ b) << 16 >> 16;
  return a;
}

// ShiftLeftAssignShort(a: number, count: number): number
export function ShiftLeftAssignShort(a, count) {
  a = (a << count) << 16 >> 16;
  return a;
}

// ShiftRightAssignShort(a: number, count: number): number
export function ShiftRightAssignShort(a, count) {
  a = (a >> count) << 16 >> 16;
  return a;
}

// ShiftRightLogicalAssignShort(a: number, count: number): number
export function ShiftRightLogicalAssignShort(a, count) {
  a = ((a >>> count) | 0) << 16 >> 16;
  return a;
}

// IncrementShort(a: number): number
export function IncrementShort(a) {
  a = ((a + 1) | 0) << 16 >> 16;
  a = ((a + 1) | 0) << 16 >> 16;
  return a;
}

// DecrementShort(a: number): number
export function DecrementShort(a) {
  a = ((a - 1) | 0) << 16 >> 16;
  a = ((a - 1) | 0) << 16 >> 16;
  return a;
}

// ChooseShort(first: boolean, a: number, b: number): number
export function ChooseShort(first, a, b) {
  return first ? a : b;
}

// AddCheckedShort(a: number, b: number): number
export function AddCheckedShort(a, b) {
  return $ck(a + b, -2147483648, 2147483647);
}

// SubtractCheckedShort(a: number, b: number): number
export function SubtractCheckedShort(a, b) {
  return $ck(a - b, -2147483648, 2147483647);
}

// MultiplyCheckedShort(a: number, b: number): number
export function MultiplyCheckedShort(a, b) {
  return $ck(a * b, -2147483648, 2147483647) | 0;
}

// NegateCheckedShort(a: number): number
export function NegateCheckedShort(a) {
  return $ck(-a, -2147483648, 2147483647) | 0;
}

