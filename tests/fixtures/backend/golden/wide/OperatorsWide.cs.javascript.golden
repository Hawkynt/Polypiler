// Divide32(dividend: number, divisor: number, smallest: number): number
function Divide32(dividend, divisor, smallest) {
  CheckDivision32(dividend, divisor, smallest);
  return (dividend / divisor) | 0;
}

// Remainder32(dividend: number, divisor: number, smallest: number): number
function Remainder32(dividend, divisor, smallest) {
  CheckDivision32(dividend, divisor, smallest);
  return (dividend % divisor) | 0;
}

// AddChecked32(left: number, right: number, low: number, high: number): number
function AddChecked32(left, right, low, high) {
  return Checked32(left + right, low, high);
}

// SubtractChecked32(left: number, right: number, low: number, high: number): number
function SubtractChecked32(left, right, low, high) {
  return Checked32(left - right, low, high);
}

// MultiplyChecked32(left: number, right: number, low: number, high: number): number
function MultiplyChecked32(left, right, low, high) {
  return Checked32(left * right, low, high);
}

// CheckRange32(value: number, low: number, high: number): number
function CheckRange32(value, low, high) {
  if ((value < low) || (value > high)) {
    throw new OverflowError("integer overflow");
  }
  return value;
}

// AddCheckedUnsigned32(left: number, right: number, high: number): number
function AddCheckedUnsigned32(left, right, high) {
  return CheckedUnsigned32(left + right, high);
}

// SubtractCheckedUnsigned32(left: number, right: number, high: number): number
function SubtractCheckedUnsigned32(left, right, high) {
  return CheckedUnsigned32(left - right, high);
}

// MultiplyCheckedUnsigned32(left: number, right: number, high: number): number
function MultiplyCheckedUnsigned32(left, right, high) {
  return CheckedUnsigned32(left * right, high);
}

// SubtractCheckedSigned64(left: { hi, lo }, right: { hi, lo }): { hi, lo }
function SubtractCheckedSigned64(left, right) {
  let difference = Subtract64(left, right);
  if ((((((left.hi ^ right.hi) >>> 0) & ((left.hi ^ difference.hi) >>> 0)) >>> 0) | 0) < 0) {
    throw new OverflowError("integer overflow");
  }
  return difference;
}

// Add64(left: { hi, lo }, right: { hi, lo }): { hi, lo }
function Add64(left, right) {
  let low = (left.lo + right.lo) >>> 0;
  let carry = (low < left.lo) ? 1 : 0;
  return { hi: (((left.hi + right.hi) >>> 0) + carry) >>> 0, lo: low };
}

// Subtract64(left: { hi, lo }, right: { hi, lo }): { hi, lo }
function Subtract64(left, right) {
  let borrow = (left.lo < right.lo) ? 1 : 0;
  return { hi: (((left.hi - right.hi) >>> 0) - borrow) >>> 0, lo: (left.lo - right.lo) >>> 0 };
}

// Multiply64(left: { hi, lo }, right: { hi, lo }): { hi, lo }
function Multiply64(left, right) {
  let leftLow = left.lo;
  let rightLow = right.lo;
  let high = (((MulHighUnsigned32(leftLow, rightLow) + (Math.imul(left.hi, rightLow) >>> 0)) >>> 0) + (Math.imul(leftLow, right.hi) >>> 0)) >>> 0;
  return { hi: high, lo: Math.imul(leftLow, rightLow) >>> 0 };
}

// DivideSigned64(dividend: { hi, lo }, divisor: { hi, lo }): { hi, lo }
function DivideSigned64(dividend, divisor) {
  let quotient = DivideWords(Magnitude64(dividend), Magnitude64(divisor), false);
  CheckQuotient64(dividend, divisor);
  return (IsNegative64(dividend) !== IsNegative64(divisor)) ? Negate64(quotient) : quotient;
}

// RemainderSigned64(dividend: { hi, lo }, divisor: { hi, lo }): { hi, lo }
function RemainderSigned64(dividend, divisor) {
  let rest = DivideWords(Magnitude64(dividend), Magnitude64(divisor), true);
  CheckQuotient64(dividend, divisor);
  return IsNegative64(dividend) ? Negate64(rest) : rest;
}

// And64(left: { hi, lo }, right: { hi, lo }): { hi, lo }
function And64(left, right) {
  return { hi: (left.hi & right.hi) >>> 0, lo: (left.lo & right.lo) >>> 0 };
}

// Or64(left: { hi, lo }, right: { hi, lo }): { hi, lo }
function Or64(left, right) {
  return { hi: (left.hi | right.hi) >>> 0, lo: (left.lo | right.lo) >>> 0 };
}

// Xor64(left: { hi, lo }, right: { hi, lo }): { hi, lo }
function Xor64(left, right) {
  return { hi: (left.hi ^ right.hi) >>> 0, lo: (left.lo ^ right.lo) >>> 0 };
}

// Equal64(left: { hi, lo }, right: { hi, lo }): boolean
function Equal64(left, right) {
  return (left.lo === right.lo) && (left.hi === right.hi);
}

// CompareSigned64(left: { hi, lo }, right: { hi, lo }): number
function CompareSigned64(left, right) {
  let leftHigh = left.hi | 0;
  let rightHigh = right.hi | 0;
  if (leftHigh !== rightHigh) {
    return (leftHigh < rightHigh) ? (-1) : 1;
  }
  return CompareLow(left.lo, right.lo);
}

// ShiftLeft64(value: { hi, lo }, count: number): { hi, lo }
function ShiftLeft64(value, count) {
  count = count & 63;
  if (count === 0) {
    return value;
  }
  let low = value.lo;
  if (count >= 32) {
    return { hi: (low << ((count - 32) | 0)) >>> 0, lo: 0 };
  }
  return { hi: (((value.hi << count) >>> 0) | (low >>> ((32 - count) | 0))) >>> 0, lo: (low << count) >>> 0 };
}

// ShiftRightArithmetic64(value: { hi, lo }, count: number): { hi, lo }
function ShiftRightArithmetic64(value, count) {
  count = count & 63;
  if (count === 0) {
    return value;
  }
  let high = value.hi | 0;
  if (count >= 32) {
    return { hi: (high >> 31) >>> 0, lo: (high >> ((count - 32) | 0)) >>> 0 };
  }
  return { hi: (high >> count) >>> 0, lo: ((value.lo >>> count) | (((high >>> 0) << ((32 - count) | 0)) >>> 0)) >>> 0 };
}

// ShiftRightLogical64(value: { hi, lo }, count: number): { hi, lo }
function ShiftRightLogical64(value, count) {
  count = count & 63;
  if (count === 0) {
    return value;
  }
  let high = value.hi;
  if (count >= 32) {
