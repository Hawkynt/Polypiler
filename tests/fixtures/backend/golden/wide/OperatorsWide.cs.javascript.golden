// AddSByteByte(a: number, b: number): number
export function AddSByteByte(a, b) {
  return (a + b) | 0;
}

// ShiftLongBySByte(a: bigint, count: number): bigint
export function ShiftLongBySByte(a, count) {
  return BigInt.asIntN(64, a << BigInt(count & 63));
}

// MaskLong(a: bigint): bigint
export function MaskLong(a) {
  return a & 18374966859414961920n;
}

// SmallestLong(): bigint
export function SmallestLong() {
  return -9223372036854775808n;
}

// LargestULong(): bigint
export function LargestULong() {
  return 18446744073709551615n;
}

// WidenedConstant(a: bigint): bigint
export function WidenedConstant(a) {
  return BigInt.asIntN(64, a + 1n);
}

// UnsignedConstant(a: bigint): bigint
export function UnsignedConstant(a) {
  return BigInt.asUintN(64, BigInt.asUintN(64, a * 1099511628211n) + 1n);
}

// SmallestShort(): number
export function SmallestShort() {
  return -32768;
}

// SmallestSByte(): number
export function SmallestSByte() {
  return -128;
}

// Letter(): number
export function Letter() {
  return 65;
}

// IsDigit(c: number): boolean
export function IsDigit(c) {
  return (c >= 48) && (c <= 57);
}

// DigitValue(c: number): number
export function DigitValue(c) {
  return (c - 48) | 0;
}

// AddFloatDouble(a: number, b: number): number
export function AddFloatDouble(a, b) {
  return a + b;
}

// AddIntFloat(a: number, b: number): number
export function AddIntFloat(a, b) {
  return Math.fround(Math.fround(a) + b);
}

// AddLongDouble(a: bigint, b: number): number
export function AddLongDouble(a, b) {
  return Number(a) + b;
