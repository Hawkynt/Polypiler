}

// ToDoubleUnsigned64(value: { hi, lo }): number
function ToDoubleUnsigned64(value) {
  return (value.hi * 4294967296) + value.lo;
}

// RemainderUnsigned32(dividend: number, divisor: number): number
function RemainderUnsigned32(dividend, divisor) {
