  return a !== b;
}

// LessSByte(a: number, b: number): boolean
export function LessSByte(a, b) {
  return a < b;
}

// LessOrEqualSByte(a: number, b: number): boolean
export function LessOrEqualSByte(a, b) {
  return a <= b;
}

// GreaterSByte(a: number, b: number): boolean
export function GreaterSByte(a, b) {
  return a > b;
}

// GreaterOrEqualSByte(a: number, b: number): boolean
export function GreaterOrEqualSByte(a, b) {
  return a >= b;
}

// ShiftLeftSByte(a: number, count: number): number
export function ShiftLeftSByte(a, count) {
  return a << count;
}

// ShiftRightSByte(a: number, count: number): number
export function ShiftRightSByte(a, count) {
  return a >> count;
}

// ShiftRightLogicalSByte(a: number, count: number): number
export function ShiftRightLogicalSByte(a, count) {
  return (a >>> count) | 0;
}

// NotSByte(a: number): number
export function NotSByte(a) {
  return ~a;
}

// PlusSByte(a: number): number
export function PlusSByte(a) {
  return a;
}

// NegateSByte(a: number): number
export function NegateSByte(a) {
  return -a | 0;
}

// AddAssignSByte(a: number, b: number): number
export function AddAssignSByte(a, b) {
  a = ((a + b) | 0) << 24 >> 24;
  return a;
}

// SubtractAssignSByte(a: number, b: number): number
export function SubtractAssignSByte(a, b) {
  a = ((a - b) | 0) << 24 >> 24;
  return a;
}

// MultiplyAssignSByte(a: number, b: number): number
export function MultiplyAssignSByte(a, b) {
  a = Math.imul(a, b) << 24 >> 24;
  return a;
}

// DivideAssignSByte(a: number, b: number): number
export function DivideAssignSByte(a, b) {
  a = $div(a, b) << 24 >> 24;
  return a;
}

// RemainderAssignSByte(a: number, b: number): number
export function RemainderAssignSByte(a, b) {
  a = $rem(a, b) << 24 >> 24;
  return a;
}

// AndAssignSByte(a: number, b: number): number
export function AndAssignSByte(a, b) {
  a = (a & b) << 24 >> 24;
  return a;
}

// OrAssignSByte(a: number, b: number): number
export function OrAssignSByte(a, b) {
  a = (a | b) << 24 >> 24;
  return a;
}

// XorAssignSByte(a: number, b: number): number
export function XorAssignSByte(a, b) {
  a = (a ^ b) << 24 >> 24;
  return a;
}

// ShiftLeftAssignSByte(a: number, count: number): number
export function ShiftLeftAssignSByte(a, count) {
  a = (a << count) << 24 >> 24;
  return a;
}

// ShiftRightAssignSByte(a: number, count: number): number
export function ShiftRightAssignSByte(a, count) {
  a = (a >> count) << 24 >> 24;
  return a;
}

// ShiftRightLogicalAssignSByte(a: number, count: number): number
export function ShiftRightLogicalAssignSByte(a, count) {
  a = ((a >>> count) | 0) << 24 >> 24;
  return a;
}

// IncrementSByte(a: number): number
export function IncrementSByte(a) {
  a = ((a + 1) | 0) << 24 >> 24;
  a = ((a + 1) | 0) << 24 >> 24;
  return a;
}

// DecrementSByte(a: number): number
export function DecrementSByte(a) {
  a = ((a - 1) | 0) << 24 >> 24;
  a = ((a - 1) | 0) << 24 >> 24;
  return a;
}

// ChooseSByte(first: boolean, a: number, b: number): number
export function ChooseSByte(first, a, b) {
  return first ? a : b;
}

// AddCheckedSByte(a: number, b: number): number
export function AddCheckedSByte(a, b) {
  return $ck(a + b, -2147483648, 2147483647);
}

// SubtractCheckedSByte(a: number, b: number): number
export function SubtractCheckedSByte(a, b) {
  return $ck(a - b, -2147483648, 2147483647);
}

// MultiplyCheckedSByte(a: number, b: number): number
export function MultiplyCheckedSByte(a, b) {
  return $ck(a * b, -2147483648, 2147483647) | 0;
}

// NegateCheckedSByte(a: number): number
export function NegateCheckedSByte(a) {
  return $ck(-a, -2147483648, 2147483647) | 0;
}

// AddAssignCheckedSByte(a: number, b: number): number
export function AddAssignCheckedSByte(a, b) {
  {
    a = $ck($ck(a + b, -2147483648, 2147483647), -128, 127);
  }
  return a;
}

