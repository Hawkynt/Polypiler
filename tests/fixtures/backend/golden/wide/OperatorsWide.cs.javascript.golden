// AddCheckedUInt(a: number, b: number): number
export function AddCheckedUInt(a, b) {
  return $ck(a + b, 0, 4294967295);
}

// SubtractCheckedUInt(a: number, b: number): number
export function SubtractCheckedUInt(a, b) {
  return $ck(a - b, 0, 4294967295);
}

// MultiplyCheckedUInt(a: number, b: number): number
export function MultiplyCheckedUInt(a, b) {
  return $ck(a * b, 0, 4294967295);
}

// NegateCheckedUInt(a: number): { hi, lo }
export function NegateCheckedUInt(a) {
  return $subck64s({ hi: 0, lo: 0 }, { hi: 0, lo: a });
}

// AddAssignCheckedUInt(a: number, b: number): number
export function AddAssignCheckedUInt(a, b) {
  {
    a = $ck(a + b, 0, 4294967295);
  }
  return a;
}

