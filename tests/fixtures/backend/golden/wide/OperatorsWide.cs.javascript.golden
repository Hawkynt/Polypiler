// SubtractCheckedUInt(a: number, b: number): number
export function SubtractCheckedUInt(a, b) {
  return SubtractCheckedUnsigned32(a, b, 4294967295);
}

// MultiplyCheckedUInt(a: number, b: number): number
export function MultiplyCheckedUInt(a, b) {
  return MultiplyCheckedUnsigned32(a, b, 4294967295);
}

// NegateCheckedUInt(a: number): { hi, lo }
export function NegateCheckedUInt(a) {
  return SubtractCheckedSigned64({ hi: 0, lo: 0 }, { hi: 0, lo: a });
}

// AddAssignCheckedUInt(a: number, b: number): number
export function AddAssignCheckedUInt(a, b) {
  {
    a = AddCheckedUnsigned32(a, b, 4294967295);
  }
  return a;
}

// SubtractAssignCheckedUInt(a: number, b: number): number
export function SubtractAssignCheckedUInt(a, b) {
  {
    a = SubtractCheckedUnsigned32(a, b, 4294967295);
  }
  return a;
}

// MultiplyAssignCheckedUInt(a: number, b: number): number
export function MultiplyAssignCheckedUInt(a, b) {
  {
    a = MultiplyCheckedUnsigned32(a, b, 4294967295);
  }
  return a;
}

// ShiftLeftAssignCheckedUInt(a: number, count: number): number
export function ShiftLeftAssignCheckedUInt(a, count) {
  {
    a = (a << count) >>> 0;
  }
  return a;
}

// IncrementCheckedUInt(a: number): number
export function IncrementCheckedUInt(a) {
  {
    a = AddCheckedUnsigned32(a, 1, 4294967295);
    a = AddCheckedUnsigned32(a, 1, 4294967295);
  }
  return a;
}

// DecrementCheckedUInt(a: number): number
export function DecrementCheckedUInt(a) {
  {
    a = SubtractCheckedUnsigned32(a, 1, 4294967295);
    a = SubtractCheckedUnsigned32(a, 1, 4294967295);
  }
  return a;
}

// UncheckedInsideCheckedUInt(a: number, b: number): number
export function UncheckedInsideCheckedUInt(a, b) {
  return SubtractCheckedUnsigned32((a + b) >>> 0, b, 4294967295);
}

