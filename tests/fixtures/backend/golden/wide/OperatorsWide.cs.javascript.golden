// Divide32(dividend: number, divisor: number, smallest: number): number
function Divide32(dividend, divisor, smallest) {
  CheckDivision32(dividend, divisor, smallest);
  return (dividend / divisor) | 0;
}

// Remainder32(dividend: number, divisor: number, smallest: number): number
function Remainder32(dividend, divisor, smallest) {
  CheckDivision32(dividend, divisor, smallest);
  return (dividend % divisor) | 0;
}

// AddChecked32(left: number, right: number, low: number, high: number): number
function AddChecked32(left, right, low, high) {
  return Checked32(left + right, low, high);
}

// SubtractChecked32(left: number, right: number, low: number, high: number): number
function SubtractChecked32(left, right, low, high) {
  return Checked32(left - right, low, high);
}

// MultiplyChecked32(left: number, right: number, low: number, high: number): number
function MultiplyChecked32(left, right, low, high) {
  return Checked32(left * right, low, high);
}

// CheckRange32(value: number, low: number, high: number): number
function CheckRange32(value, low, high) {
  if ((value < low) || (value > high)) {
    throw new OverflowError("integer overflow");
  }
  return value;
}

