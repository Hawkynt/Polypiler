// AddSByte(a: number, b: number): number
export function AddSByte(a, b) {
  return (a + b) | 0;
}

// SubtractSByte(a: number, b: number): number
export function SubtractSByte(a, b) {
  return (a - b) | 0;
}

// MultiplySByte(a: number, b: number): number
export function MultiplySByte(a, b) {
  return Math.imul(a, b);
}

// DivideSByte(a: number, b: number): number
export function DivideSByte(a, b) {
  return $div(a, b);
}

// RemainderSByte(a: number, b: number): number
export function RemainderSByte(a, b) {
  return $rem(a, b);
}

// AndSByte(a: number, b: number): number
export function AndSByte(a, b) {
  return a & b;
}

// OrSByte(a: number, b: number): number
export function OrSByte(a, b) {
  return a | b;
}

// XorSByte(a: number, b: number): number
export function XorSByte(a, b) {
  return a ^ b;
}

// EqualSByte(a: number, b: number): boolean
export function EqualSByte(a, b) {
  return a === b;
}

