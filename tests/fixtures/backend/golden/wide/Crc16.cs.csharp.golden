// Crc16: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public static class Crc16 {

  public static ushort Compute(byte[] data) {
    unchecked {
      ushort crc = 65535;
      {
        int i = 0;
        while (i < data.Length) {
          crc = (ushort)(crc ^ (ushort)(data[i] << 8));
          {
            int bit = 0;
            while (bit < 8) {
              if ((crc & 32768) != 0) {
                crc = (ushort)((crc << 1) ^ 4129);
              } else {
                crc = (ushort)(crc << 1);
              }
              bit = bit + 1;
            }
          }
          i = i + 1;
        }
      }
      return crc;
    }
  }

}
