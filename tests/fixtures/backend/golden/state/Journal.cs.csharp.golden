public static class Journal {

  private static string _text = "";

  private static readonly string[] _ring = new string[] { "", "", "", "" };

  private static int _count = 0;

  public static int Add(int code) {
    unchecked {
      _text = string.Concat(_text, char.ToString((char)((ushort)code)));
      _ring[_count & 3] = _text;
      _count = _count + 1;
      return _text.Length;
    }
  }

  public static string Back(int steps) {
    unchecked {
      return _ring[(_count - steps) & 3];
    }
  }

}
