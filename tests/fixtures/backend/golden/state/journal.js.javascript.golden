// journal: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

function $get(array, index) {
  if (index < 0 || index >= array.length) throw new RangeError("index out of range");
  return array[index];
}

function $set(array, index, value) {
  if (index < 0 || index >= array.length) throw new RangeError("index out of range");
  array[index] = value;
}

var text = "";
var ring = ["", "", "", ""];
var count = 0;

// add(code: number): number
function add(code) {
  text = text + String.fromCharCode((code >>> 0) & 0xFFFF);
  $set(ring, count & 3, text);
  count = (count + 1) | 0;
  return text.length;
}

// back(steps: number): string
function back(steps) {
  return $get(ring, ((count - steps) | 0) & 3);
}

exports.add = add;
exports.back = back;
