// Journal: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

function $get(array, index) {
  if (index < 0 || index >= array.length) throw new RangeError("index out of range");
  return array[index];
}

function $set(array, index, value) {
  if (index < 0 || index >= array.length) throw new RangeError("index out of range");
  array[index] = value;
}

var _text = "";
var _ring = ["", "", "", ""];
var _count = 0;

// Add(code: number): number
function Add(code) {
  _text = _text + String.fromCharCode(code & 0xFFFF);
  $set(_ring, _count & 3, _text);
  _count = (_count + 1) | 0;
  return _text.length;
}

// Back(steps: number): string
function Back(steps) {
  return $get(_ring, ((_count - steps) | 0) & 3);
}

exports.Add = Add;
exports.Back = Back;
