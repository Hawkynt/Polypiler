// histogram: generated by polypiler. Change the source, not this file.
// JavaScript profile: es2015, esm.

class ArithmeticError extends RangeError {
  constructor(message) {
    super(message);
    this.name = "ArithmeticError";
  }
}

class OverflowError extends ArithmeticError {
  constructor(message) {
    super(message);
    this.name = "OverflowError";
  }
}

class IndexOutOfRangeError extends RangeError {
  constructor(message) {
    super(message);
    this.name = "IndexOutOfRangeError";
  }
}

function $get(array, index) {
  if (index < 0 || index >= array.length) throw new IndexOutOfRangeError("index out of range");
  return array[index];
}

function $set(array, index, value) {
  if (index < 0 || index >= array.length) throw new IndexOutOfRangeError("index out of range");
  array[index] = value;
}

function $len(length) {
  if (length < 0) throw new OverflowError("integer overflow");
  return length;
}

const buckets = new Uint32Array($len(4));

// add(value: number): number
export function add(value) {
  let bucket = (value & 3) & 0xFF;
  $set(buckets, bucket, ($get(buckets, bucket) + 1) >>> 0);
  return $get(buckets, bucket);
}
