// histogram: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

function ArithmeticError(message) {
  this.name = "ArithmeticError";
  this.message = message;
  this.stack = new RangeError(message).stack;
}
ArithmeticError.prototype = Object.create(RangeError.prototype);
ArithmeticError.prototype.constructor = ArithmeticError;

function OverflowError(message) {
  this.name = "OverflowError";
  this.message = message;
  this.stack = new RangeError(message).stack;
}
OverflowError.prototype = Object.create(ArithmeticError.prototype);
OverflowError.prototype.constructor = OverflowError;

function IndexOutOfRangeError(message) {
  this.name = "IndexOutOfRangeError";
  this.message = message;
  this.stack = new RangeError(message).stack;
}
IndexOutOfRangeError.prototype = Object.create(RangeError.prototype);
IndexOutOfRangeError.prototype.constructor = IndexOutOfRangeError;

function $get(array, index) {
  if (index < 0 || index >= array.length) throw new IndexOutOfRangeError("index out of range");
  return array[index];
}

function $set(array, index, value) {
  if (index < 0 || index >= array.length) throw new IndexOutOfRangeError("index out of range");
  array[index] = value;
}

function $new(length, zero) {
  var array = [];
  for (var index = 0; index < length; ++index) array[index] = zero;
  return array;
}

function $len(length) {
  if (length < 0) throw new OverflowError("integer overflow");
  return length;
}

var buckets = $new($len(4), 0);

// add(value: number): number
function add(value) {
  var bucket = (value & 3) & 0xFF;
  $set(buckets, bucket, ($get(buckets, bucket) + 1) >>> 0);
  return $get(buckets, bucket);
}

exports.add = add;
