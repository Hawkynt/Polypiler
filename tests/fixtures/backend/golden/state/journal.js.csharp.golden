public static class @journal {

  private static string text = "";

  private static readonly string[] ring = new string[] { "", "", "", "" };

  private static int count = 0;

  public static int add(int code) {
    unchecked {
      text = string.Concat(text, char.ToString((char)((ushort)(uint)code)));
      ring[count & 3] = text;
      count = count + 1;
      return text.Length;
    }
  }

  public static string back(int steps) {
    unchecked {
      return ring[(count - steps) & 3];
    }
  }

}
