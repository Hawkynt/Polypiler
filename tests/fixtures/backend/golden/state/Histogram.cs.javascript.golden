  array[index] = value;
}

function $len(length) {
  if (length < 0) throw new RangeError("integer overflow");
  return length;
}

const _buckets = new Uint32Array($len(4));

// Add(value: number): number
export function Add(value) {
  let bucket = value & 3;
  $set(_buckets, bucket, ($get(_buckets, bucket) + 1) >>> 0);
  return $get(_buckets, bucket);
}
