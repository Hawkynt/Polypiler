// Histogram: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

function $get(array, index) {
  if (index < 0 || index >= array.length) throw new RangeError("index out of range");
  return array[index];
}

function $set(array, index, value) {
  if (index < 0 || index >= array.length) throw new RangeError("index out of range");
  array[index] = value;
}

function $new(length, zero) {
  var array = [];
  for (var index = 0; index < length; ++index) array[index] = zero;
  return array;
}

function $len(length) {
  if (length < 0) throw new RangeError("integer overflow");
  return length;
}

var _buckets = $new($len(4), 0);

// Add(value: number): number
function Add(value) {
  var bucket = value & 3;
  $set(_buckets, bucket, ($get(_buckets, bucket) + 1) >>> 0);
  return $get(_buckets, bucket);
}

exports.Add = Add;
