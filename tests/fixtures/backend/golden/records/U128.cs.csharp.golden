#### net2.0+accurate Wide128.cs 754
// Wide128: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public struct U128 {

  public ulong Lo;
  public ulong Hi;

  public U128(ulong Lo, ulong Hi) {
    this.Lo = Lo;
    this.Hi = Hi;
  }

}

public static class Wide128 {

  public static U128 Add(U128 a, U128 b) {
    unchecked {
      U128 sum = new U128();
      sum.Lo = a.Lo + b.Lo;
      sum.Hi = (a.Hi + b.Hi) + ((sum.Lo < a.Lo) ? 1UL : 0UL);
      return sum;
    }
  }

  public static ulong AddLo(ulong aLo, ulong aHi, ulong bLo, ulong bHi) {
    return Add(new U128(aLo, aHi), new U128(bLo, bHi)).Lo;
  }

  public static ulong AddHi(ulong aLo, ulong aHi, ulong bLo, ulong bHi) {
    return Add(new U128(aLo, aHi), new U128(bLo, bHi)).Hi;
  }

}
