var Golden = (function () {
  "use strict";

  // Add(a: U128, b: U128): U128
  function Add(a, b) {
    let sum = { Lo: 0n, Hi: 0n };
    sum.Lo = BigInt.asUintN(64, a.Lo + b.Lo);
    sum.Hi = BigInt.asUintN(64, BigInt.asUintN(64, a.Hi + b.Hi) + ((sum.Lo < a.Lo) ? 1n : 0n));
    return sum;
  }

  // AddLo(aLo: bigint, aHi: bigint, bLo: bigint, bHi: bigint): bigint
  function AddLo(aLo, aHi, bLo, bHi) {
    return Add({ Lo: aLo, Hi: aHi }, { Lo: bLo, Hi: bHi }).Lo;
  }

  // AddHi(aLo: bigint, aHi: bigint, bLo: bigint, bHi: bigint): bigint
  function AddHi(aLo, aHi, bLo, bHi) {
    return Add({ Lo: aLo, Hi: aHi }, { Lo: bLo, Hi: bHi }).Hi;
  }

  return {
    Add: Add,
    AddLo: AddLo,
    AddHi: AddHi
  };
})();
