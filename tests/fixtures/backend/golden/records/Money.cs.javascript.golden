// A 64-bit integer is an object { hi, lo }: its upper and its lower 32 bits, each as an unsigned number.
// A struct is an object of its fields, copied wherever the place it is read from can still be used.
"use strict";

function $add64(a, b) {
  var lo = a.lo + b.lo;
  return { hi: (a.hi + b.hi + (lo > 4294967295 ? 1 : 0)) >>> 0, lo: lo >>> 0 };
}

function $eq64(a, b) {
  return a.hi === b.hi && a.lo === b.lo;
}

function $equals_Money(a, b) {
  return $eq64(a.Cents, b.Cents) && a.Currency === b.Currency;
}

function $equals_P2(a, b) {
  return (a.X === b.X || (a.X !== a.X && b.X !== b.X)) && (a.Y === b.Y || (a.Y !== a.Y && b.Y !== b.Y));
}

var Euro = 978;

// Same(a: { hi, lo }, b: { hi, lo }): boolean
function Same(a, b) {
  return $equals_Money({ Cents: a, Currency: 978 }, { Cents: b, Currency: 978 });
}

// Differs(a: { hi, lo }, currency: number): boolean
function Differs(a, currency) {
  return !$equals_Money({ Cents: a, Currency: 978 }, { Cents: a, Currency: currency });
}

// EqualsCall(a: { hi, lo }, b: { hi, lo }): boolean
function EqualsCall(a, b) {
  return $equals_Money({ Cents: a, Currency: 978 }, { Cents: b, Currency: 978 });
}

// NaNEqual(): boolean
function NaNEqual() {
  return $equals_P2({ X: NaN, Y: 0 }, { X: NaN, Y: -0 });
}

// PairEqual(x1: number, y1: number, x2: number, y2: number): boolean
function PairEqual(x1, y1, x2, y2) {
  return $equals_P2({ X: x1, Y: y1 }, { X: x2, Y: y2 });
}

// Deposit(cents: { hi, lo }, more: { hi, lo }): { hi, lo }
function Deposit(cents, more) {
  var account = { Cents: cents, Currency: 978 };
  account.Cents = $add64(account.Cents, more);
  var copy = { Cents: account.Cents, Currency: account.Currency };
  copy.Cents = { hi: 0, lo: 0 };
  return $add64(account.Cents, copy.Cents);
}

exports.Same = Same;
exports.Differs = Differs;
exports.EqualsCall = EqualsCall;
exports.NaNEqual = NaNEqual;
exports.PairEqual = PairEqual;
exports.Deposit = Deposit;
