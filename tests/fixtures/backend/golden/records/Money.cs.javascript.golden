export function Deposit(cents, more) {
  let account = { Cents: cents, Currency: 978 };
  account.Cents = BigInt.asIntN(64, account.Cents + more);
  let copy = { Cents: account.Cents, Currency: account.Currency };
  copy.Cents = 0n;
  return BigInt.asIntN(64, account.Cents + copy.Cents);
