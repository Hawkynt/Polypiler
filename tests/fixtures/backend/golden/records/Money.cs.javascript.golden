function $add64(a, b) {
  const lo = a.lo + b.lo;
  return { hi: (a.hi + b.hi + (lo > 4294967295 ? 1 : 0)) >>> 0, lo: lo >>> 0 };
}

function $eq64(a, b) {
  return a.hi === b.hi && a.lo === b.lo;
