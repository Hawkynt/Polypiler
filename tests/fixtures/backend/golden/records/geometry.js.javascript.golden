// geometry: generated by polypiler. Change the source, not this file.
// JavaScript profile: es2015, esm.
// A struct is an object of its fields, copied wherever the place it is read from can still be used.

function $f2ic(value, low, high) {
  const whole = Math.trunc(value);
  if (!(whole >= low && whole <= high)) throw new RangeError("integer overflow");
  return whole + 0;
}

function $get(array, index) {
  if (index < 0 || index >= array.length) throw new RangeError("index out of range");
  return array[index];
}

function $copy_Previous(value) {
  return { x: value.x, y: value.y };
}

// dot(point: Point, other: Point): number
function dot(point, other) {
  return (point.x * other.x) + (point.y * other.y);
}

// middle(a: Point, b: Point): Point
function middle(a, b) {
  let x = (a.x + b.x) / 2;
  let y = (a.y + b.y) / 2;
  return { x, y };
}

// dotOf(x1: number, y1: number, x2: number, y2: number): number
export function dotOf(x1, y1, x2, y2) {
  return dot({ x: x1, y: y1 }, { x: x2, y: y2 });
}

