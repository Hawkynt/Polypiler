  }

  // Mask(a: number): number
  function Mask(a) {
    return (a & 4278255360) >>> 0;
  }

  // Folded(a: number): number
  function Folded(a) {
    return (((a + 16) | 0) - 2147483647) | 0;
  }

  // HighBit(a: number): number
  function HighBit(a) {
    return (a | 2147483648) >>> 0;
