  function IncrementByte(a) {
    a = ((a + 1) | 0) & 0xFF;
    a = ((a + 1) | 0) & 0xFF;
    return a;
  }

  // DecrementByte(a: number): number
  function DecrementByte(a) {
    a = ((a - 1) | 0) & 0xFF;
    a = ((a - 1) | 0) & 0xFF;
    return a;
