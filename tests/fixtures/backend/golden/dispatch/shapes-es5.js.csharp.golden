    double sum = shape.twice();
    shape = new Circle(radius);
    return sum + shape.twice();
  }

  public static double sumSides(double width, double height, double radius) {
    Shape shape = new Rect(width, height);
    int sum = shape.sides();
    shape = new Circle(radius);
    return (double)sum + (double)shape.sides();
  }

