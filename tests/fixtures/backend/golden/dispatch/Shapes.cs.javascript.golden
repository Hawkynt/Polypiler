  // SidesOf(shape: IShape): number
  function SidesOf(shape) {
    return shape.Sides();
  }

  // SumTwice(width: number, height: number, radius: number): number
  function SumTwice(width, height, radius) {
    return TwiceOf(new Rect(width, height)) + TwiceOf(new Circle(radius));
  }

  // SumSides(width: number, height: number, radius: number): number
  function SumSides(width, height, radius) {
    return (SidesOf(new Rect(width, height)) + SidesOf(new Circle(radius))) | 0;
  }

  // AreaThroughInterface(width: number, height: number): number
  function AreaThroughInterface(width, height) {
    let shape = new Rect(width, height);
    return shape.Area();
  }

  // IsRect(radius: number): boolean
  function IsRect(radius) {
    let o = new Circle(radius);
    return o instanceof Rect;
  }

  // IsShape(radius: number): boolean
  function IsShape(radius) {
    let o = new Circle(radius);
    return o != null && o.$is_IShape === true;
  }

  // AsRectIsNull(radius: number): boolean
  function AsRectIsNull(radius) {
    let o = new Circle(radius);
    return (o instanceof Rect ? o : null) === null;
  }

  // CastToRect(radius: number): number
  function CastToRect(radius) {
    let o = new Circle(radius);
    return $cast_Rect(o).Area();
  }

  // CastToCircle(radius: number): number
  function CastToCircle(radius) {
    let o = new Circle(radius);
    return $cast_Circle(o).Area();
  }

  // CastOfNull(): boolean
  function CastOfNull() {
    let o = null;
    let rect = $cast_Rect(o);
    return (rect === null) && (!(o instanceof Shape));
  }

  // Pattern(width: number, height: number, makeRect: boolean): number
  function Pattern(width, height, makeRect) {
    let o = new Circle(width);
    if (makeRect) {
      o = new Rect(width, height);
    }
    if (o instanceof Rect) {
      let rect = $cast_Rect(o);
      return rect.Area() + 100;
    }
    return o.Area();
  }

  return {
    SumTwice: SumTwice,
    SumSides: SumSides,
    AreaThroughInterface: AreaThroughInterface,
    IsRect: IsRect,
    IsShape: IsShape,
    AsRectIsNull: AsRectIsNull,
    CastToRect: CastToRect,
    CastToCircle: CastToCircle,
    CastOfNull: CastOfNull,
    Pattern: Pattern,
    Shape: Shape,
    Rect: Rect,
    Circle: Circle
  };
})();
