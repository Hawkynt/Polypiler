    public Shape() {
    }

    public virtual double area() => 0.0;

    public virtual int sides() => 0;

    public double twice() => 2.0 * this.area();

  }

  public sealed class Rect : Shape {

    public double width;

    public double height;

    public Rect(double width, double height) {
      this.width = width;
      this.height = height;
    }

    public override double area() => this.width * this.height;

    public override int sides() => 4;

  }

  public sealed class Circle : Shape {

    public double radius;

    public Circle(double radius) {
      this.radius = radius;
    }

    public override double area() => (3.0 * this.radius) * this.radius;

  }

  public static class @shapes {

    internal static double twiceOf(Shape shape) => shape.twice();

    internal static int sidesOf(Shape shape) => shape.sides();

    public static double sumTwice(double width, double height, double radius) => twiceOf(new Rect(width, height)) + twiceOf(new Circle(radius));

    public static double sumSides(double width, double height, double radius) => (double)sidesOf(new Rect(width, height)) + (double)sidesOf(new Circle(radius));

    public static bool isRect(double radius, double makeRect) {
      Shape shape = new Circle(radius);
      if (global::System.Math.Abs(makeRect) > 0.0) {
        shape = new Rect(radius, radius);
      }
      return shape is Rect;
    }

  }

}
