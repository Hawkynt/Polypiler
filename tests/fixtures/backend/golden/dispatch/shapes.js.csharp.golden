// shapes: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public class Shape {

  public Shape() {
  }

  public virtual double area() {
    return 0.0;
  }

  public virtual int sides() {
    return 0;
  }

  public double twice() {
    return 2.0 * this.area();
  }

}

public sealed class Rect : Shape {

  public double width;

  public double height;

  public Rect(double width, double height) {
    this.width = width;
    this.height = height;
  }

  public override double area() {
    return this.width * this.height;
  }

  public override int sides() {
    return 4;
  }

}

public sealed class Circle : Shape {

  public double radius;

  public Circle(double radius) {
    this.radius = radius;
  }

  public override double area() {
    return (3.0 * this.radius) * this.radius;
  }

}

public static class @shapes {

  internal static double twiceOf(Shape shape) {
    return shape.twice();
  }

  internal static int sidesOf(Shape shape) {
    return shape.sides();
  }

  public static double sumTwice(double width, double height, double radius) {
    return twiceOf(new Rect(width, height)) + twiceOf(new Circle(radius));
  }

  public static double sumSides(double width, double height, double radius) {
    return (double)sidesOf(new Rect(width, height)) + (double)sidesOf(new Circle(radius));
  }

  public static bool isRect(double radius, double makeRect) {
    Shape shape = new Circle(radius);
    if (global::System.Math.Abs(makeRect) > 0.0) {
      shape = new Rect(radius, radius);
    }
    return shape is Rect;
  }

}
