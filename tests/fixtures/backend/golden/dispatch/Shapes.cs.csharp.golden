// ShapesDemo: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public interface IShape {

  double Area();

  int Sides();

}

public abstract class Shape : IShape {

  protected Shape() {
  }

  public abstract double Area();

  public virtual int Sides() {
    return 0;
  }

  public double Twice() {
    return 2.0 * this.Area();
  }

}

public sealed class Rect : Shape {

  private readonly double _width;

  private readonly double _height;

  public Rect(double width, double height) {
    this._width = width;
    this._height = height;
  }

  public override double Area() {
    return this._width * this._height;
  }

  public override int Sides() {
    return 4;
  }

}

public sealed class Circle : Shape {

  private readonly double _radius;

  public Circle(double radius) {
    this._radius = radius;
  }

  public override double Area() {
    return (3.0 * this._radius) * this._radius;
  }

}

public static class ShapesDemo {

  internal static double TwiceOf(Shape shape) {
    return shape.Twice();
  }

  internal static int SidesOf(IShape shape) {
    return shape.Sides();
  }

  public static double SumTwice(double width, double height, double radius) {
    return TwiceOf(new Rect(width, height)) + TwiceOf(new Circle(radius));
  }

  public static int SumSides(double width, double height, double radius) {
    unchecked {
      return SidesOf(new Rect(width, height)) + SidesOf(new Circle(radius));
    }
  }

  public static double AreaThroughInterface(double width, double height) {
    IShape shape = new Rect(width, height);
    return shape.Area();
  }

  public static bool IsRect(double radius) {
    Shape o = new Circle(radius);
    return o is Rect;
  }

  public static bool IsShape(double radius) {
    Shape o = new Circle(radius);
    return o is IShape;
  }

  public static bool AsRectIsNull(double radius) {
    Shape o = new Circle(radius);
    return (o as Rect) == null;
  }

  public static double CastToRect(double radius) {
    Shape o = new Circle(radius);
    return ((Rect)o).Area();
  }

  public static double CastToCircle(double radius) {
    Shape o = new Circle(radius);
    return ((Circle)o).Area();
  }

  public static bool CastOfNull() {
    Shape o = null;
    Rect rect = (Rect)o;
    return (rect == null) && !(o is Shape);
  }

  public static double Pattern(double width, double height, bool makeRect) {
    Shape o = new Circle(width);
    if (makeRect) {
      o = new Rect(width, height);
    }
    if (o is Rect) {
      Rect rect = (Rect)o;
      return rect.Area() + 100.0;
    }
    return o.Area();
  }

}
