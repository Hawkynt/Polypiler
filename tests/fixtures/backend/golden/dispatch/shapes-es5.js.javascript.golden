    return 2 * this.area();
  }
}

// class Rect
export class Rect extends Shape {
  constructor(width, height) {
    super();
    this.width = 0;
    this.height = 0;
    this.width = width;
    this.height = height;
  }
  area() {
    return this.width * this.height;
  }
  sides() {
    return 4;
  }
}

// class Circle
export class Circle extends Shape {
  constructor(radius) {
    super();
    this.radius = 0;
    this.radius = radius;
