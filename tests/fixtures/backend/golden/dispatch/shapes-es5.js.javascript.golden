"use strict";

// class Shape
function Shape() {
}
Shape.prototype.area = function () {
  return 0;
};
Shape.prototype.sides = function () {
  return 0;
};
Shape.prototype.twice = function () {
  return 2 * this.area();
};

// class Rect
function Rect(width, height) {
  this.width = 0;
  this.height = 0;
  Shape.call(this);
  this.width = width;
  this.height = height;
}
Rect.prototype = Object.create(Shape.prototype);
Rect.prototype.constructor = Rect;
Rect.prototype.area = function () {
  return this.width * this.height;
};
Rect.prototype.sides = function () {
  return 4;
};

// class Circle
function Circle(radius) {
  this.radius = 0;
  Shape.call(this);
  this.radius = radius;
}
Circle.prototype = Object.create(Shape.prototype);
Circle.prototype.constructor = Circle;
Circle.prototype.area = function () {
  return (3 * this.radius) * this.radius;
};

// sumTwice(width: number, height: number, radius: number): number
function sumTwice(width, height, radius) {
  var shape = new Rect(width, height);
  var sum = shape.twice();
  shape = new Circle(radius);
  return sum + shape.twice();
}

// sumSides(width: number, height: number, radius: number): number
function sumSides(width, height, radius) {
  var shape = new Rect(width, height);
  var sum = shape.sides();
  shape = new Circle(radius);
  return sum + shape.sides();
}

// isRect(radius: number, makeRect: number): boolean
function isRect(radius, makeRect) {
  var shape = new Circle(radius);
  if (Math.abs(makeRect) > 0) {
    shape = new Rect(radius, radius);
  }
  return shape instanceof Rect;
}

exports.sumTwice = sumTwice;
exports.sumSides = sumSides;
exports.isRect = isRect;
exports.Shape = Shape;
exports.Rect = Rect;
exports.Circle = Circle;
