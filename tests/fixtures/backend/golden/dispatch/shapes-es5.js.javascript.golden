// shapes-es5: generated by polypiler. Change the source, not this file.
// JavaScript profile: es2015, esm.

// class Shape
export class Shape {
  constructor() {
  }
  area() {
    return 0;
  }
  sides() {
    return 0;
  }
  twice() {
    return 2 * this.area();
  }
}

// class Rect
export class Rect extends Shape {
  constructor(width, height) {
    super();
    this.width = 0;
    this.height = 0;
    this.width = width;
    this.height = height;
  }
  area() {
    return this.width * this.height;
  }
  sides() {
    return 4;
  }
}

// class Circle
export class Circle extends Shape {
  constructor(radius) {
    super();
    this.radius = 0;
    this.radius = radius;
  }
  area() {
    return (3 * this.radius) * this.radius;
  }
}

// sumTwice(width: number, height: number, radius: number): number
export function sumTwice(width, height, radius) {
  let shape = new Rect(width, height);
  let sum = shape.twice();
  shape = new Circle(radius);
  return sum + shape.twice();
}

// sumSides(width: number, height: number, radius: number): number
export function sumSides(width, height, radius) {
  let shape = new Rect(width, height);
  let sum = shape.sides();
  shape = new Circle(radius);
  return sum + shape.sides();
}

// isRect(radius: number, makeRect: number): boolean
export function isRect(radius, makeRect) {
  let shape = new Circle(radius);
  if (Math.abs(makeRect) > 0) {
    shape = new Rect(radius, radius);
  }
  return shape instanceof Rect;
}
