// class Animal
export class Animal {
  constructor() {
  }
  Legs() {
    return 0;
  }
  Base() {
    return 1;
  }
  Describe() {
    return (Math.imul(this.Legs(), 10) + this.Base()) | 0;
  }
}

// class Dog
export class Dog extends Animal {
  constructor() {
    super();
  }
  Legs() {
    return 4;
  }
  Base() {
    return (super.Base() + 1) | 0;
  }
}

// DogDescribe(): number
export function DogDescribe() {
  return new Dog().Describe();
}

// AnimalDescribe(): number
export function AnimalDescribe() {
  return new Animal().Describe();
}
