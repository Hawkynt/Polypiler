// AnimalsDemo: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

function $imul(a, b) {
  var high = (a >>> 16) & 0xFFFF;
  var low = a & 0xFFFF;
  return (low * (b & 0xFFFF) + (((high * (b & 0xFFFF) + low * ((b >>> 16) & 0xFFFF)) << 16) >>> 0)) | 0;
}

// class Animal
function Animal() {
}
Animal.prototype.Legs = function () {
  return 0;
};
Animal.prototype.Base = function () {
  return 1;
};
Animal.prototype.Describe = function () {
  return ($imul(this.Legs(), 10) + this.Base()) | 0;
};

// class Dog
function Dog() {
  Animal.call(this);
}
Dog.prototype = Object.create(Animal.prototype);
Dog.prototype.constructor = Dog;
Dog.prototype.Legs = function () {
  return 4;
};
Dog.prototype.Base = function () {
  return (Animal.prototype.Base.call(this) + 1) | 0;
};

// DogDescribe(): number
function DogDescribe() {
  return new Dog().Describe();
}

// AnimalDescribe(): number
function AnimalDescribe() {
  return new Animal().Describe();
}

exports.DogDescribe = DogDescribe;
exports.AnimalDescribe = AnimalDescribe;
exports.Animal = Animal;
exports.Dog = Dog;
