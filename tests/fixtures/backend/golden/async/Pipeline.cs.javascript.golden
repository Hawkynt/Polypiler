  }

  // Observed(before: boolean): Promise<string>
  async function Observed(before) {
    let trace = "t1";
    try {
      trace = trace + " " + (await Thrower(before));
    } catch (e) {
      if (e instanceof InvalidOperationError) {
        trace = trace + " caught " + e.message;
      } else {
        throw e;
      }
    } finally {
      trace = trace + " finally";
    }
    return trace;
  }

  // Valued(x: number): Promise<number>
  async function Valued(x) {
    await void 0;
    return (x + 1) | 0;
  }

  // UsesValued(): Promise<number>
  async function UsesValued() {
    return await Valued(41);
  }

  // Touch(): Promise<void>
  async function Touch() {
    await void 0;
  }

  // Both(): Promise<number>
  async function Both() {
    await $whenAll([Touch(), Touch()]);
    await Touch();
    return 2;
  }

  return {
    Step: Step,
    Run: Run,
    Completed: Completed,
    Squares: Squares,
    NoSquares: NoSquares,
    OneSquare: OneSquare,
    Faults: Faults,
    Observed: Observed,
    Valued: Valued,
    UsesValued: UsesValued,
    Both: Both
  };
})();
