class IndexOutOfRangeError extends RangeError {
  constructor(message) {
    super(message);
    this.name = "IndexOutOfRangeError";
  }
}

function $get(array, index) {
  if (index < 0 || index >= array.length) throw new IndexOutOfRangeError("index out of range");
  return array[index];
}

// Fold(a: Float64Array, seed: number, step: function): number
function Fold(a, seed, step) {
  let result = seed;
  {
    let $t1 = 0;
    while ($t1 < a.length) {
      let v = $get(a, $t1);
      result = step(result, v);
      $t1 = ($t1 + 1) | 0;
    }
  }
  return result;
}

// Sum(a: Float64Array): number
export function Sum(a) {
  return Fold(a, 0, (s, v) => s + v);
}

// SumOfSquares(a: Float64Array): number
export function SumOfSquares(a) {
  return Fold(a, 0, (s, v) => s + (v * v));
}

// Calls(a: Float64Array): number
export function Calls(a) {
  let calls = 0;
  Fold(a, 1, (s, v) => {
    calls = (calls + 1) | 0;
    return s * v;
  });
  return calls;
}
