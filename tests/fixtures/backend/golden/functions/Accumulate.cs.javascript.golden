"use strict";

function IndexOutOfRangeError(message) {
  this.name = "IndexOutOfRangeError";
  this.message = message;
  this.stack = new RangeError(message).stack;
}
IndexOutOfRangeError.prototype = Object.create(RangeError.prototype);
IndexOutOfRangeError.prototype.constructor = IndexOutOfRangeError;

function $get(array, index) {
  if (index < 0 || index >= array.length) throw new IndexOutOfRangeError("index out of range");
  return array[index];
}

// Fold(a: Array<number>, seed: number, step: function): number
function Fold(a, seed, step) {
  var result = seed;
  {
    var $t1 = 0;
    while ($t1 < a.length) {
      var v = $get(a, $t1);
      result = step(result, v);
      $t1 = ($t1 + 1) | 0;
    }
  }
  return result;
}

// Sum(a: Array<number>): number
function Sum(a) {
  return Fold(a, 0, function (s, v) {
    return s + v;
  });
}

// SumOfSquares(a: Array<number>): number
function SumOfSquares(a) {
  return Fold(a, 0, function (s, v) {
    return s + (v * v);
  });
}

// Calls(a: Array<number>): number
function Calls(a) {
  var calls = 0;
  Fold(a, 1, function (s, v) {
    calls = (calls + 1) | 0;
    return s * v;
  });
  return calls;
}

exports.Sum = Sum;
exports.SumOfSquares = SumOfSquares;
exports.Calls = Calls;
