// accumulate: generated by polypiler. Change the source, not this file.
// JavaScript profile: es2015, esm.

class ArithmeticError extends RangeError {
  constructor(message) {
    super(message);
    this.name = "ArithmeticError";
  }
}

class OverflowError extends ArithmeticError {
  constructor(message) {
    super(message);
    this.name = "OverflowError";
  }
}

class IndexOutOfRangeError extends RangeError {
  constructor(message) {
    super(message);
    this.name = "IndexOutOfRangeError";
  }
}

function $get(array, index) {
  if (index < 0 || index >= array.length) throw new IndexOutOfRangeError("index out of range");
  return array[index];
}

// fold(a: Float64Array, seed: number, step: function): number
function fold(a, seed, step) {
  let result = seed;
  {
    let i = 0;
    while (i < a.length) {
      result = step(result, $get(a, FromDoubleChecked32(i, -2147483648, 2147483647)));
      i = i + 1;
    }
  }
  return result;
}

// sum(a: Float64Array): number
export function sum(a) {
  return fold(a, 0, (s, v) => s + v);
}

// sumOfSquares(a: Float64Array): number
export function sumOfSquares(a) {
  return fold(a, 0, (s, v) => s + (v * v));
}

// calls(a: Float64Array): number
export function calls(a) {
  let count = 0;
  fold(a, 1, (s, v) => {
    count = count + 1;
    return s * v;
  });
  return count;
}

// FromDoubleChecked32(value: number, low: number, high: number): number
function FromDoubleChecked32(value, low, high) {
  let whole = Math.trunc(value);
  if (!((whole >= low) && (whole <= high))) {
    throw new OverflowError("integer overflow");
  }
  return whole | 0;
}
