// Sorting: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public static class Sorting {

  private delegate int Int32Int32ToInt32(int a1, int a2);

  private static void InsertionSort(int[] a, Int32Int32ToInt32 compare) {
    unchecked {
      {
        int i = 1;
        while (i < a.Length) {
          int v = a[i];
          int j = i - 1;
          while ((j >= 0) && (compare(a[j], v) > 0)) {
            a[j + 1] = a[j];
            j = j - 1;
          }
          a[j + 1] = v;
          i = i + 1;
        }
      }
    }
  }

  public static int[] Ascending(int[] a) {
    InsertionSort(a, delegate (int x, int y) {
      return (x < y) ? -1 : ((x > y) ? 1 : 0);
    });
    return a;
  }

  public static int[] ByDistance(int[] a, int pivot) {
    unchecked {
      InsertionSort(a, delegate (int x, int y) {
        return global::System.Math.Abs(x - pivot) - global::System.Math.Abs(y - pivot);
      });
      return a;
    }
  }

}
