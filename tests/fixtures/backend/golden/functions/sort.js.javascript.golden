// sort: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

function $trunc(value) {
  return value < 0 ? Math.ceil(value) : Math.floor(value);
}

function $f2ic(value, low, high) {
  var whole = $trunc(value);
  if (!(whole >= low && whole <= high)) throw new RangeError("integer overflow");
  return whole + 0;
}

function $get(array, index) {
  if (index < 0 || index >= array.length) throw new RangeError("index out of range");
  return array[index];
}

function $set(array, index, value) {
  if (index < 0 || index >= array.length) throw new RangeError("index out of range");
  array[index] = value;
}

// insertionSort(a: Array<number>, compare: function): void
function insertionSort(a, compare) {
  {
    var i = 1;
    while (i < a.length) {
      var v = $get(a, $f2ic(i, -2147483648, 2147483647));
      var j = i - 1;
      while ((j >= 0) && (compare($get(a, $f2ic(j, -2147483648, 2147483647)), v) > 0)) {
        $set(a, $f2ic(j + 1, -2147483648, 2147483647), $get(a, $f2ic(j, -2147483648, 2147483647)));
        j = j - 1;
      }
      $set(a, $f2ic(j + 1, -2147483648, 2147483647), v);
      i = i + 1;
    }
  }
}

// ascending(a: Array<number>): Array<number>
function ascending(a) {
  insertionSort(a, function (x, y) {
    return (x < y) ? (-1) : ((x > y) ? 1 : 0);
  });
  return a;
}

// byDistance(a: Array<number>, pivot: number): Array<number>
function byDistance(a, pivot) {
  insertionSort(a, function (x, y) {
    return Math.abs(x - pivot) - Math.abs(y - pivot);
  });
  return a;
}

exports.ascending = ascending;
exports.byDistance = byDistance;
