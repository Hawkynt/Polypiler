    constructor(message) {
      super(message);
      this.name = "OverflowError";
    }
  }

  class IndexOutOfRangeError extends RangeError {
    constructor(message) {
      super(message);
      this.name = "IndexOutOfRangeError";
    }
  }

  function $get(array, index) {
    if (index < 0 || index >= array.length) throw new IndexOutOfRangeError("index out of range");
    return array[index];
  }

  function $set(array, index, value) {
    if (index < 0 || index >= array.length) throw new IndexOutOfRangeError("index out of range");
    array[index] = value;
  }

  // insertionSort(a: Int32Array, compare: function): void
  function insertionSort(a, compare) {
    {
      let i = 1;
      while (i < a.length) {
        let v = $get(a, FromDoubleChecked32(i, -2147483648, 2147483647));
        let j = i - 1;
        while ((j >= 0) && (compare($get(a, FromDoubleChecked32(j, -2147483648, 2147483647)), v) > 0)) {
          $set(a, FromDoubleChecked32(j + 1, -2147483648, 2147483647), $get(a, FromDoubleChecked32(j, -2147483648, 2147483647)));
          j = j - 1;
        }
        $set(a, FromDoubleChecked32(j + 1, -2147483648, 2147483647), v);
        i = i + 1;
      }
    }
  }

  // ascending(a: Int32Array): Int32Array
  function ascending(a) {
    insertionSort(a, (x, y) => (x < y) ? (-1) : ((x > y) ? 1 : 0));
    return a;
  }

  // byDistance(a: Int32Array, pivot: number): Int32Array
  function byDistance(a, pivot) {
    insertionSort(a, (x, y) => Math.abs(x - pivot) - Math.abs(y - pivot));
    return a;
  }

  // FromDoubleChecked32(value: number, low: number, high: number): number
  function FromDoubleChecked32(value, low, high) {
    let whole = Math.trunc(value);
    if (!((whole >= low) && (whole <= high))) {
      throw new OverflowError("integer overflow");
    }
    return whole | 0;
  }

  return {
    ascending: ascending,
    byDistance: byDistance
  };
})();
