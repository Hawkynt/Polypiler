public static class @sort {

  private delegate double Int32Int32ToDouble(int a1, int a2);

  private static void insertionSort(int[] a, Int32Int32ToDouble compare) {
    {
      double i = 1.0;
      while (i < (double)a.Length) {
        int v = a[checked((int)i)];
        double j = i - 1.0;
        while ((j >= 0.0) && (compare(a[checked((int)j)], v) > 0.0)) {
          a[checked((int)(j + 1.0))] = a[checked((int)j)];
          j = j - 1.0;
        }
        a[checked((int)(j + 1.0))] = v;
        i = i + 1.0;
      }
    }
  }

  public static int[] ascending(int[] a) {
    insertionSort(a, delegate (int x, int y) {
      return (double)((x < y) ? -1 : ((x > y) ? 1 : 0));
    });
    return a;
  }

  public static int[] byDistance(int[] a, double pivot) {
    insertionSort(a, delegate (int x, int y) {
      return global::System.Math.Abs((double)x - pivot) - global::System.Math.Abs((double)y - pivot);
    });
    return a;
  }

}
