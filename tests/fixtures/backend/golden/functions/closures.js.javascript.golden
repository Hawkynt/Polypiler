  const f = (m) => (m <= 1) ? 1 : (m * f(m - 1));
  return f(n);
}

// composed(x: number): number
export function composed(x) {
  const compose = (f, g) => (v) => g(f(v));
  return compose((v) => v + 1, (v) => v * 3)(x);
}

// callNull(): number
export function callNull() {
  let f = null;
  const g = () => 1;
  if (g() === 0) {
    f = g;
  }
  return f();
}
