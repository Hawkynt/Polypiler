// accumulate: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public static class @accumulate {

  private delegate double DoubleDoubleToDouble(double a1, double a2);

  private static double fold(double[] a, int seed, DoubleDoubleToDouble step) {
    double result = (double)seed;
    {
      double i = 0.0;
      while (i < (double)a.Length) {
        result = step(result, a[checked((int)i)]);
        i = i + 1.0;
      }
    }
    return result;
  }

  public static double sum(double[] a) {
    return fold(a, 0, delegate (double s, double v) {
      return s + v;
    });
  }

  public static double sumOfSquares(double[] a) {
    return fold(a, 0, delegate (double s, double v) {
      return s + (v * v);
    });
  }

  public static double calls(double[] a) {
    double count = 0.0;
    fold(a, 1, delegate (double s, double v) {
      count = count + 1.0;
      return s * v;
    });
    return count;
  }

}
