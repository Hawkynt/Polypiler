  array[index] = value;
}

function $abs(value, low) {
  if (value === low) throw new RangeError("integer overflow");
  return value < 0 ? -value : value;
}

// InsertionSort(a: Int32Array, compare: function): void
function InsertionSort(a, compare) {
  {
    let i = 1;
    while (i < a.length) {
      let v = $get(a, i);
      let j = (i - 1) | 0;
      while ((j >= 0) && (compare($get(a, j), v) > 0)) {
        $set(a, (j + 1) | 0, $get(a, j));
        j = (j - 1) | 0;
      }
      $set(a, (j + 1) | 0, v);
      i = (i + 1) | 0;
    }
  }
}

// Ascending(a: Int32Array): Int32Array
function Ascending(a) {
  InsertionSort(a, (x, y) => (x < y) ? (-1) : ((x > y) ? 1 : 0));
  return a;
}

// ByDistance(a: Int32Array, pivot: number): Int32Array
function ByDistance(a, pivot) {
  InsertionSort(a, (x, y) => ($abs((x - pivot) | 0, -2147483648) - $abs((y - pivot) | 0, -2147483648)) | 0);
  return a;
}

exports.Ascending = Ascending;
exports.ByDistance = ByDistance;
