// JavaScript profile: es2015, esm.

class ArithmeticError extends RangeError {
  constructor(message) {
    super(message);
    this.name = "ArithmeticError";
  }
}

class OverflowError extends ArithmeticError {
  constructor(message) {
    super(message);
    this.name = "OverflowError";
  }
}

class IndexOutOfRangeError extends RangeError {
  constructor(message) {
    super(message);
    this.name = "IndexOutOfRangeError";
  }
}

function $get(array, index) {
  if (index < 0 || index >= array.length) throw new IndexOutOfRangeError("index out of range");
  return array[index];
}

function $set(array, index, value) {
  if (index < 0 || index >= array.length) throw new IndexOutOfRangeError("index out of range");
  array[index] = value;
}

// InsertionSort(a: Int32Array, compare: function): void
function InsertionSort(a, compare) {
  {
    let i = 1;
    while (i < a.length) {
      let v = $get(a, i);
      let j = (i - 1) | 0;
      while ((j >= 0) && (compare($get(a, j), v) > 0)) {
        $set(a, (j + 1) | 0, $get(a, j));
        j = (j - 1) | 0;
      }
      $set(a, (j + 1) | 0, v);
      i = (i + 1) | 0;
    }
  }
}

// Ascending(a: Int32Array): Int32Array
export function Ascending(a) {
  InsertionSort(a, (x, y) => (x < y) ? (-1) : ((x > y) ? 1 : 0));
  return a;
}

// ByDistance(a: Int32Array, pivot: number): Int32Array
export function ByDistance(a, pivot) {
  InsertionSort(a, (x, y) => (AbsSigned32((x - pivot) | 0, -2147483648) - AbsSigned32((y - pivot) | 0, -2147483648)) | 0);
  return a;
}

// AbsSigned32(value: number, smallest: number): number
function AbsSigned32(value, smallest) {
  if (value === smallest) {
    throw new OverflowError("integer overflow");
  }
  return (value < 0) ? (-value | 0) : value;
}
