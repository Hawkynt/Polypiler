// Sorting: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

function ArithmeticError(message) {
  this.name = "ArithmeticError";
  this.message = message;
  this.stack = new RangeError(message).stack;
}
ArithmeticError.prototype = Object.create(RangeError.prototype);
ArithmeticError.prototype.constructor = ArithmeticError;

function OverflowError(message) {
  this.name = "OverflowError";
  this.message = message;
  this.stack = new RangeError(message).stack;
}
OverflowError.prototype = Object.create(ArithmeticError.prototype);
OverflowError.prototype.constructor = OverflowError;

function IndexOutOfRangeError(message) {
  this.name = "IndexOutOfRangeError";
  this.message = message;
  this.stack = new RangeError(message).stack;
}
IndexOutOfRangeError.prototype = Object.create(RangeError.prototype);
IndexOutOfRangeError.prototype.constructor = IndexOutOfRangeError;

function $get(array, index) {
  if (index < 0 || index >= array.length) throw new IndexOutOfRangeError("index out of range");
  return array[index];
}

function $set(array, index, value) {
  if (index < 0 || index >= array.length) throw new IndexOutOfRangeError("index out of range");
  array[index] = value;
}

// InsertionSort(a: Array<number>, compare: function): void
function InsertionSort(a, compare) {
  {
    var i = 1;
    while (i < a.length) {
      var v = $get(a, i);
      var j = (i - 1) | 0;
      while ((j >= 0) && (compare($get(a, j), v) > 0)) {
        $set(a, (j + 1) | 0, $get(a, j));
        j = (j - 1) | 0;
      }
      $set(a, (j + 1) | 0, v);
      i = (i + 1) | 0;
    }
  }
}

// Ascending(a: Array<number>): Array<number>
function Ascending(a) {
  InsertionSort(a, function (x, y) {
    return (x < y) ? (-1) : ((x > y) ? 1 : 0);
  });
  return a;
}

// ByDistance(a: Array<number>, pivot: number): Array<number>
function ByDistance(a, pivot) {
  InsertionSort(a, function (x, y) {
    return (AbsSigned32((x - pivot) | 0, -2147483648) - AbsSigned32((y - pivot) | 0, -2147483648)) | 0;
  });
  return a;
}

// AbsSigned32(value: number, smallest: number): number
function AbsSigned32(value, smallest) {
  if (value === smallest) {
    throw new OverflowError("integer overflow");
  }
  return (value < 0) ? (-value | 0) : value;
}

exports.Ascending = Ascending;
exports.ByDistance = ByDistance;
