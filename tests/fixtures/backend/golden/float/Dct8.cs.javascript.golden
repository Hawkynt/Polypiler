// Transform(input: Float64Array, output: Float64Array): void
export function Transform(input, output) {
  {
    let k = 0;
    while (k < 8) {
      let sum = 0;
      {
        let n = 0;
        while (n < 8) {
          sum = sum + ($get(input, n) * FloatCos(((3.141592653589793 * ((Math.imul(2, n) + 1) | 0)) * k) / 16));
          n = (n + 1) | 0;
        }
      }
      $set(output, k, sum * ((k === 0) ? Math.sqrt(0.125) : Math.sqrt(0.25)));
      k = (k + 1) | 0;
    }
  }
}

