          sum = Math.fround(sum + Math.fround($get(input, n) * FloatCosF(Math.fround(Math.fround(Math.fround(3.1415927410125732 * Math.fround((Math.imul(2, n) + 1) | 0)) * Math.fround(k)) / 16))));
