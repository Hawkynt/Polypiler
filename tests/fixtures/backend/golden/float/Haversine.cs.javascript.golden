// Distance(latitude1: number, longitude1: number, latitude2: number, longitude2: number, radius: number): number
export function Distance(latitude1, longitude1, latitude2, longitude2, radius) {
  let phi1 = FloatDegreesToRadians(latitude1);
  let phi2 = FloatDegreesToRadians(latitude2);
  let halfLatitude = Math.sin((phi2 - phi1) / 2);
  let halfLongitude = Math.sin(FloatDegreesToRadians(longitude2 - longitude1) / 2);
  let a = (halfLatitude * halfLatitude) + (((Math.cos(phi1) * Math.cos(phi2)) * halfLongitude) * halfLongitude);
  return (2 * radius) * FloatAtan2(Math.sqrt(a), Math.sqrt(1 - a));
}

// DistanceSingle(latitude1: number, longitude1: number, latitude2: number, longitude2: number, radius: number): number
export function DistanceSingle(latitude1, longitude1, latitude2, longitude2, radius) {
  let phi1 = FloatDegreesToRadiansF(latitude1);
  let phi2 = FloatDegreesToRadiansF(latitude2);
  let halfLatitude = Math.fround(Math.sin(Math.fround(Math.fround(phi2 - phi1) / 2)));
  let halfLongitude = Math.fround(Math.sin(Math.fround(FloatDegreesToRadiansF(Math.fround(longitude2 - longitude1)) / 2)));
  let a = Math.fround(Math.fround(halfLatitude * halfLatitude) + Math.fround(Math.fround(Math.fround(Math.fround(Math.cos(phi1)) * Math.fround(Math.cos(phi2))) * halfLongitude) * halfLongitude));
  return Math.fround(Math.fround(2 * radius) * Math.fround(Math.atan2(Math.fround(Math.sqrt(a)), Math.fround(Math.sqrt(Math.fround(1 - a))))));
}

// FloatDegreesToRadians(degrees: number): number
function FloatDegreesToRadians(degrees) {
  return (degrees * 3.141592653589793) / 180;
}

