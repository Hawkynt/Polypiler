  let halfLatitude = FloatSinF(Math.fround(Math.fround(phi2 - phi1) / 2));
  let halfLongitude = FloatSinF(Math.fround(FloatDegreesToRadiansF(Math.fround(longitude2 - longitude1)) / 2));
