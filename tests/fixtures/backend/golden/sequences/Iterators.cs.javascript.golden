    Step(t, r);
    return $get(t, 0);
  }

  // ThrowInside(): number
  function ThrowInside() {
    let t = new Int32Array($len(1));
    try {
      for (const v of Traced(t)) {
        throw new InvalidOperationError("in the body");
      }
    } catch ($e) {
      if ($e instanceof InvalidOperationError) {
        Step(t, 4);
      } else {
        throw $e;
      }
    }
    return $get(t, 0);
  }

  // NestedClose(): number
  function NestedClose() {
    let t = new Int32Array($len(1));
    for (const v of Outer(t)) {
      Step(t, v);
      break;
    }
    return $get(t, 0);
  }

  // NestedFull(): number
  function NestedFull() {
    let t = new Int32Array($len(1));
    for (const v of Outer(t)) {
      Step(t, v);
    }
    return $get(t, 0);
  }

  // Restarted(): number
  function Restarted() {
    let t = new Int32Array($len(1));
    let s = Down(2);
    for (const v of s) {
      Step(t, v);
    }
    for (const v of s) {
      Step(t, v);
    }
    return $get(t, 0);
  }

  // Taken(count: number): number
  function Taken(count) {
    return Sum(Take(Fib(), count));
  }

  // FromArray(): number
  function FromArray() {
    let digits = new Int32Array([4, 5, 6]);
    return (Sum(digits) + Math.imul(Sum(Take(digits, 2)), 100)) | 0;
  }

  // Longs(): bigint
  function Longs() {
    let sum = 0n;
    for (const v of Wide()) {
      sum = BigInt.asIntN(64, sum + v);
    }
    return sum;
  }

  // Floats(): number
  function Floats() {
    let product = 1;
    for (const v of Halves()) {
      product = product * v;
    }
    return $f2i(product * (-100), -2147483648, 2147483647);
  }

  // Truths(): number
  function Truths() {
    let t = new Int32Array($len(1));
    for (const b of Flags()) {
      Step(t, b ? 1 : 2);
    }
    return $get(t, 0);
  }

  // Objects(): number
  function Objects() {
    let t = new Int32Array($len(1));
    for (const c of Counters()) {
      Step(t, c.Start);
    }
    return $get(t, 0);
  }

  // Method(start: number): number
  function Method(start) {
    let counter = new Counter(start);
    let sum = 0;
    for (const v of counter.Upwards(3)) {
      sum = (Math.imul(sum, 10) + v) | 0;
    }
    return sum;
  }

  // Widened(): bigint
  function Widened() {
    let sum = 0n;
    for (const $t1 of Up(3)) {
      let v = BigInt($t1);
      sum = BigInt.asIntN(64, BigInt.asIntN(64, sum * 10n) + v);
    }
    return sum;
  }

  // Take(source: Iterable<number>, count: number): Iterable<number>
  function Take(source, count) {
    const $make = function* (source, count) {
      if (count <= 0) {
        return;
      }
      let taken = 0;
      for (const item of source) {
        yield item;
        if ((taken = (taken + 1) | 0) === count) {
          return;
        }
      }
    };
    return { [Symbol.iterator]: () => $make(source, count) };
  }

  return {
    EarlyBreak: EarlyBreak,
    Full: Full,
    Twice: Twice,
    FibSum: FibSum,
    Guard: Guard,
    Throws: Throws,
    Nested: Nested,
    Returned: Returned,
    ThrowInside: ThrowInside,
    NestedClose: NestedClose,
    NestedFull: NestedFull,
    Restarted: Restarted,
    Taken: Taken,
    FromArray: FromArray,
    Longs: Longs,
    Floats: Floats,
    Truths: Truths,
    Objects: Objects,
    Method: Method,
    Widened: Widened,
    Counter: Counter
  };
})();
