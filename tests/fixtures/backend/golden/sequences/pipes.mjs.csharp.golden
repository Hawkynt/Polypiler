  private static void _stableSort(int[] items, global::System.Func<int, int, int> compare) {
    unchecked {
      var n = items.Length;
      var buffer = new int[n];
      int width = 1;
      int low = 0;
      int middle = 0;
      int high = 0;
      int left = 0;
      int right_ = 0;
      int i = 0;
      while (width < n) {
        low = 0;
        while (low < (n - width)) {
          middle = low + width;
          if ((n - middle) > width) {
            high = middle + width;
          } else {
            high = n;
          }
          i = low;
          while (i < high) {
            buffer[i] = items[i];
            i = i + 1;
          }
          left = low;
          right_ = middle;
          i = low;
          while (i < high) {
            if (left >= middle) {
              items[i] = buffer[right_];
              right_ = right_ + 1;
            } else if (right_ >= high) {
              items[i] = buffer[left];
              left = left + 1;
            } else if (compare(buffer[right_], buffer[left]) < 0) {
              items[i] = buffer[right_];
              right_ = right_ + 1;
            } else {
              items[i] = buffer[left];
              left = left + 1;
            }
            i = i + 1;
          }
          low = high;
        }
        if (width >= (n - width)) {
          break;
        }
        width = width + width;
      }
    }
  }

