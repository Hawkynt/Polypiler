  return new Int32Array([Searches$IndexOf(a, 3), Searches$FirstOrDefaultWhere(a, (x) => x > 2), Searches$FindIndex(a, (x) => x > 2), Searches$AnyWhere(a, (x) => x < 0) ? 1 : 0, Searches$All(a, (x) => x > 0) ? 1 : 0]);
}

// ContainsNaN(): number
export function ContainsNaN() {
  return ContainsNaN$Contains(new Float64Array([1, NaN]), NaN) ? 1 : 0;
}

// FromList(): Int32Array
export function FromList() {
  let list = [];
  $lvadd(list, 4);
  $lvadd(list, 1);
  $lvadd(list, 3);
  return FromList$ToArray(list, (x) => x > 1, (x) => x);
}

// Words(): number
export function Words() {
  let words = ["b", "B", "a"];
  return (Words$First(words, (w) => w) === "B") ? 1 : 0;
}

// Deferred$Where(source: Int32Array, select: function, where: function): Iterable<number>
function Deferred$Where(source, select, where) {
  const $make = function* (source, select, where) {
    let i = 0;
    while (i < source.length) {
      let x = $get(source, i);
      i = (i + 1) | 0;
      let y = select(x);
      if (where(y)) {
        yield y;
      }
    }
  };
  return { [Symbol.iterator]: () => $make(source, select, where) };
}

// Deferred$First(source: Iterable<number>): number
function Deferred$First(source) {
  for (const x of source) {
    return x;
  }
  throw new InvalidOperationError("Sequence contains no elements");
}

// Trace$ToArray(source: Int32Array, select: function, where: function): Int32Array
function Trace$ToArray(source, select, where) {
