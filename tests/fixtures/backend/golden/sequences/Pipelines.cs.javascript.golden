// Terminals$Min(source: Int32Array): number
function Terminals$Min(source) {
  let has = false;
  let best = 0;
  let i = 0;
  while (i < source.length) {
    let x = $get(source, i);
    i = (i + 1) | 0;
    let v = x;
    if (has) {
      if (v < best) {
        best = v;
      }
    } else {
      has = true;
      best = v;
    }
  }
  if (!has) {
    throw new InvalidOperationError("Sequence contains no elements");
  }
  return best;
}

