// Window$ToArray(start: number, count: number, skip: number, take: number): Int32Array
function Window$ToArray(start, count, skip, take) {
  let list = [];
  if (!(take <= 0)) {
    let stop = false;
    let i = 0;
    let n = 0;
    let n2 = 0;
    while (i < count) {
      let x = (start + i) | 0;
      i = (i + 1) | 0;
      if (n < skip) {
        n = (n + 1) | 0;
      } else {
        n2 = (n2 + 1) | 0;
        $lvadd(list, x);
        if (n2 >= take) {
          stop = true;
        }
      }
      if (stop) {
        break;
      }
    }
  }
  return new Int32Array(list);
}

