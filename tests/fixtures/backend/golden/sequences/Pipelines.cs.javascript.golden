// Stable$ToArray(start: number, count: number, orderby: function, select: function): Int32Array
function Stable$ToArray(start, count, orderby, select) {
  let list = [];
  let buffer = [];
  let i = 0;
  while (i < count) {
    let x = (start + i) | 0;
    i = (i + 1) | 0;
    $lvadd(buffer, x);
  }
  let n = buffer.length;
  let keys = [];
  let k = 0;
  for (; k < n; k = (k + 1) | 0) {
    $lvadd(keys, orderby($lget(buffer, k)));
  }
  let order = new Int32Array($len(n));
  let k2 = 0;
  for (; k2 < n; k2 = (k2 + 1) | 0) {
    $set(order, k2, k2);
  }
  StableSort(order, (a, b) => {
    let c = 0;
    c = $compare($lget(keys, a), $lget(keys, b));
    if (c !== 0) {
      return c;
    }
    return 0;
  });
  let i2 = 0;
  while (i2 < buffer.length) {
    let x2 = $lget(buffer, $get(order, i2));
    i2 = (i2 + 1) | 0;
    let y = select(x2);
    $lvadd(list, y);
  }
  return new Int32Array(list);
}

