  let q = Nested$SelectMany2(new Int32Array([1, 2]), (x) => Nested$SelectMany(new Int32Array([Logged(log, Math.imul(x, 10))]), (y) => Nested$Select(new Int32Array([3, 4]), (z) => Logged(log, z) > 3, (z) => (((x + y) | 0) + z) | 0)));
