            copy = (copy + 1) | 0;
          }
        }
        let left = low;
        let right = middle;
        {
          let index = low;
          while (index < high) {
            if (left >= middle) {
              $set(items, index, $get(buffer, ($p = right, right = ($p + 1) | 0, $p)));
            } else if (right >= high) {
              $set(items, index, $get(buffer, ($p = left, left = ($p + 1) | 0, $p)));
            } else if (compare($get(buffer, right), $get(buffer, left)) < 0) {
              $set(items, index, $get(buffer, ($p = right, right = ($p + 1) | 0, $p)));
            } else {
              $set(items, index, $get(buffer, ($p = left, left = ($p + 1) | 0, $p)));
            }
            index = (index + 1) | 0;
          }
        }
        low = high;
      }
      if (width >= ((n - width) | 0)) {
        break;
      }
      width = (width + width) | 0;
    }
  }

  return {
    trace: trace,
    total: total,
    eager: eager,
    nanSearch: nanSearch,
    firstOver: firstOver,
    found: found,
    flat: flat,
    stable: stable,
    emptyReduce: emptyReduce,
    single: single,
    emptyTests: emptyTests,
    indexed: indexed,
    pushDuring: pushDuring,
    eagerThrow: eagerThrow,
    right: right,
    each: each,
    whole: whole,
    byName: byName
  };
})();
