// Adler32: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public static class Adler32 {

  public static uint Compute(byte[] data) {
    unchecked {
      uint a = 1;
      uint b = 0;
      {
        int i = 0;
        while (i < data.Length) {
          a = (a + (uint)data[i]) % 65521u;
          b = (b + a) % 65521u;
          i = i + 1;
        }
      }
      return (b << 16) | a;
    }
  }

}
