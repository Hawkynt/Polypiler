// hex: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public static class @hex {

  public static string hexadecimal(int value) {
    unchecked {
      return FormatRadix((long)value, true, 16, 0, false);
    }
  }

  public static string binary(int value) {
    unchecked {
      return FormatRadix((long)value, true, 2, 0, false);
    }
  }

  public static string base36(int value) {
    unchecked {
      return FormatRadix((long)value, true, 36, 0, false);
    }
  }

  public static string unsigned(int value) {
    unchecked {
      return FormatRadix((long)((uint)value), true, 16, 0, false);
    }
  }

  public static string wide(long value) {
    unchecked {
      return FormatRadix((long)value, true, 16, 0, false);
    }
  }

  private static string FormatRadix(long value, bool signed, int radix, int minDigits, bool upper) {
    unchecked {
      bool negative = signed && value < 0;
      ulong magnitude = negative ? (ulong)-value : (ulong)value;
      string digits = "";
      do {
        digits = "0123456789abcdefghijklmnopqrstuvwxyz"[(int)(magnitude % (ulong)radix)] + digits;
        magnitude /= (ulong)radix;
      } while (magnitude != 0);
      digits = digits.PadLeft(minDigits, "0"[0]);
      if (upper) digits = digits.ToUpper(global::System.Globalization.CultureInfo.InvariantCulture);
      return negative ? "-" + digits : digits;
    }
  }

}
