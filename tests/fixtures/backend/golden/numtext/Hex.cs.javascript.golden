// Binary(value: number): string
function Binary(value) {
  return (value >>> 0).toString(2);
}

// Octal(value: bigint): string
function Octal(value) {
  return BigInt.asUintN(64, value).toString(8);
}

// Padded(value: number): string
function Padded(value) {
  return $radix(value, 10, 5, false);
}

exports.Word = Word;
exports.Upper = Upper;
exports.Byte = Byte;
exports.Short = Short;
exports.Long = Long;
exports.Binary = Binary;
exports.Octal = Octal;
exports.Padded = Padded;
