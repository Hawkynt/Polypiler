// hex: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
// A 64-bit integer is an object { hi, lo }: its upper and its lower 32 bits, each as an unsigned number.
"use strict";

function $sub64(a, b) {
  var lo = a.lo - b.lo;
  return { hi: (a.hi - b.hi - (lo < 0 ? 1 : 0)) >>> 0, lo: lo >>> 0 };
}

function $neg64(value) {
  return $sub64({ hi: 0, lo: 0 }, value);
}

function $radix64(x, radix, min, upper, signed) {
  var negative = signed && x.hi >= 2147483648;
  var v = negative ? $neg64(x) : x;
  var w = [v.lo & 0xFFFF, v.lo >>> 16, v.hi & 0xFFFF, v.hi >>> 16];
  var s = "";
  do {
    var rest = 0;
    for (var k = 3; k >= 0; --k) {
      var t = rest * 65536 + w[k];
      w[k] = Math.floor(t / radix);
      rest = t - w[k] * radix;
    }
    s = "0123456789abcdefghijklmnopqrstuvwxyz".charAt(rest) + s;
  } while (w[0] !== 0 || w[1] !== 0 || w[2] !== 0 || w[3] !== 0);
  while (s.length < min) s = "0" + s;
  if (upper) s = s.toUpperCase();
  return negative ? "-" + s : s;
}

// hexadecimal(value: number): string
function hexadecimal(value) {
  return value.toString(16);
}

// binary(value: number): string
function binary(value) {
  return value.toString(2);
}

// base36(value: number): string
function base36(value) {
  return value.toString(36);
}

// unsigned(value: number): string
function unsigned(value) {
  return (value >>> 0).toString(16);
}

// wide(value: { hi, lo }): string
function wide(value) {
  return $radix64(value, 16, 0, false, true);
}

exports.hexadecimal = hexadecimal;
exports.binary = binary;
exports.base36 = base36;
exports.unsigned = unsigned;
exports.wide = wide;
