// parse: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

// number(s: string): number
function number(s) {
  return Number(s);
}

// plus(s: string): number
function plus(s) {
  return Number(s);
}

// float(s: string): number
function float(s) {
  return parseFloat(s);
}

// integer(s: string): number
function integer(s) {
  return parseInt(s);
}

// hex(s: string): number
function hex(s) {
  return parseInt(s, 16);
}

// base36(s: string): number
function base36(s) {
  return parseInt(s, 36);
}

exports.number = number;
exports.plus = plus;
exports.float = float;
exports.integer = integer;
exports.hex = hex;
exports.base36 = base36;
