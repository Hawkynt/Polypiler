    unchecked {
      return value.ToString("x2");
    }
  }

  public static string Short(short value) {
    unchecked {
      return value.ToString("x");
    }
  }

  public static string Long(long value) {
    unchecked {
      return value.ToString("X16");
    }
  }

  public static string Binary(int value) {
    unchecked {
      return FormatRadix((long)(uint)value, false, 2, 0, false);
    }
  }

  public static string Octal(long value) {
    unchecked {
      return FormatRadix((long)value, false, 8, 0, false);
    }
