}

// IsEven(n: number): boolean
export function IsEven(n) {
  return (n === 0) || IsOdd((n - 1) | 0);
}

// IsOdd(n: number): boolean
function IsOdd(n) {
  return (n !== 0) && IsEven((n - 1) | 0);
