// Halvings(value: number): number
export function Halvings(value) {
  let steps = 0;
  while (value > 0) {
    value = $div(value, 2);
    steps = (steps + 1) | 0;
  }
  return steps;
}

// IndexOf(data: Uint8Array, wanted: number): number
export function IndexOf(data, wanted) {
  {
