    super(message);
    this.name = "ArithmeticError";
  }
}

class OverflowError extends ArithmeticError {
  constructor(message) {
    super(message);
    this.name = "OverflowError";
  }
}

function $ck(value, low, high) {
  if (value < low || value > high) throw new OverflowError("integer overflow");
  return value;
}

function $f2i(value, low, high) {
  if (value !== value) return 0;
  return value <= low ? low : value >= high ? high : Math.trunc(value) + 0;
}

// Saturated(x: number): number
function Saturated(x) {
  return ClampSigned32(x, 0, 255) & 0xFF;
}

// SaturatedFromUnsigned(x: bigint): number
function SaturatedFromUnsigned(x) {
  return Number(BigInt.asIntN(8, ClampUnsigned64(x, 0n, 127n)));
}

// Truncated(x: bigint): number
function Truncated(x) {
  return Number(BigInt.asIntN(16, x));
}

// Checked(x: number): number
function Checked(x) {
  return $ck(x, 0, 2147483647);
}

// SaturatedFromDouble(x: number): number
function SaturatedFromDouble(x) {
  return $f2i(x, -2147483648, 2147483647);
}

// ClampSigned32(value: number, low: number, high: number): number
function ClampSigned32(value, low, high) {
  if (low > high) {
    throw new ArithmeticError("invalid operation");
  }
  return (value < low) ? low : ((value > high) ? high : value);
}

// ClampUnsigned64(value: bigint, low: bigint, high: bigint): bigint
function ClampUnsigned64(value, low, high) {
  if (low > high) {
    throw new ArithmeticError("invalid operation");
  }
  return (value < low) ? low : ((value > high) ? high : value);
}

exports.Saturated = Saturated;
exports.SaturatedFromUnsigned = SaturatedFromUnsigned;
exports.Truncated = Truncated;
exports.Checked = Checked;
exports.SaturatedFromDouble = SaturatedFromDouble;
