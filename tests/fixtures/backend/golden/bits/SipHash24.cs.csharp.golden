              v2 = global::System.Numerics.BitOperations.RotateLeft(v2, 32);
              round = round + 1;
            }
          }
          v0 = v0 ^ m;
          i = i + 8;
        }
      }
      var last = (ulong)data.Length << 56;
      {
        var i = whole;
        while (i < data.Length) {
          last = last | ((ulong)data[i] << (8 * (i - whole)));
          i = i + 1;
        }
      }
      v3 = v3 ^ last;
      {
        int round = 0;
        while (round < 2) {
          v0 = v0 + v1;
          v1 = global::System.Numerics.BitOperations.RotateLeft(v1, 13);
          v1 = v1 ^ v0;
          v0 = global::System.Numerics.BitOperations.RotateLeft(v0, 32);
          v2 = v2 + v3;
          v3 = global::System.Numerics.BitOperations.RotateLeft(v3, 16);
          v3 = v3 ^ v2;
          v0 = v0 + v3;
          v3 = global::System.Numerics.BitOperations.RotateLeft(v3, 21);
          v3 = v3 ^ v0;
          v2 = v2 + v1;
          v1 = global::System.Numerics.BitOperations.RotateLeft(v1, 17);
          v1 = v1 ^ v2;
          v2 = global::System.Numerics.BitOperations.RotateLeft(v2, 32);
          round = round + 1;
        }
      }
      v0 = v0 ^ last;
      v2 = v2 ^ 255UL;
      {
        int round = 0;
        while (round < 4) {
          v0 = v0 + v1;
          v1 = global::System.Numerics.BitOperations.RotateLeft(v1, 13);
          v1 = v1 ^ v0;
          v0 = global::System.Numerics.BitOperations.RotateLeft(v0, 32);
          v2 = v2 + v3;
          v3 = global::System.Numerics.BitOperations.RotateLeft(v3, 16);
          v3 = v3 ^ v2;
          v0 = v0 + v3;
          v3 = global::System.Numerics.BitOperations.RotateLeft(v3, 21);
          v3 = v3 ^ v0;
          v2 = v2 + v1;
          v1 = global::System.Numerics.BitOperations.RotateLeft(v1, 17);
          v1 = v1 ^ v2;
          v2 = global::System.Numerics.BitOperations.RotateLeft(v2, 32);
          round = round + 1;
        }
      }
      return ((v0 ^ v1) ^ v2) ^ v3;
    }
  }

}
