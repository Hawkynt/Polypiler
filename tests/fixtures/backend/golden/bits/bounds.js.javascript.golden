// bounds: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

function $sign(value) {
  return value < 0 ? -1 : value > 0 ? 1 : 0;
}

// magnitude(x: number): number
function magnitude(x) {
  return ((Math.abs(x)) | 0) >>> 0;
}

// magnitudeByte(x: number): number
function magnitudeByte(x) {
  return ((Math.abs(x)) << 24 >> 24) & 0xFF;
}

// smaller(a: number, b: number): number
function smaller(a, b) {
  return Math.min(a, b);
}

// largest(a: number, b: number, c: number): number
function largest(a, b, c) {
  return Math.max(Math.max(a, b), c);
}

// signum(x: number): number
function signum(x) {
  return $sign(x);
}

exports.magnitude = magnitude;
exports.magnitudeByte = magnitudeByte;
exports.smaller = smaller;
exports.largest = largest;
exports.signum = signum;
