// BitsWideMultiply: generated by polypiler. Change the source, not this file.
// JavaScript profile: es2020, esm.

// Signed(a: number, b: number): bigint
export function Signed(a, b) {
  return BigInt(a) * BigInt(b);
}

// Unsigned(a: number, b: number): bigint
export function Unsigned(a, b) {
  return BigInt(a) * BigInt(b);
}

// High(a: bigint, b: bigint): bigint
export function High(a, b) {
  let $t2 = BigInt.asUintN(64, a * b >> 64n);
  let $t3 = BigInt.asUintN(64, a * b);
  let low = $t3;
  let high = $t2;
  return high ^ (low >> 7n);
}

// HighSigned(a: bigint, b: bigint): bigint
export function HighSigned(a, b) {
  let low;
  let $t2 = BigInt.asIntN(64, a * b >> 64n);
  let $t3 = BigInt.asIntN(64, a * b);
  low = $t3;
  let high = $t2;
  return BigInt.asIntN(64, high - low);
}
