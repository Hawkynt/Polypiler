"use strict";

class ArithmeticError extends RangeError {
  constructor(message) {
    super(message);
    this.name = "ArithmeticError";
  }
}

// low12(x: bigint): bigint
function low12(x) {
  return ZeroExtend64(x, 12);
}

// signed20(x: bigint): bigint
function signed20(x) {
  return SignExtend64(BigInt.asUintN(64, x), 20);
}

// wrapped(x: bigint): bigint
function wrapped(x) {
  return BigInt.asIntN(64, BigInt.asIntN(64, x) * 3n);
}

// ZeroExtend64(value: bigint, bits: number): bigint
function ZeroExtend64(value, bits) {
  if ((bits < 1) || (bits > 64)) {
    throw new ArithmeticError("invalid operation");
  }
  return (bits === 64) ? value : (value & BigInt.asUintN(64, BigInt.asUintN(64, 1n << BigInt(bits & 63)) - 1n));
}

// SignExtend64(value: bigint, bits: number): bigint
function SignExtend64(value, bits) {
  if ((bits < 1) || (bits > 64)) {
    throw new ArithmeticError("invalid operation");
  }
  return BigInt.asIntN(64, BigInt.asUintN(64, value << BigInt(((64 - bits) | 0) & 63))) >> BigInt(((64 - bits) | 0) & 63);
}

exports.low12 = low12;
exports.signed20 = signed20;
exports.wrapped = wrapped;
