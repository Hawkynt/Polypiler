    v2 = v2 ^ 255n;
    {
      let round = 0;
      while (round < 4) {
        v0 = BigInt.asUintN(64, v0 + v1);
        v1 = RotateLeft64(v1, 13);
        v1 = v1 ^ v0;
        v0 = RotateLeft64(v0, 32);
        v2 = BigInt.asUintN(64, v2 + v3);
        v3 = RotateLeft64(v3, 16);
        v3 = v3 ^ v2;
        v0 = BigInt.asUintN(64, v0 + v3);
        v3 = RotateLeft64(v3, 21);
        v3 = v3 ^ v0;
        v2 = BigInt.asUintN(64, v2 + v1);
        v1 = RotateLeft64(v1, 17);
        v1 = v1 ^ v2;
        v2 = RotateLeft64(v2, 32);
        round = (round + 1) | 0;
      }
    }
    return ((v0 ^ v1) ^ v2) ^ v3;
  }

  // Load64(array: Uint8Array, index: number, little: boolean): bigint
  function Load64(array, index, little) {
    CheckBytes(array, index, 8);
    let value = 0n;
    {
      let offset = 0;
      while (offset < 8) {
        value = BigInt.asUintN(64, value << 8n) | BigInt($get(array, (index + (little ? ((7 - offset) | 0) : offset)) | 0));
        offset = (offset + 1) | 0;
      }
    }
    return value;
  }

  // RotateLeft64(value: bigint, count: number): bigint
  function RotateLeft64(value, count) {
    return BigInt.asUintN(64, value << BigInt(count & 63)) | (value >> BigInt(((-count | 0) & 63) & 63));
  }

  // CheckBytes(array: Uint8Array, index: number, size: number): void
  function CheckBytes(array, index, size) {
    if ((index < 0) || (index > ((array.length - size) | 0))) {
      throw new IndexOutOfRangeError("index out of range");
    }
  }

  return {
    Hash: Hash
  };
})();
