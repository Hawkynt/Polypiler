        value = BigInt.asUintN(64, value << 8n) | BigInt($get(array, (index + (little ? ((7 - offset) | 0) : offset)) | 0));
        offset = (offset + 1) | 0;
      }
    }
    return value;
  }

  // Remainder32(dividend: number, divisor: number, smallest: number): number
  function Remainder32(dividend, divisor, smallest) {
    CheckDivision32(dividend, divisor, smallest);
    return (dividend % divisor) | 0;
  }

  // RotateLeft64(value: bigint, count: number): bigint
  function RotateLeft64(value, count) {
    return BigInt.asUintN(64, value << BigInt(count & 63)) | (value >> BigInt(((-count | 0) & 63) & 63));
  }

  // CheckBytes(array: Uint8Array, index: number, size: number): void
  function CheckBytes(array, index, size) {
    if ((index < 0) || (index > ((array.length - size) | 0))) {
      throw new IndexOutOfRangeError("index out of range");
    }
  }

  // CheckDivision32(dividend: number, divisor: number, smallest: number): void
  function CheckDivision32(dividend, divisor, smallest) {
    if (divisor === 0) {
      throw new DivideByZeroError("divide by zero");
    }
    if ((divisor === (-1)) && (dividend === smallest)) {
      throw new OverflowError("integer overflow");
    }
  }

  return {
    Hash: Hash
  };
})();
