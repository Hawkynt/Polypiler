// BitsReordering: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public static class BitsReordering {

  public static uint Swap32(uint x) {
    unchecked {
      return (uint)ByteSwapBits((ulong)x, 32);
    }
  }

  public static short Swap16(short x) {
    unchecked {
      return (short)ByteSwapBits((ulong)(ushort)x, 16);
    }
  }

  public static ulong Swap64(ulong x) {
    unchecked {
      return (ulong)ByteSwapBits((ulong)x, 64);
    }
  }

  public static byte Swap8(byte x) {
    unchecked {
      return (byte)ByteSwapBits((ulong)x, 8);
    }
  }

  private static ulong ByteSwapBits(ulong value, int bits) {
    value = ((value & 0x00FF00FF00FF00FFUL) << 8) | ((value >> 8) & 0x00FF00FF00FF00FFUL);
    value = ((value & 0x0000FFFF0000FFFFUL) << 16) | ((value >> 16) & 0x0000FFFF0000FFFFUL);
    return ((value << 32) | (value >> 32)) >> (64 - bits);
  }

}
