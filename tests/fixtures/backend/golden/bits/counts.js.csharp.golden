    }
  }

  private static int LeadingZeroCount32(uint value) {
    unchecked {
      if (value == 0u) {
        return 32;
      }
      int count = 0;
      if (value <= 65535u) {
        count = count + 16;
        value = value << 16;
      }
      if (value <= 16777215u) {
        count = count + 8;
        value = value << 8;
      }
      if (value <= 268435455u) {
        count = count + 4;
        value = value << 4;
      }
      if (value <= 1073741823u) {
        count = count + 2;
        value = value << 2;
      }
      return (value <= 2147483647u) ? (count + 1) : count;
    }
  }

}
