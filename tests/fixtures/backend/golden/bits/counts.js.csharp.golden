// counts: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public static class @counts {

  public static int leading(uint x) {
    return LeadingZeroCount(x);
  }

  public static int leadingShort(short x) {
    unchecked {
      return LeadingZeroCount((uint)x);
    }
  }

  public static double log2(uint x) {
    unchecked {
      return 31.0 - (double)LeadingZeroCount((uint)((int)x | 1));
    }
  }

  private static int LeadingZeroCount(uint value) {
    if (value == 0u) {
      return 32;
    }
    int count = 0;
    if (value <= 0x0000FFFFu) { count += 16; value <<= 16; }
    if (value <= 0x00FFFFFFu) { count += 8; value <<= 8; }
    if (value <= 0x0FFFFFFFu) { count += 4; value <<= 4; }
    if (value <= 0x3FFFFFFFu) { count += 2; value <<= 2; }
    if (value <= 0x7FFFFFFFu) { count += 1; }
    return count;
  }

}
