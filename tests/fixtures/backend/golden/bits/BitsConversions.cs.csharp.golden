// BitsConversions: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public static class BitsConversions {

  public static byte Saturated(int x) {
    unchecked {
      return (byte)global::System.Math.Min(global::System.Math.Max(x, 0), 255);
    }
  }

  public static sbyte SaturatedFromUnsigned(ulong x) {
    unchecked {
      return (sbyte)global::System.Math.Min(global::System.Math.Max(x, 0UL), 127UL);
    }
  }

  public static short Truncated(long x) {
    unchecked {
      return (short)x;
    }
  }

  public static uint Checked(int x) {
    return checked((uint)x);
  }

  public static int SaturatedFromDouble(double x) {
    return Saturated_(x, -2147483648, 2147483647);
  }

  private static int Saturated_(double value, int low, int high) {
    return value >= high ? high : value > low ? (int)value : value <= low ? low : 0;
  }

}
