  return ByteSwap32(x);
}

// Swap16(x: number): number
export function Swap16(x) {
  return ByteSwap16(x >>> 0) << 16 >> 16;
}

// Swap64(x: { hi, lo }): { hi, lo }
export function Swap64(x) {
  return ByteSwap64(x);
}

// Swap8(x: number): number
