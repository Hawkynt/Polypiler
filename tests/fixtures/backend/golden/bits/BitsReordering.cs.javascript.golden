  return x;
}

// ByteSwap32(value: number): number
function ByteSwap32(value) {
  return (((((((value << 24) >>> 0) | ((((value & 65280) >>> 0) << 8) >>> 0)) >>> 0) | (((value >>> 8) & 65280) >>> 0)) >>> 0) | (value >>> 24)) >>> 0;
}

// ByteSwap16(value: number): number
function ByteSwap16(value) {
  return (((((value & 255) >>> 0) << 8) >>> 0) | (((value >>> 8) & 255) >>> 0)) >>> 0;
