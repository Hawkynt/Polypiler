#### net2.0+accurate BitsPowersOfTwo.cs 1150
// BitsPowersOfTwo: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public static class BitsPowersOfTwo {

  public static bool Power(int x) {
    return IsPow2Signed32(x);
  }

  public static bool PowerShort(short x) {
    return IsPow2Signed32(x);
  }

  public static uint Up(uint x) {
    return RoundUpPow2Of32(x, 32);
  }

  public static ulong UpWide(ulong x) {
    return RoundUpPow2Of64(x);
  }

  private static bool IsPow2Signed32(int value) {
    unchecked {
      return (value > 0) && ((value & (value - 1)) == 0);
    }
  }

  private static uint RoundUpPow2Of32(uint value, int bits) {
    unchecked {
      uint pattern = (bits == 32) ? value : (value & ((1u << bits) - 1u));
      if (pattern == 0u) {
        return 0;
      }
      uint power = 1;
      while ((power != 0u) && (power < pattern)) {
        power = power << 1;
      }
      return power;
    }
  }

  private static ulong RoundUpPow2Of64(ulong value) {
    if (value == 0UL) {
      return 0;
    }
    ulong power = 1;
    while ((power != 0UL) && (power < value)) {
      power = power << 1;
    }
    return power;
  }

}
