#### net2.0+accurate BitsPowersOfTwo.cs 874
// BitsPowersOfTwo: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public static class BitsPowersOfTwo {

  public static bool Power(int x) {
    unchecked {
      return IsPow2Signed(x);
    }
  }

  public static bool PowerShort(short x) {
    unchecked {
      return IsPow2Signed(x);
    }
  }

  public static uint Up(uint x) {
    unchecked {
      return (uint)RoundUpPow2((ulong)x);
    }
  }

  public static ulong UpWide(ulong x) {
    unchecked {
      return (ulong)RoundUpPow2((ulong)x);
    }
  }

  private static bool IsPow2Signed(long value) {
    return value > 0L && (value & (value - 1L)) == 0L;
  }

  private static ulong RoundUpPow2(ulong value) {
    if (value == 0UL) {
      return 0UL;
    }
    ulong power = 1UL;
    while (power != 0UL && power < value) {
      power <<= 1;
    }
    return power;
  }

}
