    return TrailingZeroCount32((value | ((1 << bits) >>> 0)) >>> 0);
  }

  // Log2Of64(value: bigint): number
  function Log2Of64(value) {
    return (63 - LeadingZeroCount64(value | 1n)) | 0;
  }

  // PopCountNarrow(value: number, bits: number): number
  function PopCountNarrow(value, bits) {
    return PopCount32((value & ((((1 << bits) >>> 0) - 1) >>> 0)) >>> 0);
  }

  // PopCount32(value: number): number
  function PopCount32(value) {
    value = (value - (((value >>> 1) & 1431655765) >>> 0)) >>> 0;
    value = (((value & 858993459) >>> 0) + (((value >>> 2) & 858993459) >>> 0)) >>> 0;
    value = (((value + (value >>> 4)) >>> 0) & 252645135) >>> 0;
    return ((Math.imul(value, 16843009) >>> 0) >>> 24) | 0;
  }

  // LeadingZeroCount64(value: bigint): number
  function LeadingZeroCount64(value) {
    let high = Number(BigInt.asUintN(32, value >> 32n));
    return (high !== 0) ? LeadingZeroCount32(high) : ((32 + LeadingZeroCount32(Number(BigInt.asUintN(32, value)))) | 0);
  }

  // LeadingZeroCount32(value: number): number
  function LeadingZeroCount32(value) {
    if (value === 0) {
      return 32;
    }
    let count = 0;
    if (value <= 65535) {
      count = (count + 16) | 0;
      value = (value << 16) >>> 0;
    }
    if (value <= 16777215) {
      count = (count + 8) | 0;
      value = (value << 8) >>> 0;
    }
    if (value <= 268435455) {
      count = (count + 4) | 0;
      value = (value << 4) >>> 0;
    }
    if (value <= 1073741823) {
      count = (count + 2) | 0;
      value = (value << 2) >>> 0;
    }
    return (value <= 2147483647) ? ((count + 1) | 0) : count;
  }

  return {
    Population: Population,
    Leading: Leading,
    TrailingSigned: TrailingSigned,
    LeadingByte: LeadingByte,
    TrailingShort: TrailingShort,
    Logarithm: Logarithm,
    PopulationShort: PopulationShort
  };
})();
