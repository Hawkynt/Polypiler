  private static void Store64(byte[] array, int index, ulong value, bool little) {
    unchecked {
      CheckBytes(array, index, 8);
      {
        int offset = 0;
        while (offset < 8) {
          array[index + (little ? offset : (7 - offset))] = (byte)(value >> (8 * offset));
          offset = offset + 1;
        }
      }
    }
