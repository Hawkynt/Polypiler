    Store32(data, 0, (uint)value, 2, true);
    return data;
  }

  private static uint Load32(byte[] array, int index, int size, bool little) {
    unchecked {
      CheckBytes(array, index, size);
      if (size == 2) {
        return little ? (uint)(array[index] | (array[index + 1] << 8)) : (uint)((array[index] << 8) | array[index + 1]);
      }
      return little ? (uint)(((array[index] | (array[index + 1] << 8)) | (array[index + 2] << 16)) | (array[index + 3] << 24)) : (uint)((((array[index] << 24) | (array[index + 1] << 16)) | (array[index + 2] << 8)) | array[index + 3]);
    }
