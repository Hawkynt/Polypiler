// masks: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public static class @masks {

  public static ulong low12(ulong x) {
    unchecked {
      return (ulong)ZeroExtend((ulong)x, 12, 64);
    }
  }

  public static long signed20(long x) {
    unchecked {
      return ((x << (64 - 20)) >> (64 - 20));
    }
  }

  public static long wrapped(ulong x) {
    unchecked {
      return (long)x * 3L;
    }
  }

  private static ulong ZeroExtend(ulong value, int bits, int width) {
    if (bits < 1 || bits > width) {
      throw new global::System.ArithmeticException("invalid operation");
    }
    return bits == 64 ? value : value & ((1UL << bits) - 1UL);
  }

}
