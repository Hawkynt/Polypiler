public static class BitsBounds {

  public static int Clamped(int x) {
    unchecked {
      return global::System.Math.Min(global::System.Math.Max(x, (-100)), 100);
    }
  }

  public static byte ClampedByte(byte x, byte low) {
    unchecked {
      return (byte)ClampUnsigned(x, ((byte)(low / 2)), ((byte)200));
    }
  }

  public static long Smaller(long a, long b) {
    return global::System.Math.Min(a, b);
  }

  public static ushort Larger(ushort a, ushort b) {
    return global::System.Math.Max(a, b);
  }

  public static short Magnitude(short x) {
    return global::System.Math.Abs(x);
  }

  public static int Signum(ulong x) {
    unchecked {
      return (x != 0 ? 1 : 0);
    }
  }

  private static ulong ClampUnsigned(ulong value, ulong low, ulong high) {
    if (low > high) {
      throw new global::System.ArithmeticException("invalid operation");
    }
    return value < low ? low : value > high ? high : value;
  }

}
