// widemultiply: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

function $imul(a, b) {
  var high = (a >>> 16) & 0xFFFF;
  var low = a & 0xFFFF;
  return (low * (b & 0xFFFF) + (((high * (b & 0xFFFF) + low * ((b >>> 16) & 0xFFFF)) << 16) >>> 0)) | 0;
}

// product(a: number, b: number): number
function product(a, b) {
  return $imul(a, b);
}

// productUnsigned(a: number, b: number): number
function productUnsigned(a, b) {
  return $imul(a | 0, b | 0) >>> 0;
}

exports.product = product;
exports.productUnsigned = productUnsigned;
