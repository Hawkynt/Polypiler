// BitsRotate: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
// A 64-bit integer is an object { hi, lo }: its upper and its lower 32 bits, each as an unsigned number.
"use strict";

function $or64(a, b) {
  return { hi: (a.hi | b.hi) >>> 0, lo: (a.lo | b.lo) >>> 0 };
}

function $shl64(value, count) {
  count &= 63;
  if (count === 0) return value;
  if (count >= 32) return { hi: (value.lo << (count - 32)) >>> 0, lo: 0 };
  return { hi: ((value.hi << count) | (value.lo >>> (32 - count))) >>> 0, lo: (value.lo << count) >>> 0 };
}

function $shr64(value, count) {
  count &= 63;
  if (count === 0) return value;
  if (count >= 32) return { hi: 0, lo: value.hi >>> (count - 32) };
  return { hi: value.hi >>> count, lo: ((value.lo >>> count) | (value.hi << (32 - count))) >>> 0 };
}

function $rotl(value, count) {
  return ((value << count) | (value >>> (-count & 31))) >>> 0;
}

function $rotl64(value, count) {
  count &= 63;
  return count === 0 ? value : $or64($shl64(value, count), $shr64(value, 64 - count));
}

function $rotr64(value, count) {
  count &= 63;
  return count === 0 ? value : $or64($shr64(value, count), $shl64(value, 64 - count));
}

function $rotln(value, count, bits) {
  var mask = (1 << bits) - 1;
  value &= mask;
  count &= bits - 1;
  return ((value << count) | (value >>> (bits - count))) & mask;
}

function $rotrn(value, count, bits) {
  var mask = (1 << bits) - 1;
  value &= mask;
  count &= bits - 1;
  return ((value >>> count) | (value << (bits - count))) & mask;
}

// Left32(x: number, n: number): number
function Left32(x, n) {
  return $rotl(x, n);
}

// Right64(x: { hi, lo }, n: number): { hi, lo }
function Right64(x, n) {
  return $rotr64(x, n);
}

// Left16(x: number, n: number): number
function Left16(x, n) {
  return ($rotln(x, n, 16)) & 0xFFFF;
}

// Right8(x: number, n: number): number
function Right8(x, n) {
  return ($rotrn(x, n, 8)) << 24 >> 24;
}

// LeftSigned64(x: { hi, lo }, n: number): { hi, lo }
function LeftSigned64(x, n) {
  return $rotl64(x, n);
}

exports.Left32 = Left32;
exports.Right64 = Right64;
exports.Left16 = Left16;
exports.Right8 = Right8;
exports.LeftSigned64 = LeftSigned64;
