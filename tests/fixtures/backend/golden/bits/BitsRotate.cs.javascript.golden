function $rotl(value, count) {
  return ((value << count) | (value >>> (-count & 31))) >>> 0;
}

function $rotl64(value, count) {
  const by = BigInt(count & 63);
  return BigInt.asUintN(64, (value << by) | (value >> (64n - by)));
}

function $rotr64(value, count) {
  const by = BigInt(count & 63);
  return BigInt.asUintN(64, (value >> by) | (value << (64n - by)));
}

function $rotln(value, count, bits) {
  const mask = (1 << bits) - 1;
  value &= mask;
  count &= bits - 1;
  return ((value << count) | (value >>> (bits - count))) & mask;
}

function $rotrn(value, count, bits) {
  const mask = (1 << bits) - 1;
  value &= mask;
  count &= bits - 1;
  return ((value >>> count) | (value << (bits - count))) & mask;
}

// Left32(x: number, n: number): number
export function Left32(x, n) {
  return $rotl(x, n);
}

// Right64(x: bigint, n: number): bigint
export function Right64(x, n) {
  return $rotr64(x, n);
}

// Left16(x: number, n: number): number
export function Left16(x, n) {
  return ($rotln(x, n, 16)) & 0xFFFF;
}

// Right8(x: number, n: number): number
export function Right8(x, n) {
  return ($rotrn(x, n, 8)) << 24 >> 24;
}

// LeftSigned64(x: bigint, n: number): bigint
export function LeftSigned64(x, n) {
  return BigInt.asIntN(64, $rotl64(BigInt.asUintN(64, x), n));
}
