public static class BitsRotate {

  public static uint Left32(uint x, int n) {
    return RotateLeft32(x, n);
  }

  public static ulong Right64(ulong x, int n) {
    return RotateRight64(x, n);
  }

  public static ushort Left16(ushort x, int n) {
    unchecked {
      return (ushort)RotateLeftNarrow((uint)x, n, 16);
    }
  }

  public static sbyte Right8(sbyte x, int n) {
    unchecked {
      return (sbyte)RotateRightNarrow((uint)x, n, 8);
    }
  }

  public static long LeftSigned64(long x, int n) {
    unchecked {
      return (long)RotateLeft64((ulong)x, n);
    }
  }

  private static uint RotateLeft32(uint value, int count) {
    unchecked {
      return (value << count) | (value >> (-count & 31));
    }
  }

  private static ulong RotateRight64(ulong value, int count) {
    unchecked {
      return (value >> count) | (value << (-count & 63));
    }
  }

  private static uint RotateLeftNarrow(uint value, int count, int bits) {
    unchecked {
      uint mask = (1u << bits) - 1u;
      value = value & mask;
      count = count & (bits - 1);
      return ((value << count) | (value >> (bits - count))) & mask;
    }
  }

  private static uint RotateRightNarrow(uint value, int count, int bits) {
    unchecked {
      uint mask = (1u << bits) - 1u;
      value = value & mask;
      count = count & (bits - 1);
      return ((value >> count) | (value << (bits - count))) & mask;
    }
  }

  private static ulong RotateLeft64(ulong value, int count) {
    unchecked {
      return (value << count) | (value >> (-count & 63));
    }
  }

}
