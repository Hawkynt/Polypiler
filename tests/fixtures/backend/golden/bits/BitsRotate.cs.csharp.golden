#### net2.0+accurate BitsRotate.cs 1632
// BitsRotate: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public static class BitsRotate {

  public static uint Left32(uint x, int n) {
    return RotateLeft(x, n);
  }

  public static ulong Right64(ulong x, int n) {
    return RotateRight(x, n);
  }

  public static ushort Left16(ushort x, int n) {
    unchecked {
      return (ushort)RotateLeftBits((ulong)x, n, 16);
    }
  }

  public static sbyte Right8(sbyte x, int n) {
    unchecked {
      return (sbyte)RotateRightBits((ulong)(byte)x, n, 8);
    }
  }

  public static long LeftSigned64(long x, int n) {
    unchecked {
      return (long)RotateLeft((ulong)x, n);
    }
  }

  private static uint RotateLeft(uint value, int count) {
    return (value << count) | (value >> (32 - (count & 31)));
  }

  private static ulong RotateLeft(ulong value, int count) {
    return (value << count) | (value >> (64 - (count & 63)));
  }

  private static ulong RotateRight(ulong value, int count) {
    return (value >> count) | (value << (64 - (count & 63)));
  }

  private static ulong RotateLeftBits(ulong value, int count, int bits) {
    count &= bits - 1;
    if (count == 0) {
      return value;
    }
    ulong mask = bits == 64 ? ulong.MaxValue : (1UL << bits) - 1UL;
    return ((value << count) | (value >> (bits - count))) & mask;
  }

  private static ulong RotateRightBits(ulong value, int count, int bits) {
    count &= bits - 1;
    if (count == 0) {
      return value;
    }
    ulong mask = bits == 64 ? ulong.MaxValue : (1UL << bits) - 1UL;
    return ((value >> count) | (value << (bits - count))) & mask;
  }

}
