// BitsPowersOfTwo: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
// A 64-bit integer is an object { hi, lo }: its upper and its lower 32 bits, each as an unsigned number.
"use strict";

function $ispow2(value) {
  return value > 0 && (value & (value - 1)) === 0;
}

function $rup2(value, bits) {
  var pattern = bits === 32 ? value >>> 0 : value & ((1 << bits) - 1);
  if (pattern === 0) return 0;
  var power = 1;
  while (power < pattern) power *= 2;
  return power;
}

function $rup264(value) {
  if (value.hi === 0) return value.lo <= 2147483648 ? { hi: 0, lo: $rup2(value.lo, 32) } : { hi: 1, lo: 0 };
  if (value.hi > 2147483648 || (value.hi === 2147483648 && value.lo !== 0)) return { hi: 0, lo: 0 };
  return { hi: $rup2(value.lo === 0 ? value.hi : value.hi + 1, 32), lo: 0 };
}

// Power(x: number): boolean
function Power(x) {
  return $ispow2(x);
}

// PowerShort(x: number): boolean
function PowerShort(x) {
  return $ispow2(x);
}

// Up(x: number): number
function Up(x) {
  return ($rup2(x, 32)) >>> 0;
}

// UpWide(x: { hi, lo }): { hi, lo }
function UpWide(x) {
  return $rup264(x);
}

exports.Power = Power;
exports.PowerShort = PowerShort;
exports.Up = Up;
exports.UpWide = UpWide;
