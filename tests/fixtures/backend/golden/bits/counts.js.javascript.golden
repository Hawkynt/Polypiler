// counts: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

function $clz32(value) {
  value >>>= 0;
  if (value === 0) return 32;
  var count = 0;
  if ((value & 0xFFFF0000) === 0) { count += 16; value <<= 16; }
  if ((value & 0xFF000000) === 0) { count += 8; value <<= 8; }
  if ((value & 0xF0000000) === 0) { count += 4; value <<= 4; }
  if ((value & 0xC0000000) === 0) { count += 2; value <<= 2; }
  return (value & 0x80000000) === 0 ? count + 1 : count;
}

// leading(x: number): number
function leading(x) {
  return $clz32(x);
}

// leadingShort(x: number): number
function leadingShort(x) {
  return $clz32(x >>> 0);
}

// log2(x: number): number
function log2(x) {
  return 31 - $clz32(((x | 0) | 1) >>> 0);
}

exports.leading = leading;
exports.leadingShort = leadingShort;
exports.log2 = log2;
