// counts: generated by polypiler. Change the source, not this file.
// JavaScript profile: es5, cjs.
"use strict";

// leading(x: number): number
function leading(x) {
  return LeadingZeroCount32(x);
}

// leadingShort(x: number): number
function leadingShort(x) {
  return LeadingZeroCount32(x >>> 0);
}

// log2(x: number): number
function log2(x) {
  return 31 - LeadingZeroCount32(((x | 0) | 1) >>> 0);
}

// LeadingZeroCount32(value: number): number
function LeadingZeroCount32(value) {
  if (value === 0) {
    return 32;
  }
  var count = 0;
  if (value <= 65535) {
    count = (count + 16) | 0;
    value = (value << 16) >>> 0;
  }
  if (value <= 16777215) {
    count = (count + 8) | 0;
    value = (value << 8) >>> 0;
  }
  if (value <= 268435455) {
    count = (count + 4) | 0;
    value = (value << 4) >>> 0;
  }
  if (value <= 1073741823) {
    count = (count + 2) | 0;
    value = (value << 2) >>> 0;
  }
  return (value <= 2147483647) ? ((count + 1) | 0) : count;
}

exports.leading = leading;
exports.leadingShort = leadingShort;
exports.log2 = log2;
