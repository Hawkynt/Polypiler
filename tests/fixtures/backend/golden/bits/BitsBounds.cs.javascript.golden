    super(message);
    this.name = "OverflowError";
  }
}

function $div(a, b) {
  if (b === 0) throw new DivideByZeroError("divide by zero");
  if (a === -2147483648 && b === -1) throw new OverflowError("integer overflow");
  return (a / b) | 0;
}

function $abs(value, low) {
  if (value === low) throw new OverflowError("integer overflow");
  return value < 0 ? -value : value;
}

function $min64(a, b) {
  return a < b ? a : b;
}

function $sign64(value) {
  return value < 0n ? -1 : value > 0n ? 1 : 0;
}

function $clamp(value, low, high) {
  if (low > high) throw new ArithmeticError("invalid operation");
  return value < low ? low : value > high ? high : value;
}

// Clamped(x: number): number
function Clamped(x) {
  return $clamp(x, -100, 100);
}

// ClampedByte(x: number, low: number): number
function ClampedByte(x, low) {
  return $clamp(x, $div(low, 2) & 0xFF, 200);
}

// Smaller(a: bigint, b: bigint): bigint
function Smaller(a, b) {
  return $min64(a, b);
}

// Larger(a: number, b: number): number
function Larger(a, b) {
  return Math.max(a, b);
}

// Magnitude(x: number): number
function Magnitude(x) {
  return $abs(x, -32768);
}

// Signum(x: bigint): number
function Signum(x) {
  return $sign64(x);
}

exports.Clamped = Clamped;
exports.ClampedByte = ClampedByte;
exports.Smaller = Smaller;
exports.Larger = Larger;
exports.Magnitude = Magnitude;
exports.Signum = Signum;
