#### net2.0+accurate Numbers.cs 729
// Numbers: generated by polypiler. Change the source, not this file.
// Profile: net2.0, C# 2.

public static class Numbers {

  public static int Gcd(int a, int b) {
    while (b != 0) {
      int remainder = a % b;
      a = b;
      b = remainder;
    }
    return a;
  }

  public static uint Fibonacci(int n) {
    unchecked {
      uint current = 0;
      uint next = 1;
      {
        int i = 0;
        while (i < n) {
          uint sum = current + next;
          current = next;
          next = sum;
          i = i + 1;
        }
      }
      return current;
    }
  }

  public static uint RotateLeft(uint value, int count) {
    unchecked {
      return (value << count) | (value >> (32 - count));
    }
  }

}
