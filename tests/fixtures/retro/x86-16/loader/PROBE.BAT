@ECHO OFF
VER > B:\TRACE.TXT
IF ERRORLEVEL 42 GOTO FAILED
B:\EXIT42.COM
IF ERRORLEVEL 43 GOTO FAILED
IF NOT ERRORLEVEL 42 GOTO FAILED
ECHO COM=42>> B:\TRACE.TXT
B:\NORELOC.EXE
IF ERRORLEVEL 2 GOTO FAILED
IF NOT ERRORLEVEL 1 GOTO FAILED
B:\EXIT42.EXE
IF ERRORLEVEL 43 GOTO FAILED
IF NOT ERRORLEVEL 42 GOTO FAILED
ECHO MZ=42>> B:\TRACE.TXT
B:\NORELOC.EXE
IF ERRORLEVEL 2 GOTO FAILED
IF NOT ERRORLEVEL 1 GOTO FAILED
B:\RELOC.EXE
IF ERRORLEVEL 43 GOTO FAILED
IF NOT ERRORLEVEL 42 GOTO FAILED
ECHO RELOC=42>> B:\TRACE.TXT
B:\NORELOC.EXE
IF ERRORLEVEL 2 GOTO FAILED
IF NOT ERRORLEVEL 1 GOTO FAILED
ECHO NORELOC=1>> B:\TRACE.TXT
GOTO FINISH
:FAILED
ECHO Unexpected>> B:\TRACE.TXT
:FINISH
ECHO PLY_DONE>> B:\TRACE.TXT
