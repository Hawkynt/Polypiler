-- addition_overflow --
// want: invalid "constant addition overflow"
package p

const a = 1 << 511
const b = a + a
-- subtraction_overflow --
// want: invalid "constant subtraction overflow"
package p

const a = -1 << 511
const b = a - (1 << 511)
-- string_compared_with_int --
// want: invalid "mismatched types"
package p

func F(s string) bool { return s == 1 }
-- nil_compared_with_struct --
// want: invalid "mismatched types"
package p

type S struct{}

func F(s S) bool { return nil == s }
-- struct_compared_with_nil --
// want: invalid "mismatched types"
package p

type S struct{}

func F(s S) bool { return s == nil }
