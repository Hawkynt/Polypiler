# Conversions, assignability and the untyped values in their contexts, valid and invalid, for the
# Go frontend's checker; the Go layer checks that go/types decides each file alike. Written for this
# repository.
-- conversions_and_contexts --
// want: valid
// const fromCode string "A"
package p

import _ "math"

type Tagged struct {
	A int `json:"a"`
}

type Plain struct{ A int }

type Ints []int

func pair() (int, int) { return 1, 2 }

func add(a, b int) int { return a + b }

const fromCode = string(rune(65))

var a, b = pair()

func More(p *Plain, s string, i int, arr *[4]int) {
	_ = Tagged(Plain{1})
	_ = (*Tagged)(p)
	_ = float64(i) + float64(int8(i))
	_ = []byte(s)
	_ = []rune(s)
	var plain []int = Ints(nil)
	_ = plain
	_ = add(pair())
	_ = make(map[int]int, 4)
	_ = "abc"[1]
	_ = "abc"[1:]
	_ = arr[1:]
	for i, v := range arr {
		_, _ = i, v
	}
	var x int64 = (1 << i)
	var y int64 = -(1 << i)
	_, _ = x, y
	var v any = 1
	switch v {
	case 1, "a":
	}
	_ = a + b
}

type Small interface{ Area() float64 }

type Big interface {
	Area() float64
	Name() string
}

func Narrow(b Big) Small { return b }

type T int

func (T) _() {}

func Labels() int {
	for {
	L:
		for {
			break L
		}
	}
}

func Trailing(x int) {
	switch x {
	case 1:
		x++
		;
	}
}
