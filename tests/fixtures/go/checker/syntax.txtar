# Syntax errors of the Go frontend's scanner and parser, one per message. Each section is one file;
# its first line says what the frontend must decide ("syntax" and a part of the message), and the Go
# layer checks that go/parser refuses the same file. Written for this repository.
-- expect_closing_paren --
// want: syntax "expected ')', found '{'"
package p

func F( {
}
-- missing_comma_newline --
// want: syntax "missing ',' before newline in argument list"
package p

func F() { G(1
) }
func G(int) {}
