# Type errors of statements, one per message of the Go frontend's checker; the Go layer checks that
# go/types refuses each file too. Written for this repository.
-- missing_return --
// want: invalid "missing return"
package p

func F(x int) int {
	if x > 0 {
		return 1
	}
}
-- missing_return_loop_break --
// want: invalid "missing return"
package p

func F() int {
	for {
		break
	}
}
-- missing_return_switch_without_default --
// want: invalid "missing return"
package p

func F(x int) int {
	switch x {
	case 1:
		return 1
	}
}
-- missing_return_labeled_break --
// want: invalid "missing return"
package p

func F(x int) int {
L:
	for {
		switch x {
		default:
			break L
		}
	}
}
-- unused_variable --
// want: invalid "declared and not used: x"
package p

func F() {
	x := 1
}
-- assigned_not_used --
// want: invalid "declared and not used: x"
package p

func F() {
	var x int
	x = 1
}
-- unused_range_variable --
// want: invalid "declared and not used: v"
package p

func F(s []int) {
	for _, v := range s {
	}
}
-- unused_in_closure --
// want: invalid "declared and not used: y"
package p

var f = func() {
	y := 1
}
-- inc_string --
// want: invalid "non-numeric type string"
package p

func F(s string) { s++ }
-- assign_to_map_field --
// want: invalid "cannot assign to struct field m[1].a in map"
package p

type T struct{ a int }

func F(m map[int]T) { m[1].a = 2 }
-- assign_to_value --
// want: invalid "cannot assign to f() (neither addressable nor a map index expression)"
package p

func f() int { return 1 }

func F() { f() = 2 }
-- assign_op_multiple --
// want: invalid "assignment operation += requires single-valued expressions"
package p

func F(a, b int) { a, b += 1, 2 }
-- assign_mismatch --
// want: invalid "assignment mismatch: 2 variables but 3 values"
package p

func F(a, b int) { a, b = 1, 2, 3 }
-- assign_call_mismatch --
// want: invalid "assignment mismatch: 2 variables but f() returns 3 values"
package p

func f() (int, int, int) { return 1, 2, 3 }

func F(a, b int) { a, b = f() }
-- non_name_define --
// want: invalid "non-name s[0] on left side of :="
package p

func F(s []int) { s[0] := 1 }
-- repeated_define --
// want: invalid "a repeated on left side of :="
package p

func F() {
	a, a := 1, 2
	_ = a
}
-- define_over_constant --
// want: invalid "cannot assign to c"
package p

func F() {
	const c = 1
	c, d := 2, 3
	_ = d
}
-- no_new_variables --
// want: invalid "no new variables on left side of :="
package p

func F() {
	a := 1
	a := 2
	_ = a
}
-- untyped_nil_variable --
// want: invalid "use of untyped nil in assignment"
package p

func F() {
	x := nil
	_ = x
}
-- return_too_many_count --
// want: invalid "too many return values"
package p

func F() (int, int) { return 1, 2, 3 }
-- define_mismatch_values --
// want: invalid "assignment mismatch: 2 variables but 3 values"
package p

func F() {
	a, b := 1, 2, 3
	_, _ = a, b
}
-- return_call_mismatch --
// want: invalid "not enough return values"
package p

func f() (int, int) { return 1, 2 }

func F() (int, int, int) { return f() }
-- define_call_mismatch --
// want: invalid "assignment mismatch: 1 variable but f() returns 2 values"
package p

func f() (int, int) { return 1, 2 }

func F() {
	a := f()
	_ = a
}
-- result_shadowed --
// want: invalid "result parameter r not in scope at return"
