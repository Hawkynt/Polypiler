-- untyped_shifts --
// want: valid
package p

func Shifts(n uint, s int8) (int64, uint8, bool) {
	var a int64 = 1 << n
	var b uint8 = 1<<n + 3
	c := 1 << s
	d := a<<n == 1<<n
	e := int64(1) << 62
	_ = c
	return a + e, b, d
}
-- conversions --
// want: valid
package p

type Celsius float64
type Bytes []byte

func Convert(x int, f float64, s string) (Celsius, Bytes, string, []rune, *[2]int, [2]int) {
	c := Celsius(f) + Celsius(x)
	b := Bytes(s)
	t := string(b) + string(rune(x))
	sl := []int{1, 2}
	return c, b, t, []rune(s), (*[2]int)(sl), [2]int(sl)
}
-- interfaces --
// want: valid
package p

type Shape interface {
	Area() float64
	Name() string
}

type Square struct{ side float64 }

func (s Square) Area() float64 { return s.side * s.side }
func (s *Square) Name() string { return "square" }

func Describe(v any, sh Shape) (string, float64) {
	_ = v == nil
	_ = sh != nil
	var x any = 1
	_ = x
	return sh.Name(), sh.Area()
}

var _ Shape = &Square{}
-- new_and_pointers --
// want: valid
package p

type Node struct {
	next *Node
	val  int
}

func Pointers() int {
	n := new(Node)
	p := new(42)
	n.next = &Node{val: 1}
	*p++
	return n.next.val + *p
}
-- init_and_order --
// want: valid
package main

var a = b + 1
var b = f()

func f() int { return 2 }

func init() {}
func init() {}

func main() { _ = a }

func even(n int) bool {
	if n == 0 {
		return true
	}
	return odd(n - 1)
}

func odd(n int) bool { return n != 0 && even(n-1) }
-- local_declarations --
// want: valid
package p

func Local() int {
	const (
		a = iota * 10
		b
	)
	type pair struct{ x, y int }
	type alias = pair
	var v alias = pair{a, b}
	var p, q = 1, 2
	var r, ok = map[int]int{}[1]
	_ = ok
	return v.x + v.y + p + q + r
}
-- build_version --
// want: valid
//go:build go1.21 && linux

package p

func Loop() int {
	t := 0
	for i := 0; i < 3; i++ {
		t += i
	}
	return min(t, 2)
}
