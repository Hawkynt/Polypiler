var x int = "a"
-- constant_overflow_typed --
// want: invalid "overflows int8"
package p

const a int8 = 100
const b = a * 2
-- constant_overflow_untyped --
// want: invalid "constant multiplication overflow"
package p

const a = 1 << 400
const b = a * a
-- negation_overflow --
// want: invalid "overflows"
package p

const c = -uint(1)
-- assign_type_to --
// want: invalid "cannot use x (variable of type string) as int value in assignment"
package p

func F(x string) {
	var y int
	y = x
	_ = y
}
-- untyped_nil_blank --
// want: invalid "use of untyped nil in assignment"
package p

func F() { _ = nil }
