(set-logic QF_BV)
(declare-const |x| (_ BitVec 16))
(define-fun |before.a| () (_ BitVec 16) (bvshl |x| (bvurem (_ bv3 16) (_ bv16 16))))
(define-fun |before.s| () (_ BitVec 16) (bvsub (_ bv16 16) (_ bv3 16)))
(define-fun |before.b| () (_ BitVec 16) (bvlshr |x| (bvurem |before.s| (_ bv16 16))))
(define-fun |before.r| () (_ BitVec 16) (bvor |before.a| |before.b|))
(define-fun |after.r| () (_ BitVec 16) (bvor (bvshl |x| (bvurem (_ bv3 16) (_ bv16 16))) (bvlshr |x| (bvsub (_ bv16 16) (bvurem (_ bv3 16) (_ bv16 16))))))
(assert (and true (or (not true) (not (= |before.r| |after.r|)))))
(check-sat)
