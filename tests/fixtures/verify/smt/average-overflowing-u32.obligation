# Scenario 2, test design 12: the sum loses its carry, worth 0x80000000, exactly when a + b >= 2^32 (Hacker's Delight 2-5).
rule: average-overflowing-u32
inputs: a: u32, b: u32
before: %x = Xor.u32 %a, %b; %h = LShr.u32[mask] %x, 1; %c = And.u32 %a, %b; %r = Add.u32 %c, %h
after: %s = Add.u32 %a, %b; %r = LShr.u32[mask] %s, 1
