    PlyLeft_2 = PlySubstring(s, CLng(0), n)
    PlyLeft_ = PlyLeft_2
End Function

Private Function PlyMid_(ByVal s As String, ByVal start As Long, ByVal count As Long) As String
    Dim PlyMid_2 As String
    PlyMid_2 = ""
    If start <= CLng(0) Or count < CLng(0) Then
        Err.Raise 5
    End If
    If start > Len(s) Then
        PlyMid_2 = ""
    Else
        If count > CLng(CLng(Len(s) - start) + CLng(1)) Then
            count = CLng(CLng(Len(s) - start) + CLng(1))
        End If
        PlyMid_2 = PlySubstring(s, CLng(start - CLng(1)), count)
    End If
    PlyMid_ = PlyMid_2
End Function

Private Function PlyRight_(ByVal s As String, ByVal n As Long) As String
    Dim PlyRight_2 As String
    PlyRight_2 = ""
    If n < CLng(0) Then
        Err.Raise 5
    End If
    If n > Len(s) Then
        n = Len(s)
    End If
    PlyRight_2 = PlySubstring(s, CLng(Len(s) - n), n)
    PlyRight_ = PlyRight_2
End Function

Private Sub PlyInit()
    ErrNumber = 0
    PlyReady = True
End Sub

Private Function PlyWrap32(ByVal d As Double) As Long
    d = d - Int(d / 4294967296#) * 4294967296#
    If d >= 2147483648# Then
        d = d - 4294967296#
    End If
    PlyWrap32 = CLng(d)
End Function

Private Function PlyAdd32(ByVal a As Long, ByVal b As Long) As Long
    PlyAdd32 = PlyWrap32(CDbl(a) + CDbl(b))
End Function

Private Function PlySub32(ByVal a As Long, ByVal b As Long) As Long
    PlySub32 = PlyWrap32(CDbl(a) - CDbl(b))
End Function

Private Function PlyDiv32(ByVal a As Long, ByVal b As Long) As Long
    If b = (-1) Then
        If a = &H80000000 Then
            Err.Raise 6
        End If
        PlyDiv32 = -a
    Else
        PlyDiv32 = a \ b
    End If
End Function

Private Function PlyRem32(ByVal a As Long, ByVal b As Long) As Long
    If b = (-1) Then
        If a = &H80000000 Then
            Err.Raise 6
        End If
        PlyRem32 = 0
    Else
        PlyRem32 = a Mod b
    End If
End Function

Private Function PlySubstring(ByVal s As String, ByVal start As Long, ByVal count As Long) As String
    If start < 0 Or count < 0 Or start > Len(s) - count Then
        Err.Raise 5
    End If
    PlySubstring = Mid(s, start + 1, count)
End Function

Private Function PlyIndexOf(ByVal s As String, ByVal find As String, ByVal start As Long) As Long
    If start < 0 Or start > Len(s) Then
        Err.Raise 5
    End If
    If Len(find) = 0 Then
        PlyIndexOf = start
    Else
        PlyIndexOf = InStr(start + 1, s, find, 0) - 1
    End If
End Function

Private Function PlyLen_Integer(a() As Integer) As Long
    On Error GoTo PlyNone
    PlyLen_Integer = UBound(a) - LBound(a) + 1
    Exit Function
PlyNone:
    PlyLen_Integer = 0
End Function

Private Function PlyNew_Integer(ByVal n As Long) As Variant
    Dim r() As Integer
    If n < 0 Then
        Err.Raise 6
    End If
    If n > 0 Then
        ReDim r(0 To n - 1)
    End If
    PlyNew_Integer = r
End Function

Private Function PlyLen_Long(a() As Long) As Long
    On Error GoTo PlyNone
    PlyLen_Long = UBound(a) - LBound(a) + 1
    Exit Function
PlyNone:
    PlyLen_Long = 0
End Function

Private Function PlyNew_Long(ByVal n As Long) As Variant
    Dim r() As Long
    If n < 0 Then
        Err.Raise 6
    End If
    If n > 0 Then
        ReDim r(0 To n - 1)
    End If
    PlyNew_Long = r
End Function
