    dec = 46
    grp = 44
    n = Len(s)
    i = PlyNumBlank_(s, CLng(0))
    If i < n Then
        c = PlyCharAt(s, i)
        If c = CLng(38) Then
            PlyNumText_2 = PlyNumRadix_(s, CLng(i + CLng(1)), True)
            PlyNumText_ = PlyNumText_2
            Exit Function
        End If
        If c = CLng(43) Or c = CLng(45) Then
            If c = CLng(45) Then
                t = "-"
            End If
            i = PlyNumBlank_(s, CLng(i + CLng(1)))
        End If
    End If
    Do While i < n
        c = PlyCharAt(s, i)
        If c >= CLng(48) And c <= CLng(57) Then
            t = t & ChrW(c And 65535&)
            d = CLng(d + CLng(1))
        ElseIf c <> grp Or d = CLng(0) Then
            Exit Do
        End If
        i = CLng(i + CLng(1))
    Loop
    If i < n Then
        If PlyCharAt(s, i) = dec Then
            t = t & "."
            i = CLng(i + CLng(1))
            Do While i < n
                c = PlyCharAt(s, i)
                If c < CLng(48) Or c > CLng(57) Then
                    Exit Do
                End If
                t = t & ChrW(c And 65535&)
                d = CLng(d + CLng(1))
                i = CLng(i + CLng(1))
            Loop
        End If
    End If
    If d = CLng(0) Then
        PlyNumText_ = PlyNumText_2
        Exit Function
    End If
    i = PlyNumBlank_(s, i)
    If i < n Then
        c = PlyCharAt(s, i) Or CLng(32)
        If c = CLng(101) Or c = CLng(100) Then
            t = t & "e"
            i = PlyNumBlank_(s, CLng(i + CLng(1)))
            If i < n Then
                c = PlyCharAt(s, i)
                If c = CLng(43) Or c = CLng(45) Then
                    If c = CLng(45) Then
                        t = t & "-"
                    End If
                    i = PlyNumBlank_(s, CLng(i + CLng(1)))
                End If
            End If
            Do While i < n
                c = PlyCharAt(s, i)
                If c < CLng(48) Or c > CLng(57) Then
                    Exit Do
                End If
                t = t & ChrW(c And 65535&)
                e = CLng(e + CLng(1))
                i = CLng(i + CLng(1))
            Loop
            If e = CLng(0) Then
                PlyNumText_ = PlyNumText_2
                Exit Function
            End If
            i = PlyNumBlank_(s, i)
        End If
    End If
    If i = n Then
        PlyNumText_2 = t
    End If
    PlyNumText_ = PlyNumText_2
End Function

Private Function PlyNumBlank_(ByVal s As String, ByVal i As Long) As Long
    Dim PlyNumBlank_2 As Long
    Dim choice As Boolean
    PlyNumBlank_2 = 0
    Do While i < Len(s)
        If PlyCharAt(s, i) <> CLng(32) Then
            choice = PlyCharAt(s, i) <> CLng(9)
        Else
            choice = CBool(IIf(PlyCharAt(s, i) <> CLng(9), False, False))
        End If
        If choice Then
            Exit Do
        End If
        i = CLng(i + CLng(1))
    Loop
    PlyNumBlank_2 = i
    PlyNumBlank_ = PlyNumBlank_2
End Function

Private Function PlyNumRadix_(ByVal s As String, ByVal i As Long, ByVal strict As Boolean) As String
    Dim PlyNumRadix_2 As String
    Dim n As Long
    Dim c As Long
    Dim b As Long
    Dim d As Long
    Dim v As Double
    Dim choice As Boolean
    Dim choice2 As Boolean
    PlyNumRadix_2 = ""
    n = 0
    c = 0
    b = 0
    d = 0
    v = 0#
    n = Len(s)
    b = CLng(8)
    If i < n Then
        c = PlyCharAt(s, i) Or CLng(32)
        If c = CLng(104) Then
            b = CLng(16)
            i = CLng(i + CLng(1))
        ElseIf c = CLng(111) Then
            i = CLng(i + CLng(1))
        End If
    End If
    Do While i < n
        c = PlyCharAt(s, i)
        If c >= CLng(48) And c <= CLng(57) Then
            choice = CLng(c - CLng(48)) < b
        Else
            choice = CBool(IIf(CLng(c - CLng(48)) < b, False, False))
        End If
        If choice Then
            c = CLng(c - CLng(48))
        ElseIf b = CLng(16) And (c Or CLng(32)) >= CLng(97) And (c Or CLng(32)) <= CLng(102) Then
            c = CLng((c Or CLng(32)) - CLng(87))
        Else
            Exit Do
        End If
        v = v * CDbl(b) + CDbl(c)
        d = CLng(d + CLng(1))
        i = CLng(i + CLng(1))
    Loop
    If strict Then
        If d = CLng(0) Then
            choice2 = CBool(IIf(PlyNumBlank_(s, i) < n, True, True))
        Else
            choice2 = PlyNumBlank_(s, i) < n
        End If
        If choice2 Then
            PlyNumRadix_ = PlyNumRadix_2
            Exit Function
        End If
    End If
    If v > 4294967295# Then
        Err.Raise 6
    End If
    If v > CDbl(65535) Then
        If v >= 2147483648# Then
            v = v - 4294967296#
        End If
    ElseIf v >= CDbl(32768) Then
        v = v - CDbl(65536)
    End If
    PlyNumRadix_2 = CStr(CLng(Fix(Round(v))))
    PlyNumRadix_ = PlyNumRadix_2
End Function

Private Function PlyVarForTest_(ByVal v As Variant, ByVal e As Variant, ByVal s As Variant) As Boolean
    Dim PlyVarForTest_2 As Boolean
    PlyVarForTest_2 = False
    If PlyVarDbl_(s) >= CDbl(0) Then
        PlyVarForTest_2 = PlyVarCmp_(v, e) <= CLng(0)
    Else
        PlyVarForTest_2 = PlyVarCmp_(v, e) >= CLng(0)
    End If
    PlyVarForTest_ = PlyVarForTest_2
End Function

Private Function PlyVarFromWide_(ByVal z As Double, ByVal r As Integer) As Variant
    Dim PlyVarFromWide_2 As Variant
    Dim choice As Boolean
    Dim choice2 As Boolean
    PlyVarFromWide_2 = Empty
    If CLng(r) = CLng(1) And z >= CDbl(0) And z <= CDbl(255) Then
        PlyVarFromWide_2 = CByte(CByte(Fix(Round(z))))
    Else
        If CLng(r) <= CLng(2) Then
            choice2 = z >= CDbl(CLng(-32768))
        Else
            choice2 = CBool(IIf(z >= CDbl(CLng(-32768)), False, False))
        End If
        If choice2 And z <= CDbl(32767) Then
            PlyVarFromWide_2 = CInt(CInt(Fix(Round(z))))
        ElseIf CBool(IIf(CLng(r) <= CLng(3), z >= (-2147483648#), CBool(IIf(z >= (-2147483648#), False, False)))) And z <= 2147483647# Then
            PlyVarFromWide_2 = CLng(CLng(Fix(Round(z))))
        ElseIf CBool(IIf(CLng(r) = CLng(5), z > (-3.4028235677973366E+38), CBool(IIf(z > (-3.4028235677973366E+38), False, False)))) And z < 3.4028235677973366E+38 Then
            PlyVarFromWide_2 = CSng(CSng(z))
        Else
            PlyVarFromWide_2 = CDbl(PlyCheckD_(z))
        End If
    End If
    PlyVarFromWide_ = PlyVarFromWide_2
End Function

Private Function PlyVarIntDiv_(ByVal op As Integer, ByVal a As Variant, ByVal b As Variant) As Variant
    Dim PlyVarIntDiv_2 As Variant
    Dim ta As Integer
    Dim tb As Integer
    Dim r As Integer
    Dim rb As Integer
    Dim x As Double
    Dim y As Double
    Dim q As Double
    PlyVarIntDiv_2 = Empty
    ta = 0
    tb = 0
    r = 0
    rb = 0
    x = 0#
    y = 0#
    q = 0#
    ta = CInt(VarType(a))
    tb = CInt(VarType(b))
    If CLng(ta) = CLng(1) Or CLng(tb) = CLng(1) Then
        PlyVarIntDiv_2 = Null
        PlyVarIntDiv_ = PlyVarIntDiv_2
        Exit Function
    End If
    r = PlyVarRank_(ta)
    rb = PlyVarRank_(tb)
    If CLng(r) = CLng(0) Or CLng(rb) = CLng(0) Then
        Err.Raise 13
    End If
    If CLng(r) > CLng(3) Then
        r = 3
    End If
    If CLng(rb) > CLng(3) Then
        rb = 3
    End If
    If CLng(rb) > CLng(r) Then
        r = rb
    End If
    x = PlyVarWhole_(a)
    y = PlyVarWhole_(b)
    If y = CDbl(0) Then
        Err.Raise 11
    End If
    q = Fix(x / y)
    If CLng(op) = CLng(0) Then
        PlyVarIntDiv_2 = PlyVarFromWide_(q, r)
    Else
        PlyVarIntDiv_2 = PlyVarFromWide_(x - y * q, r)
    End If
    PlyVarIntDiv_ = PlyVarIntDiv_2
End Function

Private Function PlyVarIsTrue_(ByVal v As Variant) As Boolean
    Dim PlyVarIsTrue_2 As Boolean
    Dim t As Integer
    PlyVarIsTrue_2 = False
    t = 0
    t = CInt(VarType(v))
    If CLng(t) = CLng(11) Then
        PlyVarIsTrue_2 = CBool(v)
    ElseIf CLng(t) = CLng(8) Then
        PlyVarIsTrue_2 = PlyTextBool_(CStr(v))
    ElseIf CLng(t) <> CLng(0) And CLng(t) <> CLng(1) Then
        PlyVarIsTrue_2 = PlyVarDbl_(v) <> CDbl(0)
    End If
    PlyVarIsTrue_ = PlyVarIsTrue_2
End Function

Private Function PlyTextBool_(ByVal s As String) As Boolean
    Dim PlyTextBool_2 As Boolean
    Dim choice As Boolean
    Dim choice2 As Boolean
    Dim choice3 As Boolean
    PlyTextBool_2 = False
    If PlyTextIs_(s, "true") Then
        choice = CBool(IIf(s = "#TRUE#", True, True))
    Else
        choice = s = "#TRUE#"
    End If
    If choice Then
        PlyTextBool_2 = True
    Else
        If Not PlyTextIs_(s, "false") Then
            choice3 = Not s = "#FALSE#"
        Else
            choice3 = CBool(IIf(Not s = "#FALSE#", False, False))
        End If
        If choice3 Then
            PlyTextBool_2 = PlyCDbl_(s) <> CDbl(0)
        End If
    End If
    PlyTextBool_ = PlyTextBool_2
End Function

Private Function PlyTextIs_(ByVal s As String, ByVal w As String) As Boolean
    Dim PlyTextIs_2 As Boolean
    Dim i As Long
    Dim ply1_ As Long
    Dim ply2_ As Long
    Dim ply3_ As Long
    PlyTextIs_2 = False
    i = 0
    If Len(s) <> Len(w) Then
        PlyTextIs_ = PlyTextIs_2
        Exit Function
    End If
    ply1_ = CLng(0)
    ply2_ = CLng(Len(s) - CLng(1))
    ply3_ = 1
    i = ply1_
    Do While i <= ply2_
        If (PlyCharAt(s, i) Or CLng(32)) <> PlyCharAt(w, i) Then
            PlyTextIs_ = PlyTextIs_2
            Exit Function
        End If
        i = CLng(i + ply3_)
    Loop
    PlyTextIs_2 = True
    PlyTextIs_ = PlyTextIs_2
End Function

Private Function PlyVarLogic_(ByVal op As Integer, ByVal a As Variant, ByVal b As Variant) As Variant
    Dim PlyVarLogic_2 As Variant
    Dim na As Boolean
    Dim nb As Boolean
    Dim x As Boolean
    Dim y As Boolean
    PlyVarLogic_2 = Empty
    na = False
    nb = False
    x = False
    y = False
    na = CLng(CInt(VarType(a))) = CLng(1)
    nb = CLng(CInt(VarType(b))) = CLng(1)
    If Not na Then
        x = PlyVarBool_(a)
    End If
    If Not nb Then
        y = PlyVarBool_(b)
    End If
    If CLng(op) = CLng(0) Then
        If Not na And Not x Or Not nb And Not y Then
            PlyVarLogic_2 = CBool(False)
        ElseIf na Or nb Then
            PlyVarLogic_2 = Null
        Else
            PlyVarLogic_2 = CBool(True)
        End If
    ElseIf CLng(op) = CLng(1) Then
        If Not na And x Or Not nb And y Then
            PlyVarLogic_2 = CBool(True)
        ElseIf na Or nb Then
            PlyVarLogic_2 = Null
        Else
            PlyVarLogic_2 = CBool(False)
        End If
    ElseIf na Or nb Then
        PlyVarLogic_2 = Null
    Else
        PlyVarLogic_2 = CBool(x <> y)
    End If
    PlyVarLogic_ = PlyVarLogic_2
End Function

Private Function PlyVarBool_(ByVal v As Variant) As Boolean
    Dim PlyVarBool_2 As Boolean
    PlyVarBool_2 = False
    If CLng(CInt(VarType(v))) <> CLng(11) Then
        Err.Raise 13
    End If
    PlyVarBool_2 = CBool(v)
    PlyVarBool_ = PlyVarBool_2
End Function

Private Function PlyVarNot_(ByVal a As Variant) As Variant
    Dim PlyVarNot_2 As Variant
    PlyVarNot_2 = Empty
    If CLng(CInt(VarType(a))) = CLng(1) Then
        PlyVarNot_2 = Null
    Else
        PlyVarNot_2 = CBool(Not PlyVarBool_(a))
    End If
    PlyVarNot_ = PlyVarNot_2
End Function

Private Function PlyVarRank_(ByVal t As Integer) As Integer
    Dim PlyVarRank_2 As Integer
    PlyVarRank_2 = 0
    If CLng(t) = CLng(17) Then
        PlyVarRank_2 = 1
    ElseIf CLng(t) = CLng(0) Or CLng(t) = CLng(2) Or CLng(t) = CLng(11) Then
        PlyVarRank_2 = 2
    ElseIf CLng(t) = CLng(3) Then
        PlyVarRank_2 = 3
    ElseIf CLng(t) = CLng(4) Then
        PlyVarRank_2 = 5
    ElseIf CLng(t) = CLng(5) Or CLng(t) = CLng(8) Then
        PlyVarRank_2 = 6
    ElseIf CLng(t) = CLng(7) Then
        PlyVarRank_2 = 8
    End If
    PlyVarRank_ = PlyVarRank_2
End Function

Private Function PlyVarText_(ByVal v As Variant) As String
    Dim PlyVarText_2 As String
    Dim t As Integer
    PlyVarText_2 = ""
    t = 0
    t = CInt(VarType(v))
    If CLng(t) = CLng(8) Then
        PlyVarText_2 = CStr(v)
    ElseIf CLng(t) = CLng(11) Then
        If CBool(v) Then
            PlyVarText_2 = "True"
        Else
            PlyVarText_2 = "False"
        End If
    ElseIf CLng(t) = CLng(2) Then
        PlyVarText_2 = CStr(CLng(CInt(v)))
    ElseIf CLng(t) = CLng(3) Then
        PlyVarText_2 = CStr(CLng(v))
    ElseIf CLng(t) = CLng(17) Then
        PlyVarText_2 = CStr(CLng(CByte(v)))
    ElseIf CLng(t) = CLng(5) Then
        PlyVarText_2 = PlyFmtR8(CDbl(v), ".")
    ElseIf CLng(t) = CLng(4) Then
        PlyVarText_2 = PlyFmtR4(CSng(v), ".")
    ElseIf CLng(t) > CLng(1) Then
        Err.Raise 13
    End If
    PlyVarText_ = PlyVarText_2
End Function

Private Function PlyVarTypeName_(ByVal v As Variant) As String
    Dim PlyVarTypeName_2 As String
    Dim t As Integer
    PlyVarTypeName_2 = ""
    t = 0
    t = CInt(VarType(v))
    If CLng(t) = CLng(0) Then
        PlyVarTypeName_2 = "Empty"
    ElseIf CLng(t) = CLng(1) Then
        PlyVarTypeName_2 = "Null"
    ElseIf CLng(t) = CLng(2) Then
        PlyVarTypeName_2 = "Integer"
    ElseIf CLng(t) = CLng(3) Then
        PlyVarTypeName_2 = "Long"
    ElseIf CLng(t) = CLng(4) Then
        PlyVarTypeName_2 = "Single"
    ElseIf CLng(t) = CLng(5) Then
        PlyVarTypeName_2 = "Double"
    ElseIf CLng(t) = CLng(8) Then
        PlyVarTypeName_2 = "String"
    ElseIf CLng(t) = CLng(11) Then
        PlyVarTypeName_2 = "Boolean"
    ElseIf CLng(t) = CLng(17) Then
        PlyVarTypeName_2 = "Byte"
    Else
        PlyVarTypeName_2 = "LongLong"
    End If
    If CLng(t) = CLng(6) Then
        PlyVarTypeName_2 = "Currency"
    ElseIf CLng(t) = CLng(7) Then
        PlyVarTypeName_2 = "Date"
    End If
    PlyVarTypeName_ = PlyVarTypeName_2
End Function

Private Function PlyVarWhole_(ByVal v As Variant) As Double
    Dim PlyVarWhole_2 As Double
    Dim t As Integer
    PlyVarWhole_2 = 0#
    t = 0
    t = CInt(VarType(v))
    If CLng(t) = CLng(4) Or CLng(t) = CLng(5) Or CLng(t) = CLng(7) Or CLng(t) = CLng(8) Then
        PlyVarWhole_2 = CDbl(CLng(Fix(Round(PlyVarDbl_(v)))))
    Else
        PlyVarWhole_2 = PlyVarDbl_(v)
    End If
    PlyVarWhole_ = PlyVarWhole_2
End Function

Private Function PlyWrap16(ByVal a As Long) As Integer
    a = a And &HFFFF&
    If a >= 32768 Then
        a = a - 65536
    End If
    PlyWrap16 = CInt(a)
End Function

Private Function PlyCharAt(ByVal s As String, ByVal i As Long) As Long
    If i < 0 Or i >= Len(s) Then
        Err.Raise 9
    End If
    PlyCharAt = AscW(Mid(s, i + 1, 1)) And &HFFFF&
End Function

Private Function PlyCompare(ByVal a As String, ByVal b As String) As Long
    PlyCompare = CLng(StrComp(a, b, 0))
End Function

Private Function PlyNumberText(ByVal s As String, ByVal sep As String) As String
    Dim d As String, e As Long, k As Long
    d = Mid(CStr(0.5), 2, 1)
    If d <> sep Then
        s = Replace(s, d, sep)
    End If
    e = InStr(s, "E")
    If e > 0 Then
        k = e + 2
        Do While k < Len(s) - 1 And Mid(s, k, 1) = "0"
            k = k + 1
        Loop
        s = Left(s, e + 1) & Mid(s, k)
    End If
    PlyNumberText = s
End Function

Private Function PlyFmtR8(ByVal x As Double, ByVal sep As String) As String
    PlyFmtR8 = PlyNumberText(CStr(x), sep)
End Function

Private Function PlyFmtR4(ByVal x As Single, ByVal sep As String) As String
    PlyFmtR4 = PlyNumberText(CStr(x), sep)
End Function

Private Function PlyParseR8(ByVal s As String) As Double
    Dim i As Long
    s = Replace(Trim(s), ",", "")
    For i = 1 To Len(s)
        If InStr("0123456789.eE+-", Mid(s, i, 1)) = 0 Then
            Err.Raise 13
        End If
    Next i
    PlyParseR8 = Val(s)
End Function
