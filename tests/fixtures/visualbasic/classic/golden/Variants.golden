Private Function PlyParseR8(ByVal s As String) As Double
    Dim i As Long
    s = Replace(Trim(s), ",", "")
    For i = 1 To Len(s)
        If InStr("0123456789.eE+-", Mid(s, i, 1)) = 0 Then
            Err.Raise 13
        End If
    Next i
    PlyParseR8 = Val(s)
End Function
