Private Function PlyVarArith_(ByVal op As Integer, ByVal a As Variant, ByVal b As Variant) As Variant
    Dim PlyVarArith_2 As Variant
    Dim ta As Integer
    Dim tb As Integer
    Dim r As Integer
    Dim rb As Integer
    Dim x As Double
    Dim y As Double
    Dim z As Double
    PlyVarArith_2 = Empty
    ta = 0
    tb = 0
    r = 0
    rb = 0
    x = 0#
    y = 0#
    z = 0#
    ta = CInt(VarType(a))
    tb = CInt(VarType(b))
    If CLng(ta) = CLng(1) Or CLng(tb) = CLng(1) Then
        PlyVarArith_2 = Null
        PlyVarArith_ = PlyVarArith_2
        Exit Function
    End If
    If CLng(op) = CLng(0) Then
        If CLng(ta) = CLng(8) And CLng(tb) = CLng(8) Then
            PlyVarArith_2 = CStr(a) & CStr(b)
            PlyVarArith_ = PlyVarArith_2
            Exit Function
        End If
        If CLng(ta) = CLng(0) And CLng(tb) <> CLng(0) Then
            PlyVarArith_2 = b
            PlyVarArith_ = PlyVarArith_2
            Exit Function
        End If
        If CLng(tb) = CLng(0) And CLng(ta) <> CLng(0) Then
            PlyVarArith_2 = a
            PlyVarArith_ = PlyVarArith_2
            Exit Function
        End If
    End If
    r = PlyVarRank_(ta)
    rb = PlyVarRank_(tb)
    If CLng(r) = CLng(0) Or CLng(rb) = CLng(0) Then
        Err.Raise 13
    End If
    If CLng(rb) > CLng(r) Then
        r = rb
    End If
    If CLng(r) = CLng(5) And (CLng(ta) = CLng(3) Or CLng(tb) = CLng(3)) Then
        r = 6
    End If
    x = PlyVarDbl_(a)
    y = PlyVarDbl_(b)
    If CLng(r) = CLng(8) Then
        If CLng(op) = CLng(2) Or CLng(op) = CLng(1) And CLng(ta) = CLng(7) And CLng(tb) = CLng(7) Then
            r = 6
        Else
            If CLng(op) = CLng(0) Then
                z = PlyCheckD_(x + y)
            Else
                z = PlyCheckD_(x - y)
            End If
            If z < CDbl(CLng(-657434)) Or z >= CDbl(2958466) Then
                PlyVarArith_2 = CDbl(z)
            Else
                PlyVarArith_2 = CDate(z)
            End If
            PlyVarArith_ = PlyVarArith_2
            Exit Function
        End If
    End If
    If CLng(op) = CLng(0) Then
        PlyVarArith_2 = PlyVarFromWide_(x + y, r)
    ElseIf CLng(op) = CLng(1) Then
        PlyVarArith_2 = PlyVarFromWide_(x - y, r)
    Else
        PlyVarArith_2 = PlyVarFromWide_(x * y, r)
