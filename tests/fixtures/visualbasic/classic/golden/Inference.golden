        Else
            PlyVarCmp_2 = CLng(CInt(CLng(0& - CLng(1))))
        End If
    Else
        x = PlyVarDbl_(a)
        y = PlyVarDbl_(b)
        If x < y Then
            PlyVarCmp_2 = CLng(CInt(CLng(0& - CLng(1))))
        ElseIf x > y Then
            PlyVarCmp_2 = CLng(1)
        End If
    End If
    PlyVarCmp_ = PlyVarCmp_2
End Function

