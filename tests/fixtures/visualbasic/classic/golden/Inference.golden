Private Function PlyNumText_(ByVal s As String) As String
    Dim PlyNumText_2 As String
    Dim i As Long
    Dim n As Long
    Dim c As Long
    Dim t As String
    Dim d As Long
    Dim e As Long
    Dim dec As Long
    Dim grp As Long
    PlyNumText_2 = ""
    i = 0
    n = 0
    c = 0
    t = ""
    d = 0
    e = 0
    dec = 0
    grp = 0
    dec = 46
    grp = 44
    n = Len(s)
    i = PlyNumBlank_(s, CLng(0))
    If i < n Then
        c = PlyCharAt(s, i)
        If c = CLng(38) Then
            PlyNumText_2 = PlyNumRadix_(s, CLng(i + CLng(1)), True)
            PlyNumText_ = PlyNumText_2
            Exit Function
        End If
        If c = CLng(43) Or c = CLng(45) Then
            If c = CLng(45) Then
                t = "-"
            End If
            i = PlyNumBlank_(s, CLng(i + CLng(1)))
        End If
    End If
    Do While i < n
        c = PlyCharAt(s, i)
        If c >= CLng(48) And c <= CLng(57) Then
            t = t & ChrW(c And 65535&)
            d = CLng(d + CLng(1))
        ElseIf c <> grp Or d = CLng(0) Then
            Exit Do
        End If
        i = CLng(i + CLng(1))
    Loop
    If i < n Then
        If PlyCharAt(s, i) = dec Then
            t = t & "."
            i = CLng(i + CLng(1))
            Do While i < n
                c = PlyCharAt(s, i)
                If c < CLng(48) Or c > CLng(57) Then
                    Exit Do
                End If
                t = t & ChrW(c And 65535&)
                d = CLng(d + CLng(1))
                i = CLng(i + CLng(1))
            Loop
        End If
    End If
    If d = CLng(0) Then
        PlyNumText_ = PlyNumText_2
        Exit Function
    End If
    i = PlyNumBlank_(s, i)
    If i < n Then
        c = PlyCharAt(s, i) Or CLng(32)
        If c = CLng(101) Or c = CLng(100) Then
            t = t & "e"
            i = PlyNumBlank_(s, CLng(i + CLng(1)))
            If i < n Then
                c = PlyCharAt(s, i)
                If c = CLng(43) Or c = CLng(45) Then
                    If c = CLng(45) Then
                        t = t & "-"
                    End If
                    i = PlyNumBlank_(s, CLng(i + CLng(1)))
                End If
            End If
            Do While i < n
                c = PlyCharAt(s, i)
                If c < CLng(48) Or c > CLng(57) Then
                    Exit Do
                End If
                t = t & ChrW(c And 65535&)
                e = CLng(e + CLng(1))
                i = CLng(i + CLng(1))
            Loop
            If e = CLng(0) Then
                PlyNumText_ = PlyNumText_2
                Exit Function
            End If
            i = PlyNumBlank_(s, i)
        End If
    End If
    If i = n Then
        PlyNumText_2 = t
    End If
    PlyNumText_ = PlyNumText_2
End Function

Private Function PlyNumBlank_(ByVal s As String, ByVal i As Long) As Long
    Dim PlyNumBlank_2 As Long
    Dim choice As Boolean
    PlyNumBlank_2 = 0
    Do While i < Len(s)
        If PlyCharAt(s, i) <> CLng(32) Then
            choice = PlyCharAt(s, i) <> CLng(9)
        Else
            choice = CBool(IIf(PlyCharAt(s, i) <> CLng(9), False, False))
        End If
        If choice Then
            Exit Do
        End If
        i = CLng(i + CLng(1))
    Loop
    PlyNumBlank_2 = i
    PlyNumBlank_ = PlyNumBlank_2
End Function

Private Function PlyNumRadix_(ByVal s As String, ByVal i As Long, ByVal strict As Boolean) As String
    Dim PlyNumRadix_2 As String
    Dim n As Long
    Dim c As Long
    Dim b As Long
    Dim d As Long
    Dim v As Double
    Dim choice As Boolean
    Dim choice2 As Boolean
    PlyNumRadix_2 = ""
    n = 0
    c = 0
    b = 0
    d = 0
    v = 0#
    n = Len(s)
    b = CLng(8)
    If i < n Then
        c = PlyCharAt(s, i) Or CLng(32)
        If c = CLng(104) Then
            b = CLng(16)
            i = CLng(i + CLng(1))
        ElseIf c = CLng(111) Then
            i = CLng(i + CLng(1))
        End If
    End If
    Do While i < n
        c = PlyCharAt(s, i)
        If c >= CLng(48) And c <= CLng(57) Then
            choice = CLng(c - CLng(48)) < b
        Else
            choice = CBool(IIf(CLng(c - CLng(48)) < b, False, False))
        End If
        If choice Then
            c = CLng(c - CLng(48))
        ElseIf b = CLng(16) And (c Or CLng(32)) >= CLng(97) And (c Or CLng(32)) <= CLng(102) Then
            c = CLng((c Or CLng(32)) - CLng(87))
        Else
            Exit Do
        End If
        v = v * CDbl(b) + CDbl(c)
        d = CLng(d + CLng(1))
        i = CLng(i + CLng(1))
    Loop
    If strict Then
        If d = CLng(0) Then
            choice2 = CBool(IIf(PlyNumBlank_(s, i) < n, True, True))
        Else
            choice2 = PlyNumBlank_(s, i) < n
        End If
        If choice2 Then
            PlyNumRadix_ = PlyNumRadix_2
            Exit Function
        End If
    End If
    If v > 4294967295# Then
        Err.Raise 6
    End If
    If v > CDbl(65535) Then
        If v >= 2147483648# Then
            v = v - 4294967296#
        End If
    ElseIf v >= CDbl(32768) Then
        v = v - CDbl(65536)
    End If
    PlyNumRadix_2 = CStr(CLng(Fix(Round(v))))
    PlyNumRadix_ = PlyNumRadix_2
End Function

Private Function PlyVarCmp_(ByVal a As Variant, ByVal b As Variant) As Long
    Dim PlyVarCmp_2 As Long
    Dim ta As Integer
    Dim tb As Integer
