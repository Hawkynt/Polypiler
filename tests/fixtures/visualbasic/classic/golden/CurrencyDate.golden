    era = 0#
    doe = 0#
    yoe = 0#
    doy = 0#
    mp = 0#
    y = 0#
    m = 0#
    s = 0#
    If CLng(part) >= CLng(4) Then
        s = PlyDateSecs_(v)
        If CLng(part) = CLng(4) Then
            PlyDatePart_2 = CInt(Fix(Round(Int(s / CDbl(3600)))))
        ElseIf CLng(part) = CLng(5) Then
            PlyDatePart_2 = CInt(Fix(Round(Int(s / CDbl(60)) - CDbl(60) * Int(s / CDbl(3600)))))
        Else
