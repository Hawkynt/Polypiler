        End If
        PlyDatePart_ = PlyDatePart_2
        Exit Function
    End If
    z = PlyDateDays_(v) + CDbl(693899)
    era = Int(z / CDbl(146097))
    doe = z - era * CDbl(146097)
    yoe = Int((doe - Int(doe / CDbl(1460)) + Int(doe / CDbl(36524)) - Int(doe / CDbl(146096))) / CDbl(365))
    doy = doe - (CDbl(365) * yoe + Int(yoe / CDbl(4)) - Int(yoe / CDbl(100)))
    mp = Int((CDbl(5) * doy + CDbl(2)) / CDbl(153))
    If mp < CDbl(10) Then
        m = mp + CDbl(3)
    Else
        m = mp - CDbl(9)
    End If
    y = yoe + era * CDbl(400)
    If m <= CDbl(2) Then
        y = y + CDbl(1)
    End If
    If CLng(part) = CLng(1) Then
        PlyDatePart_2 = CInt(Fix(Round(y)))
    ElseIf CLng(part) = CLng(2) Then
        PlyDatePart_2 = CInt(Fix(Round(m)))
    Else
        PlyDatePart_2 = CInt(Fix(Round(doy - Int((CDbl(153) * mp + CDbl(2)) / CDbl(5)) + CDbl(1))))
    End If
    PlyDatePart_ = PlyDatePart_2
End Function

