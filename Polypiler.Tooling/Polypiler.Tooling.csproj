<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>polypiler-tooling</AssemblyName>
    <RootNamespace>Polypiler.Tooling</RootNamespace>
    <Version>0.1.0</Version>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polypiler.Core.Frontends.CSharp\Polypiler.Core.Frontends.CSharp.csproj" />
    <ProjectReference Include="..\Polypiler.Core.IR\Polypiler.Core.IR.csproj" />
    <ProjectReference Include="..\Polypiler.Core.Verification\Polypiler.Core.Verification.csproj" />
    <ProjectReference Include="..\Polypiler.Permutation\Polypiler.Permutation.csproj" />
    <PackageReference Include="SharpFuzz" Version="2.3.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="JsonSchema.Net" Version="8.0.5" />
  </ItemGroup>

  <!-- The metadata schema every spec document is checked against travels with the tool. -->
  <ItemGroup>
    <EmbeddedResource Include="..\spec\schemas\meta.schema.json" LogicalName="meta.schema.json" Link="Spec\meta.schema.json" />
  </ItemGroup>

</Project>
