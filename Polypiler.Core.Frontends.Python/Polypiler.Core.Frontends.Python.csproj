<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.1.0</Version>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The tables of the Unicode Character Database 16.0.0 the tokenizer and the string decoder need
       (identifier properties, NFKC, character names), generated by Syntax/Unicode/generate.py. -->
  <ItemGroup>
    <EmbeddedResource Include="Syntax\Unicode\names.txt.gz" LogicalName="Polypiler.Core.Frontends.Python.Unicode.names.txt.gz" />
    <EmbeddedResource Include="Syntax\Unicode\properties.txt.gz" LogicalName="Polypiler.Core.Frontends.Python.Unicode.properties.txt.gz" />
    <None Remove="Syntax\Unicode\generate.py" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polypiler.Core\Polypiler.Core.csproj" />
    <ProjectReference Include="..\Polypiler.Core.IR\Polypiler.Core.IR.csproj" />
    <ProjectReference Include="..\Polypiler.Core.Syntax\Polypiler.Core.Syntax.csproj" />
  </ItemGroup>

</Project>
