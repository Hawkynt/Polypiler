<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.1.0</Version>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polypiler.Core\Polypiler.Core.csproj" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!-- The runner's default limits are a repository file; the assembly carries the copy it was built with. -->
  <ItemGroup>
    <EmbeddedResource Include="..\tooling\ci\runner.yaml" LogicalName="Polypiler.Core.Verification.Running.runner.yaml" Link="Running\runner.yaml" />
  </ItemGroup>

  <!-- petcat's named escapes, recorded from petcat itself; the normalisation of its listings reads them. -->
  <ItemGroup>
    <EmbeddedResource Include="Emulators\Resources\petcat-escapes.tsv" LogicalName="Polypiler.Core.Verification.Emulators.petcat-escapes.tsv" />
  </ItemGroup>

</Project>
