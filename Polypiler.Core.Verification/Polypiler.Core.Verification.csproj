<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.1.0</Version>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polypiler.Core\Polypiler.Core.csproj" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="JsonSchema.Net" Version="8.0.5" />
  </ItemGroup>

  <!-- The runner's default limits are a repository file; the assembly carries the copy it was built with. -->
  <ItemGroup>
    <EmbeddedResource Include="..\tooling\ci\runner.yaml" LogicalName="Polypiler.Core.Verification.Running.runner.yaml" Link="Running\runner.yaml" />
  </ItemGroup>

  <!-- The manifest schema and the sub-schemas of its sections travel with the validator. -->
  <ItemGroup>
    <EmbeddedResource Include="..\spec\schemas\manifest*.schema.json" LogicalName="Polypiler.Core.Verification.Manifests.%(Filename)%(Extension)" Link="Manifests\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The schema of the gate records travels with the store that reads them. -->
  <ItemGroup>
    <EmbeddedResource Include="..\spec\schemas\gate-record.schema.json" LogicalName="Polypiler.Core.Verification.Gates.gate-record.schema.json" Link="Gates\gate-record.schema.json" />
  </ItemGroup>

</Project>
