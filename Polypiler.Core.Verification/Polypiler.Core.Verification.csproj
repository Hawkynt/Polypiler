<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.1.0</Version>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polypiler.Core\Polypiler.Core.csproj" />
    <ProjectReference Include="..\Polypiler.Core.IR\Polypiler.Core.IR.csproj" />
    <ProjectReference Include="..\Polypiler.Core.Recognize\Polypiler.Core.Recognize.csproj" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="JsonSchema.Net" Version="8.0.5" />
    <PackageReference Include="Microsoft.Z3" Version="4.11.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
  </ItemGroup>

  <!-- The runner's default limits are a repository file; the assembly carries the copy it was built with. -->
  <ItemGroup>
    <EmbeddedResource Include="..\tooling\ci\runner.yaml" LogicalName="Polypiler.Core.Verification.Running.runner.yaml" Link="Running\runner.yaml" />
  </ItemGroup>

  <!-- petcat's named escapes, recorded from petcat itself; the normalisation of its listings reads them. -->
  <ItemGroup>
    <EmbeddedResource Include="Emulators\Resources\petcat-escapes.tsv" LogicalName="Polypiler.Core.Verification.Emulators.petcat-escapes.tsv" />
  </ItemGroup>

  <!-- The manifest schema and the sub-schemas of its sections travel with the validator. -->
  <ItemGroup>
    <EmbeddedResource Include="..\spec\schemas\manifest*.schema.json" LogicalName="Polypiler.Core.Verification.Manifests.%(Filename)%(Extension)" Link="Manifests\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The evidence bundle's schema travels with its validator. -->
  <ItemGroup>
    <EmbeddedResource Include="..\spec\schemas\evidence.schema.json" LogicalName="Polypiler.Core.Verification.Evidence.evidence.schema.json" Link="Evidence\evidence.schema.json" />
  </ItemGroup>

  <!-- The toolchain lock travels with the solver binding, which checks its own version against it. -->
  <ItemGroup>
    <EmbeddedResource Include="..\tooling\toolchains.lock" LogicalName="Polypiler.Core.Verification.Proofs.toolchains.lock" Link="Proofs\toolchains.lock" />
  </ItemGroup>

  <!-- The schema of the gate records travels with the store that reads them. -->
  <ItemGroup>
    <EmbeddedResource Include="..\spec\schemas\gate-record.schema.json" LogicalName="Polypiler.Core.Verification.Gates.gate-record.schema.json" Link="Gates\gate-record.schema.json" />
  </ItemGroup>

  <!-- The schema of the capability report travels with the reader of docs/capabilities.json. -->
  <ItemGroup>
    <EmbeddedResource Include="..\spec\schemas\capabilities.schema.json" LogicalName="Polypiler.Core.Verification.Capabilities.capabilities.schema.json" Link="Capabilities\capabilities.schema.json" />
  </ItemGroup>

</Project>
