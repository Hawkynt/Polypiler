{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkynt/Polypiler/spec/schemas/gate-record.schema.json",
  "title": "Gate record",
  "description": "artifacts/gates/<from>--<to>--<source-profile>--<target-profile>.json: how far each fixture of a language pair got, with the files that show it (PRD §23.6). The state names and evidence kinds are checked by GateStore, which names an unknown one.",
  "type": "object",
  "required": ["schemaVersion", "pair", "commit", "fixtures"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "pair": {
      "type": "object",
      "required": ["from", "to", "sourceProfile", "targetProfile"],
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "#/$defs/part" },
        "to": { "$ref": "#/$defs/part" },
        "sourceProfile": { "$ref": "#/$defs/part" },
        "targetProfile": { "$ref": "#/$defs/part" }
      }
    },
    "commit": { "type": "string", "minLength": 1 },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fixture", "evidence"],
        "additionalProperties": false,
        "properties": {
          "fixture": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["state", "kind", "path", "sha256"],
              "additionalProperties": false,
              "properties": {
                "state": { "type": "string", "minLength": 1 },
                "kind": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "part": { "type": "string", "pattern": "^[a-z0-9.+_]+(-[a-z0-9.+_]+)*$" }
  }
}
