{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkynt/Polypiler/spec/schemas/corpus.lock.schema.json",
  "title": "Polypiler corpus lock",
  "description": "tooling/corpus/corpus.lock.json, generated by 'polypiler-tooling corpus import --update-lock': the SHA-256 and length of every imported file, sorted by repository, then path (ordinal), two-space indent, LF, trailing newline.",
  "type": "object",
  "required": ["schema", "files"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repository", "commit", "path", "sha256", "bytes"],
        "additionalProperties": false,
        "properties": {
          "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
