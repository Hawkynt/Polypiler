<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The tests run in parallel, one worker per logical processor, and most of them allocate hard
         (Roslyn, the interpreter): one GC heap per processor keeps the workers from waiting on each
         other's collections. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FsCheck" Version="3.6.0" />
    <PackageReference Include="Gherkin" Version="35.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="JsonSchema.Net" Version="8.0.5" />
  </ItemGroup>

  <Import Project="..\Polypiler.Tests\Prototype\Support\ReferenceAssemblies.props" />

  <!-- The prototype fixtures are compiled into the tests: the C# compiler's build of them is the oracle. -->
  <ItemGroup>
    <Compile Include="..\tests\fixtures\prototype\**\*.cs" LinkBase="Prototype\Fixtures" />
  </ItemGroup>

  <!-- The parts of the acceptance harness that need no Reqnroll - slugs, command lines and the static
       check of the feature files - are tested here, as source: the two test projects do not
       reference each other. -->
  <ItemGroup>
    <Compile Include="..\Polypiler.Tests.Acceptance\Support\BindingCheck.cs" LinkBase="Support\Acceptance" />
    <Compile Include="..\Polypiler.Tests.Acceptance\Support\CommandLine.cs" LinkBase="Support\Acceptance" />
    <Compile Include="..\Polypiler.Tests.Acceptance\Support\FeatureFiles.cs" LinkBase="Support\Acceptance" />
    <Compile Include="..\Polypiler.Tests.Acceptance\Support\Slug.cs" LinkBase="Support\Acceptance" />
  </ItemGroup>

  <!-- The property harness is shared with the acceptance tests as source. -->
  <ItemGroup>
    <Compile Include="..\tests\shared\Properties\*.cs" LinkBase="Properties" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polypiler.Base\Polypiler.Base.csproj" />
    <ProjectReference Include="..\Polypiler.Catalog\Polypiler.Catalog.csproj" />
    <ProjectReference Include="..\Polypiler.Cli\Polypiler.Cli.csproj" />
    <ProjectReference Include="..\Polypiler.Core\Polypiler.Core.csproj" />
    <ProjectReference Include="..\Polypiler.Core.Analysis\Polypiler.Core.Analysis.csproj" />
    <ProjectReference Include="..\Polypiler.Core.Backends.CSharp\Polypiler.Core.Backends.CSharp.csproj" />
    <ProjectReference Include="..\Polypiler.Core.Backends.JavaScript\Polypiler.Core.Backends.JavaScript.csproj" />
    <ProjectReference Include="..\Polypiler.Core.BinaryFormats\Polypiler.Core.BinaryFormats.csproj" />
    <ProjectReference Include="..\Polypiler.Core.Frontends.CSharp\Polypiler.Core.Frontends.CSharp.csproj" />
    <ProjectReference Include="..\Polypiler.Core.Frontends.JavaScript\Polypiler.Core.Frontends.JavaScript.csproj" />
    <ProjectReference Include="..\Polypiler.Core.IR\Polypiler.Core.IR.csproj" />
    <ProjectReference Include="..\Polypiler.Core.Legalize\Polypiler.Core.Legalize.csproj" />
    <ProjectReference Include="..\Polypiler.Core.MachineSemantics\Polypiler.Core.MachineSemantics.csproj" />
    <ProjectReference Include="..\Polypiler.Core.Optimize\Polypiler.Core.Optimize.csproj" />
    <ProjectReference Include="..\Polypiler.Core.Recognize\Polypiler.Core.Recognize.csproj" />
    <ProjectReference Include="..\Polypiler.Core.Recovery\Polypiler.Core.Recovery.csproj" />
    <ProjectReference Include="..\Polypiler.Core.Types\Polypiler.Core.Types.csproj" />
    <ProjectReference Include="..\Polypiler.Core.Verification\Polypiler.Core.Verification.csproj" />
    <ProjectReference Include="..\Polypiler.Interop\Polypiler.Interop.csproj" />
    <ProjectReference Include="..\Polypiler.Permutation\Polypiler.Permutation.csproj" />
    <ProjectReference Include="..\Polypiler.Tooling\Polypiler.Tooling.csproj" />
  </ItemGroup>

</Project>
